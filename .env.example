# SafeTag — Environment Variables
# ─────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env   (Linux/Mac)
#                      copy .env.example .env  (Windows)
# 2. Fill in every value marked  ← REQUIRED
# 3. Never commit .env to git
# ─────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────

# Random 64-char hex string — generate with:
#   Linux/Mac: openssl rand -hex 32
#   Windows:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_SESSION_SECRET=replace_with_64_char_hex_string_here        # ← REQUIRED

# Local dev (SQLite):      DATABASE_URL="file:./prisma/dev.db"
# Production (PostgreSQL): get Internal Database URL from Render → your PostgreSQL service
DATABASE_URL="file:./prisma/dev.db"                              # ← REQUIRED (use postgresql:// URL in production)

PORT=3000
BASE_URL=http://localhost:3000                                   # ← REQUIRED (change to https://yourdomain.com in prod)
NODE_ENV=development                                             # ← change to: production

# ── Payments ─────────────────────────────────────────────

# Set true to skip Razorpay (COD still works). Set false in production.
DUMMY_PAYMENT=true

# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=                                                 # ← REQUIRED when DUMMY_PAYMENT=false
RAZORPAY_KEY_SECRET=                                             # ← REQUIRED when DUMMY_PAYMENT=false

# ── Email / SMTP ─────────────────────────────────────────

# Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com                                         # ← REQUIRED for order emails
SMTP_PASS=your-gmail-app-password                                # ← REQUIRED (NOT your Gmail password)

# Who receives manufacturer approval requests & system alerts
ADMIN_EMAIL=your-admin@gmail.com                                 # ← REQUIRED

# ── Optional services ────────────────────────────────────

# WhatsApp location alerts on emergency scan (via Twilio sandbox)
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Maps embed on emergency page
GOOGLE_MAPS_API_KEY=

# Cloudinary for product image uploads
# Get from https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_URL=

# Error tracking
SENTRY_DSN=
