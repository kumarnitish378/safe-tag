# SafeTag Node.js environment
# Copy to .env and fill in production values. Never commit .env.

# REQUIRED
NODE_SESSION_SECRET=replace_with_64_hex_chars
DATABASE_URL="file:./prisma/dev.db"
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
DUMMY_PAYMENT=true

# Google Maps (used on emergency page)
GOOGLE_MAPS_API_KEY=

# Razorpay (production — leave blank when DUMMY_PAYMENT=true)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio (WhatsApp location alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudinary (photo uploads)
CLOUDINARY_URL=

# Sentry
SENTRY_DSN=
