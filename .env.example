# Safe-Tag Environment Variables
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=production

# Database (use full PostgreSQL URL in production)
# Development: leave blank to use SQLite
DATABASE_URL=postgresql://user:password@host:5432/safetag_db

# Razorpay
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Twilio WhatsApp (or Meta Cloud API)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (alternative to Twilio)
META_WA_PHONE_NUMBER_ID=your_phone_number_id
META_WA_ACCESS_TOKEN=your_access_token

# Cookies
SESSION_COOKIE_SECURE=false

# App URL
BASE_URL=https://safe-tag.in
