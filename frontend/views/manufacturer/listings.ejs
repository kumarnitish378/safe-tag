<%- include('../layout/header', { title: 'My Listings' }) %><main class="mx-auto max-w-5xl px-4 py-10"><div class="flex justify-between"><h1 class="font-display text-3xl font-bold">My Listings</h1><a href="/manufacturer/listings/new" class="rounded-xl bg-teal px-4 py-3 font-bold text-white">Add New</a></div><div class="mt-6 space-y-3"><% listings.forEach(l=>{ %><div class="rounded bg-white p-4"><%= l.name %> · ₹<%= (l.price/100).toFixed(0) %> · <%= l.is_approved ? 'Approved' : 'Pending' %></div><% }) %></div></main><%- include('../layout/footer') %>
