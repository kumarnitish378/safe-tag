<%- include('../layout/_head') %>

<section class="section">
  <div class="section-inner">
    <a href="/manufacturer/dashboard" class="text-sm text-brand font-semibold">← Dashboard</a>
    <div class="flex items-center justify-between mt-2 mb-4 flex-wrap gap-2">
      <div>
        <h1 class="text-3xl font-bold"><%= batch.batch_name %></h1>
        <p class="text-sm text-slate-500">Batch #<%= batch.id %> · <%= batch.quantity %> tags</p>
      </div>
      <a class="btn-brand text-sm" href="/manufacturer/batch/<%= batch.id %>/csv" onclick="window.location.href='/api/manufacturer/batch/<%= batch.id %>/csv';return false;">⬇ Download CSV</a>
    </div>

    <div class="card overflow-hidden">
      <table class="table">
        <thead><tr><th>Tag ID</th><th>Status</th><th>Scans</th><th>URL</th><th>Activated</th></tr></thead>
        <tbody>
          <% tags.forEach(function(t){ %>
            <tr>
              <td class="mono"><%= t.tag_id %></td>
              <td><% if (t.is_active) { %><span class="pill pill-success">Active</span><% } else { %><span class="pill pill-warning">Inactive</span><% } %></td>
              <td><%= t.scan_count %></td>
              <td class="break-all text-xs"><%= t.url %></td>
              <td class="text-xs text-slate-500"><%= t.activated_at ? t.activated_at.split('T')[0] : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../layout/_foot') %>
