<%- include('../layout/header', { title: 'Admin Dashboard' }) %><main class="mx-auto max-w-6xl px-4 py-10"><h1 class="font-display text-3xl font-bold">Platform Dashboard</h1><div class="mt-6 grid gap-4 md:grid-cols-4"><% Object.entries(stats).filter(([k])=>k!=='ok').forEach(([k,v])=>{ %><div class="rounded-xl bg-white p-5 shadow-sm"><p class="text-xs uppercase text-slate-500"><%= k.replaceAll('_',' ') %></p><p class="mt-2 font-display text-3xl font-bold"><%= v %></p></div><% }) %></div><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-xl border px-4 py-3 font-bold" href="/admin/manufacturers">Manufacturers</a><a class="rounded-xl border px-4 py-3 font-bold" href="/admin/store">Store</a><a class="rounded-xl border px-4 py-3 font-bold" href="/admin/users">Users</a><a class="rounded-xl border px-4 py-3 font-bold" href="/admin/orders">Orders</a></div></main><%- include('../layout/footer') %>
