<%- include('../layout/header', { title: 'Manufacturers' }) %><main class="mx-auto max-w-5xl px-4 py-10"><h1 class="font-display text-3xl font-bold">Manufacturers</h1><div class="mt-6 space-y-3"><% manufacturers.forEach(m=>{ %><div class="flex items-center justify-between rounded bg-white p-4"><span><%= m.business_name %> · <%= m.email %> · <%= m.is_approved ? 'Approved' : 'Pending' %></span><form method="post" action="/admin/manufacturers/<%= m.id %>/<%= m.is_approved ? 'block' : 'approve' %>"><button class="rounded bg-teal px-3 py-2 text-white"><%= m.is_approved ? 'Block' : 'Approve' %></button></form></div><% }) %></div></main><%- include('../layout/footer') %>
