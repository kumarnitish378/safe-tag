<%- include('../layout/header', { title: 'Admin Store' }) %><main class="mx-auto max-w-5xl px-4 py-10"><h1 class="font-display text-3xl font-bold">Store Listings</h1><div class="mt-6 space-y-3"><% listings.forEach(l=>{ %><div class="flex items-center justify-between rounded bg-white p-4"><span><%= l.name %> · ₹<%= (l.price/100).toFixed(0) %> · <%= l.is_approved ? 'Approved' : 'Pending' %></span><div class="flex gap-2"><form method="post" action="/admin/listings/<%= l.id %>/approve"><button class="rounded bg-teal px-3 py-2 text-white">Approve</button></form><form method="post" action="/admin/listings/<%= l.id %>/reject"><button class="rounded bg-red-600 px-3 py-2 text-white">Reject</button></form></div></div><% }) %></div></main><%- include('../layout/footer') %>
