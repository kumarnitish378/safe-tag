<%- include('../layout/header', { title: 'Admin Orders' }) %><main class="mx-auto max-w-6xl px-4 py-10"><h1 class="font-display text-3xl font-bold">All Platform Orders</h1><div class="mt-6 space-y-3"><% orders.forEach(o=>{ %><div class="rounded bg-white p-4"><div>#<%= o.id %> · <%= o.product_name %> · ₹<%= (o.amount/100).toFixed(0) %> · <b><%= o.status %></b></div><form class="mt-3 flex gap-2" method="post" action="/admin/orders/<%= o.id %>/dispatch"><input name="tracking_id" placeholder="Tracking ID" class="rounded border p-2"><button class="rounded bg-teal px-3 py-2 text-white">Dispatch</button></form></div><% }) %></div></main><%- include('../layout/footer') %>
