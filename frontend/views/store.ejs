<%- include('layout/header', { title: 'Store - SafeTag' }) %>
<main class="mx-auto max-w-6xl px-4 py-10"><h1 class="font-display text-3xl font-bold">Store</h1><div class="mt-8 grid gap-6 md:grid-cols-3"><% products.forEach(product=>{ %><a href="/store/<%= product.id %>" class="rounded-2xl bg-white p-5 shadow-sm"><div class="h-36 rounded-xl bg-teal/10"></div><h2 class="mt-4 font-display font-bold"><%= product.name %></h2><p class="mt-2 text-sm text-slate-500"><%= product.category %></p><p class="mt-3 font-bold text-teal">₹<%= (product.price/100).toFixed(0) %></p></a><% }) %></div></main>
<%- include('layout/footer') %>
