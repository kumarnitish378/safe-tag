<%- include('layout/header', { title: product.name }) %>
<main class="mx-auto grid max-w-5xl gap-8 px-4 py-10 md:grid-cols-2"><div class="h-80 rounded-3xl bg-teal/10"></div><section><h1 class="font-display text-4xl font-bold"><%= product.name %></h1><p class="mt-4 text-slate-600"><%= product.description %></p><p class="mt-6 font-display text-3xl font-bold text-teal">₹<%= (product.price/100).toFixed(0) %></p><form method="post" action="/store/<%= product.id %>/buy" class="mt-6 space-y-4"><input name="quantity" type="number" min="1" value="1" class="w-24 rounded-xl border p-3"><button class="block rounded-xl bg-orange px-6 py-3 font-bold text-white">Buy Now</button></form></section></main>
<%- include('layout/footer') %>
