<%- include('../layout/header', { title: 'Create Account' }) %>
<main class="mx-auto max-w-md px-4 py-12"><form method="post" class="rounded-2xl bg-white p-6 shadow-sm"><h1 class="font-display text-2xl font-bold">Customer Registration</h1><input name="email" type="email" required placeholder="Email" class="mt-6 w-full rounded-xl border p-3"><input name="mobile" required pattern="[6-9][0-9]{9}" placeholder="Mobile" class="mt-4 w-full rounded-xl border p-3"><input name="password" type="password" required placeholder="Password" class="mt-4 w-full rounded-xl border p-3"><input name="confirm_password" type="password" required placeholder="Confirm Password" class="mt-4 w-full rounded-xl border p-3"><button class="mt-6 w-full rounded-xl bg-teal py-3 font-bold text-white">Register</button></form></main>
<%- include('../layout/footer') %>
