<%- include('../layout/_head') %>

<section class="section">
  <div class="section-inner max-w-md">
    <div class="card p-6">
      <h1 class="text-2xl font-bold mb-1">Create your account</h1>
      <p class="text-sm text-slate-500 mb-5">Already have one? <a class="text-brand font-semibold" href="/login">Sign in</a>.</p>

      <% if (errors._form) { %><div class="flash flash-error">⚠️ <%= errors._form %></div><% } %>

      <form method="POST" action="/register" class="space-y-4">
        <div>
          <label class="label">Email</label>
          <input class="input" type="email" name="email" required value="<%= (values.email||'') %>" />
          <% if (errors.email) { %><div class="field-error"><%= errors.email %></div><% } %>
        </div>
        <div>
          <label class="label">Mobile (10-digit, India)</label>
          <input class="input" name="mobile" required value="<%= (values.mobile||'') %>" />
          <% if (errors.mobile) { %><div class="field-error"><%= errors.mobile %></div><% } %>
        </div>
        <div>
          <label class="label">Name (optional)</label>
          <input class="input" name="name" value="<%= (values.name||'') %>" />
        </div>
        <div>
          <label class="label">Password</label>
          <input class="input" type="password" name="password" required minlength="6" />
          <% if (errors.password) { %><div class="field-error"><%= errors.password %></div><% } %>
        </div>
        <button class="btn-brand w-full justify-center">Create account</button>
      </form>
    </div>
  </div>
</section>

<%- include('../layout/_foot') %>
