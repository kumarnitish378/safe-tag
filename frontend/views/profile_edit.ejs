<%- include('layout/header', { title: 'Edit Profile' }) %>
<main class="mx-auto max-w-md px-4 py-8"><h1 class="mb-4 font-display text-2xl font-bold">Edit Emergency Profile</h1><% errors.forEach(e=>{ %><div class="mb-3 rounded bg-red-50 p-3 text-red-700"><%= e %></div><% }) %><form method="post" class="space-y-4 rounded-2xl bg-white p-5 shadow-sm"><input name="name" value="<%= profile.name || '' %>" required class="w-full rounded-xl border p-3"><input name="age" value="<%= profile.age || '' %>" required type="number" class="w-full rounded-xl border p-3"><input name="parent_name" value="<%= profile.parent_name || '' %>" placeholder="Parent name" class="w-full rounded-xl border p-3"><input name="blood_group" value="<%= profile.blood_group || '' %>" class="w-full rounded-xl border p-3"><input name="mobile_primary" value="<%= profile.mobile_primary || '' %>" required class="w-full rounded-xl border p-3"><input name="mobile_secondary" value="<%= profile.mobile_secondary || '' %>" class="w-full rounded-xl border p-3"><textarea name="address" class="w-full rounded-xl border p-3"><%= profile.address || '' %></textarea><textarea name="allergies" class="w-full rounded-xl border p-3"><%= profile.allergies || '' %></textarea><textarea name="medications" class="w-full rounded-xl border p-3"><%= profile.medications || '' %></textarea><textarea name="medical_conditions" class="w-full rounded-xl border p-3"><%= profile.medical_conditions || '' %></textarea><textarea name="custom_message" class="w-full rounded-xl border p-3"><%= profile.custom_message || '' %></textarea><input name="owner_whatsapp" value="<%= profile.owner_whatsapp || '' %>" class="w-full rounded-xl border p-3"><button class="w-full rounded-xl bg-teal py-3 font-bold text-white">Save</button></form></main><%- include('layout/footer') %>
