# SafeTag Flask backend environment variables
# Copy to .env and fill in actual values. Never commit .env.

# REQUIRED
SECRET_KEY=replace_with_python_secrets_token_hex_32
DATABASE_URL=sqlite:///dev.db
BASE_URL=http://localhost:3000
DUMMY_PAYMENT=true
FLASK_DEBUG=1
PORT=5000

# Internal token Node.js sends to Flask in the X-Internal-Token header so the API
# can trust requests coming from the trusted Node.js layer (used for routes that
# Node.js calls on behalf of an authenticated user, e.g. session-based ones).
INTERNAL_API_TOKEN=replace_with_long_random_string

# Razorpay (production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio (WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (Flask-Mail / Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@safe-tag.in

# Cloudinary (photo upload)
CLOUDINARY_URL=

# Google Maps (used by frontend; stored here for centralised config)
GOOGLE_MAPS_API_KEY=

# Sentry
SENTRY_DSN=

# Optional production hardening
SESSION_COOKIE_SECURE=false
