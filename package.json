{
  "name": "safetag",
  "version": "2.0.0",
  "description": "SafeTag — full-stack Node.js/Express + Prisma. No Python backend.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "hero": "node docs/build-hero-manifest.js",
    "build": "npx prisma generate && npx tailwindcss -i ./public/css/input.css -o ./public/css/safetag.build.css --minify",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/safetag.build.css --minify",
    "dev:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/safetag.build.css --watch",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "jest": "^30.4.2",
    "postcss": "^8.5.15",
    "pptxgenjs": "^4.0.1",
    "prisma": "^5.14.0",
    "sharp": "^0.34.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=20"
  }
}
