<%- include('layout/_head') %>

<style>
  .wc-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-top:3rem;text-align:left}
  @media (max-width:820px){.wc-steps{grid-template-columns:1fr}}
  .wc-step{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:1.9rem 1.6rem;box-shadow:var(--shadow-sm)}
  .wc-ic{width:48px;height:48px;border-radius:999px;background:#e6fbf7;display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
  .wc-ic .material-symbols-outlined{color:var(--teal-d);font-size:1.5rem}
  .wc-step .wc-num{font-size:.72rem;font-weight:800;letter-spacing:.12em;color:var(--teal-d);margin-bottom:.35rem}
  .wc-step h3{font-family:'Sora',sans-serif;font-size:1.15rem;color:var(--navy);margin-bottom:.4rem}
  .wc-step p{color:var(--muted);font-size:.95rem}
  .wc-cta{display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;margin-top:2.75rem}
</style>

<section class="section center">
  <div class="wrap">

    <span class="eyebrow"><span class="material-symbols-outlined" style="font-size:1rem;">celebration</span> Account ready</span>
    <h2 style="margin-top:1.1rem;">
      Welcome<% if (user && user.name) { %>, <%= user.name.split(' ')[0] %><% } %>
    </h2>
    <p class="lead">Your SafeTag account is ready. Three steps to protect your family.</p>

    <div class="wc-steps">

      <div class="wc-step">
        <div class="wc-ic"><span class="material-symbols-outlined">shopping_cart</span></div>
        <div class="wc-num">STEP 1</div>
        <h3>Get your tag</h3>
        <p>Order a SafeTag keychain, sticker, wristband, or card. Ships across India from ₹149.</p>
      </div>

      <div class="wc-step">
        <div class="wc-ic"><span class="material-symbols-outlined">photo_camera</span></div>
        <div class="wc-num">STEP 2</div>
        <h3>Activate it</h3>
        <p>When your tag arrives, scan the QR code on it to link it to this account. Takes 10 seconds.</p>
      </div>

      <div class="wc-step">
        <div class="wc-ic"><span class="material-symbols-outlined">edit</span></div>
        <div class="wc-num">STEP 3</div>
        <h3>Set up profile</h3>
        <p>Fill in blood group, allergies, and emergency contacts. Done in 2 minutes. Update any time.</p>
      </div>

    </div>

    <div class="wc-cta">
      <a href="/store" class="btn">Browse store — from ₹149</a>
      <a href="/dashboard" class="btn-ghost">I already have a tag →</a>
    </div>

    <p style="margin-top:1.5rem;color:var(--muted);font-size:.9rem;">
      You can also go to your <a href="/dashboard" style="color:var(--teal-d);font-weight:600;">dashboard</a> any time to manage tags and orders.
    </p>

  </div>
</section>

<%- include('layout/_foot') %>
