<%- include('layout/_head', { hideNav: true, hideFooter: true }) %>

<style>
/* ── Emergency Page — Clean Medical ID Card Design ── */
html, body { background: #f1f5f9; margin: 0; padding: 0; }

.ep-wrap {
  min-height: 100vh;
  background: #f1f5f9;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── Sticky green header ── */
.ep-header {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  background: #0D9488;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .8rem 1.25rem;
  box-shadow: 0 2px 12px rgba(0,0,0,.18);
}
.ep-header-logo {
  display: flex;
  align-items: center;
  gap: .5rem;
  text-decoration: none;
  color: #fff;
  font-weight: 700;
  font-size: 1.05rem;
  letter-spacing: .01em;
}
.ep-verified {
  display: flex;
  align-items: center;
  gap: .35rem;
  font-size: .78rem;
  font-weight: 600;
  background: rgba(255,255,255,.2);
  padding: .3rem .8rem;
  border-radius: 99px;
  letter-spacing: .02em;
}

/* ── Body container ── */
.ep-body {
  width: 100%;
  max-width: 440px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: .85rem;
}

/* ── Profile hero card ── */
.ep-hero {
  background: #fff;
  border-radius: 16px;
  padding: 1.75rem 1rem 1.5rem;
  text-align: center;
  box-shadow: 0 1px 8px rgba(0,0,0,.08);
}
.ep-avatar {
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: #f0fdfa;
  border: 3px solid #0D9488;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.4rem;
  margin: 0 auto .9rem;
  overflow: hidden;
}
.ep-name {
  font-size: 1.65rem;
  font-weight: 800;
  color: #0a2342;
  margin: 0 0 .25rem;
  line-height: 1.15;
}
.ep-subtitle {
  font-size: .85rem;
  color: #64748b;
  margin: 0 0 .85rem;
  font-weight: 500;
}
.ep-chip-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .4rem;
  flex-wrap: wrap;
}
.ep-chip {
  font-size: .75rem;
  font-weight: 600;
  padding: .22rem .7rem;
  border-radius: 99px;
  background: #f1f5f9;
  color: #475569;
  text-transform: capitalize;
}

/* ── Info sections (white cards) ── */
.ep-section {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 1px 8px rgba(0,0,0,.08);
}
.ep-section-head {
  padding: .7rem 1.1rem;
  font-size: .72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: #0a2342;
  background: #f8fafc;
  border-bottom: 1px solid #f1f5f9;
}
.ep-field {
  padding: .9rem 1.1rem;
  border-bottom: 1px solid #f8fafc;
}
.ep-field:last-child { border-bottom: none; }
.ep-label {
  font-size: .68rem;
  color: #94a3b8;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: .3rem;
}
.ep-val {
  font-size: .95rem;
  color: #374151;
  font-weight: 500;
  line-height: 1.55;
}

/* ── Blood group display ── */
.ep-blood-row {
  display: flex;
  align-items: center;
  gap: .55rem;
  margin-top: .1rem;
}
.ep-blood-drop { font-size: 1.55rem; }
.ep-blood-val {
  font-size: 1.9rem;
  font-weight: 900;
  color: #dc2626;
  font-family: monospace;
  line-height: 1;
}

/* ── Allergy pills ── */
.ep-allergy-row { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .2rem; }
.ep-allergy-pill {
  background: #fee2e2;
  color: #991b1b;
  font-size: .78rem;
  font-weight: 600;
  padding: .2rem .6rem;
  border-radius: 99px;
}

/* ── Call / action buttons ── */
.ep-btn-area {
  padding: .9rem 1.1rem;
  display: flex;
  flex-direction: column;
  gap: .6rem;
}
.ep-call-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .6rem;
  background: #16a34a;
  color: #fff;
  border-radius: 12px;
  padding: 1rem 1.25rem;
  font-weight: 700;
  font-size: .95rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
  width: 100%;
}
.ep-call-primary:hover { background: #15803d; }

.ep-call-alt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .6rem;
  background: #f0fdf4;
  color: #15803d;
  border: 1.5px solid #16a34a;
  border-radius: 12px;
  padding: .8rem 1.25rem;
  font-weight: 600;
  font-size: .9rem;
  text-decoration: none;
}
.ep-call-alt:hover { background: #dcfce7; }

.ep-wa-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .6rem;
  background: #25D366;
  color: #fff;
  border-radius: 12px;
  padding: .85rem 1.25rem;
  font-weight: 700;
  font-size: .9rem;
  border: none;
  cursor: pointer;
  width: 100%;
  text-decoration: none;
}
.ep-wa-btn:hover { background: #1da851; }

/* ── Location share standalone button ── */
.ep-loc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .6rem;
  background: #1d4ed8;
  color: #fff;
  border-radius: 12px;
  padding: .9rem 1.25rem;
  font-weight: 700;
  font-size: .9rem;
  border: none;
  cursor: pointer;
  width: 100%;
  max-width: 440px;
}
.ep-loc-btn:hover { background: #1e40af; }
.ep-loc-status {
  text-align: center;
  font-size: .8rem;
  color: #64748b;
  display: none;
  padding: .35rem;
  max-width: 440px;
}

/* ── Footer ── */
.ep-footer {
  text-align: center;
  padding: .5rem 1rem 1.5rem;
  font-size: .78rem;
  color: #94a3b8;
  max-width: 440px;
  width: 100%;
}
.ep-footer a { color: #0D9488; text-decoration: none; font-weight: 600; }

/* ── Activate flash ── */
.ep-flash {
  background: #dcfce7;
  color: #15803d;
  border-radius: 10px;
  padding: .75rem 1rem;
  font-size: .85rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: .5rem;
  max-width: 440px;
  width: 100%;
  box-sizing: border-box;
  margin: 0 1rem;
}
</style>

<div class="ep-wrap">

  <!-- ── Sticky green header ── -->
  <header class="ep-header">
    <a href="/" class="ep-header-logo">
      <img src="/static/images/websiteLogo.png" alt=""
           style="height:22px;width:auto;filter:brightness(0) invert(1);"
           onerror="this.style.display='none'" />
      SafeTag
    </a>
    <div class="ep-verified">✓ Verified Profile</div>
  </header>

  <% if (activated) { %>
    <div style="padding:.75rem 1rem 0;width:100%;max-width:440px;box-sizing:border-box;">
      <div class="ep-flash">✅ Your SafeTag is now active. Share this page with your family.</div>
    </div>
  <% } %>

  <!-- ── Page body ── -->
  <div class="ep-body">

    <!-- Profile hero -->
    <div class="ep-hero">
      <% var _cat = (profile.category || '').toLowerCase(); %>
      <div class="ep-avatar">
        <% if (profile.photo_url) { %>
          <img src="<%= profile.photo_url %>" alt="" style="width:100%;height:100%;object-fit:cover;" />
        <% } else if (_cat === 'child') { %>
          👧
        <% } else if (_cat === 'elderly') { %>
          👴
        <% } else if (_cat === 'pet') { %>
          🐕
        <% } else if (_cat === 'traveler') { %>
          🧳
        <% } else if (_cat === 'athlete') { %>
          🚴
        <% } else { %>
          👤
        <% } %>
      </div>
      <h1 class="ep-name"><%= profile.name %></h1>
      <p class="ep-subtitle">Emergency Profile</p>
      <div class="ep-chip-row">
        <% if (profile.age) { %>
          <span class="ep-chip">Age <%= profile.age %></span>
        <% } %>
        <% if (profile.category) { %>
          <span class="ep-chip"><%= profile.category %></span>
        <% } %>
      </div>
    </div>

    <!-- Medical Information -->
    <div class="ep-section">
      <div class="ep-section-head">Medical Information</div>

      <div class="ep-field">
        <div class="ep-label">Blood Group</div>
        <% if (profile.blood_group) { %>
          <div class="ep-blood-row">
            <span class="ep-blood-drop">🩸</span>
            <span class="ep-blood-val"><%= profile.blood_group %></span>
          </div>
        <% } else { %>
          <div class="ep-val" style="color:#94a3b8;">Not recorded</div>
        <% } %>
      </div>

      <div class="ep-field">
        <div class="ep-label">Known Conditions</div>
        <div class="ep-val"><%= profile.medical_conditions || 'None' %></div>
      </div>

      <div class="ep-field">
        <div class="ep-label">Allergies</div>
        <% if (profile.allergies && profile.allergies.trim()) { %>
          <div class="ep-allergy-row">
            <% profile.allergies.split(',').map(function(a){ return a.trim(); }).filter(Boolean).forEach(function(a){ %>
              <span class="ep-allergy-pill">⚠️ <%= a %></span>
            <% }); %>
          </div>
        <% } else { %>
          <div class="ep-val">None</div>
        <% } %>
      </div>

      <% if (profile.medications) { %>
      <div class="ep-field">
        <div class="ep-label">Medications</div>
        <div class="ep-val"><%= profile.medications %></div>
      </div>
      <% } %>
    </div>

    <!-- Emergency Contact -->
    <div class="ep-section">
      <div class="ep-section-head">Emergency Contact</div>

      <% if (profile.parent_name) { %>
      <div class="ep-field">
        <div class="ep-label">Contact</div>
        <div class="ep-val">👨‍👩‍👧 <%= profile.parent_name %></div>
      </div>
      <% } %>

      <div class="ep-field">
        <div class="ep-label">Primary Contact</div>
        <div class="ep-val">Tap below to call</div>
      </div>

      <div class="ep-btn-area">
        <a href="tel:+91<%= profile.mobile_primary %>" class="ep-call-primary">
          📞 &nbsp;Call Emergency Contact
        </a>
        <% if (profile.mobile_secondary) { %>
          <a href="tel:+91<%= profile.mobile_secondary %>" class="ep-call-alt">
            📞 &nbsp;Call Emergency Contact 2
          </a>
        <% } %>
        <% if (profile.owner_whatsapp) { %>
          <a href="https://wa.me/91<%= profile.owner_whatsapp %>?text=<%= encodeURIComponent('🚨 I found someone with a SafeTag ID: ' + tag_id + '. Person: ' + profile.name) %>" target="_blank" rel="noopener" class="ep-wa-btn">
            💬 &nbsp;WhatsApp Emergency Contact
          </a>
        <% } %>
      </div>
    </div>

    <!-- Address / Home Location -->
    <% if (profile.address || profile.custom_message) { %>
    <div class="ep-section">
      <% if (profile.address) { %>
      <div class="ep-field" style="<%= profile.custom_message ? '' : 'border-bottom:none;' %>">
        <div class="ep-label">Home Address</div>
        <div class="ep-val"><%= profile.address %></div>
        <% if (profile.latitude && profile.longitude) { %>
          <a href="https://maps.google.com/?q=<%= profile.latitude %>,<%= profile.longitude %>"
             target="_blank" rel="noopener"
             style="display:inline-flex;align-items:center;gap:.3rem;margin-top:.5rem;font-size:.82rem;font-weight:600;color:#0D9488;text-decoration:none;">
            📍 Open in Maps →
          </a>
        <% } %>
      </div>
      <% } %>
      <% if (profile.custom_message) { %>
      <div class="ep-field" style="border-bottom:none;">
        <div class="ep-label">Message from Family</div>
        <div class="ep-val" style="font-style:italic;color:#475569;">"<%= profile.custom_message %>"</div>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Share location via WhatsApp (on-demand, not auto-triggered) -->
    <% if (profile.mobile_primary) { %>
    <button id="epLocBtn" class="ep-loc-btn" onclick="shareLocation()">
      📍 &nbsp;Share My Location via WhatsApp
    </button>
    <div id="epLocStatus" class="ep-loc-status"></div>
    <% } %>

    <!-- Footer -->
    <div class="ep-footer">
      <p style="margin:0 0 .3rem;">This information can save lives in an emergency.</p>
      <p style="margin:0;">Protected by <a href="/">SafeTag</a> · India's emergency ID platform</p>
    </div>

  </div><!-- end ep-body -->
</div><!-- end ep-wrap -->

<script>
(function () {
  var primary = <%- JSON.stringify(profile.mobile_primary || '') %>;
  var tagId   = <%- JSON.stringify(tag_id) %>;
  var name    = <%- JSON.stringify(profile.name || '') %>;

  window.shareLocation = function () {
    var btn    = document.getElementById('epLocBtn');
    var status = document.getElementById('epLocStatus');
    if (!navigator.geolocation) {
      status.textContent = 'Location not supported on this device.';
      status.style.display = 'block';
      return;
    }
    btn.textContent = '⏳  Getting location…';
    btn.disabled = true;
    navigator.geolocation.getCurrentPosition(
      function (pos) {
        var lat  = pos.coords.latitude.toFixed(5);
        var lng  = pos.coords.longitude.toFixed(5);
        var maps = 'https://maps.google.com/?q=' + lat + ',' + lng;
        var msg  = encodeURIComponent(
          '🚨 EMERGENCY — I found someone with a SafeTag.\n' +
          'Tag ID: ' + tagId + '\n' +
          'Person: ' + name + '\n' +
          'My location: ' + maps
        );
        window.open('https://wa.me/91' + primary + '?text=' + msg, '_blank');
        btn.textContent = '📍  Share My Location via WhatsApp';
        btn.disabled = false;
      },
      function () {
        var msg = encodeURIComponent(
          '🚨 EMERGENCY — I found someone with a SafeTag.\n' +
          'Tag ID: ' + tagId + '\n' +
          'Person: ' + name + '\n' +
          '(Could not get precise location)'
        );
        window.open('https://wa.me/91' + primary + '?text=' + msg, '_blank');
        btn.textContent = '📍  Share My Location via WhatsApp';
        btn.disabled = false;
      },
      { timeout: 10000 }
    );
  };
})();
</script>

<%- include('layout/_foot', { hideFooter: true }) %>
