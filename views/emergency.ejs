<%- include('layout/_head', { hideNav: true, hideFooter: true }) %>

<style>
/* ── Emergency Page — SafeTag light design system (tokens from theme.css) ── */
html, body { background: var(--cream); margin: 0; padding: 0; }

.ep-wrap {
  min-height: 100vh;
  background: var(--cream);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── Sticky teal header ── */
.ep-header {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  background: var(--teal);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .85rem 1.25rem;
  box-shadow: 0 2px 14px rgba(10,35,66,.18);
}
.ep-header-logo {
  display: flex;
  align-items: center;
  gap: .5rem;
  text-decoration: none;
  color: #fff;
  font-family: 'Sora', system-ui, sans-serif;
  font-weight: 800;
  font-size: 1.1rem;
  letter-spacing: -.01em;
}
.ep-verified {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .76rem;
  font-weight: 600;
  background: rgba(255,255,255,.18);
  padding: .32rem .8rem;
  border-radius: 999px;
  letter-spacing: .02em;
}
.ep-verified .material-symbols-outlined { color: #fff; font-size: 1rem; }

/* ── Body container ── */
.ep-body {
  width: 100%;
  max-width: 440px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: .9rem;
}

/* ── Profile hero card ── */
.ep-hero {
  background: var(--white);
  border-radius: var(--r);
  padding: 1.9rem 1rem 1.6rem;
  text-align: center;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--line);
}
.ep-avatar {
  width: 88px;
  height: 88px;
  border-radius: 999px;
  background: #e6fbf7;
  border: 3px solid var(--teal);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1rem;
  overflow: hidden;
}
.ep-avatar .material-symbols-outlined { color: var(--teal); font-size: 2.6rem; }
.ep-name {
  font-family: 'Sora', system-ui, sans-serif;
  font-size: 1.7rem;
  font-weight: 800;
  color: var(--navy) !important;   /* navy — tri-color: teal header + white card + navy text */
  letter-spacing: -.02em;
  margin: 0 0 .3rem;
  line-height: 1.15;
  text-shadow: none !important;
  opacity: 1 !important;
}
.ep-subtitle {
  font-size: .85rem;
  color: var(--muted);
  margin: 0 0 .9rem;
  font-weight: 500;
}
.ep-chip-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .4rem;
  flex-wrap: wrap;
}
.ep-chip {
  font-size: .74rem;
  font-weight: 600;
  padding: .25rem .75rem;
  border-radius: 999px;
  background: #e6fbf7;
  color: var(--teal-d);
  text-transform: capitalize;
}

/* ── Info sections (white cards) ── */
.ep-section {
  background: var(--white);
  border-radius: var(--r);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--line);
}
.ep-section-head {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: .8rem 1.1rem;
  font-size: .72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: var(--navy);
  background: var(--cream);
  border-bottom: 1px solid var(--line);
}
.ep-section-head .material-symbols-outlined { color: var(--teal); font-size: 1.15rem; }
.ep-field {
  padding: .95rem 1.1rem;
  border-bottom: 1px solid var(--line);
}
.ep-field:last-child { border-bottom: none; }
.ep-label {
  font-size: .68rem;
  color: var(--muted);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: .35rem;
}
.ep-val {
  font-size: .96rem;
  color: var(--ink);
  font-weight: 500;
  line-height: 1.55;
}
.ep-val-muted { color: var(--muted); }
.ep-contact-line { display: inline-flex; align-items: center; gap: .4rem; }
.ep-contact-line .material-symbols-outlined { color: var(--teal); font-size: 1.15rem; }

/* ── Blood group display ── */
.ep-blood-row {
  display: flex;
  align-items: center;
  gap: .55rem;
  margin-top: .1rem;
}
.ep-blood-row .material-symbols-outlined { color: #dc2626; font-size: 1.7rem; }
.ep-blood-val {
  font-size: 1.9rem;
  font-weight: 800;
  color: #dc2626;
  font-family: 'Sora', system-ui, sans-serif;
  letter-spacing: -.02em;
  line-height: 1;
}

/* ── Allergy pills ── */
.ep-allergy-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .25rem; }
.ep-allergy-pill {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  background: #fee2e2;
  color: #991b1b;
  font-size: .78rem;
  font-weight: 600;
  padding: .22rem .65rem;
  border-radius: 999px;
}
.ep-allergy-pill .material-symbols-outlined { color: #b91c1c; font-size: 1rem; }

/* ── Map link ── */
.ep-map-link {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  margin-top: .55rem;
  font-size: .82rem;
  font-weight: 600;
  color: var(--teal-d);
  text-decoration: none;
}
.ep-map-link .material-symbols-outlined { color: var(--teal-d); font-size: 1.05rem; }

/* ── Call / action buttons (class names also used by revealContact JS) ── */
.ep-btn-area {
  padding: .9rem 1.1rem;
  display: flex;
  flex-direction: column;
  gap: .6rem;
}
.ep-call-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  background: #22c55e;
  color: #fff;
  border-radius: 999px;
  padding: .95rem 1.25rem;
  font-family: 'Sora', system-ui, sans-serif;
  font-weight: 700;
  font-size: .95rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
  width: 100%;
  transition: .18s;
}
.ep-call-primary:hover { background: #16a34a; transform: translateY(-1px); }

.ep-call-alt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  background: #fff;
  color: var(--teal-d);
  border: 1.5px solid var(--teal);
  border-radius: 999px;
  padding: .8rem 1.25rem;
  font-weight: 600;
  font-size: .9rem;
  text-decoration: none;
  transition: .18s;
}
.ep-call-alt:hover { background: #e6fbf7; }

.ep-wa-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  background: #25D366;
  color: #fff;
  border-radius: 999px;
  padding: .85rem 1.25rem;
  font-weight: 700;
  font-size: .9rem;
  border: none;
  cursor: pointer;
  width: 100%;
  text-decoration: none;
  transition: .18s;
}
.ep-wa-btn:hover { background: #1da851; }

/* icons inside action buttons inherit button text colour */
.ep-call-primary .material-symbols-outlined,
.ep-call-alt .material-symbols-outlined,
.ep-wa-btn .material-symbols-outlined,
.ep-loc-btn .material-symbols-outlined { color: currentColor; font-size: 1.25rem; }

/* ── Location share standalone button ── */
.ep-loc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  background: var(--teal);
  color: #fff;
  border-radius: 999px;
  padding: .95rem 1.25rem;
  font-family: 'Sora', system-ui, sans-serif;
  font-weight: 700;
  font-size: .9rem;
  border: none;
  cursor: pointer;
  width: 100%;
  max-width: 440px;
  box-shadow: 0 12px 26px rgba(13,148,136,.28);
  transition: .18s;
}
.ep-loc-btn:hover { background: var(--teal-d); transform: translateY(-1px); }
.ep-loc-status {
  text-align: center;
  font-size: .8rem;
  color: var(--muted);
  display: none;
  padding: .35rem;
  max-width: 440px;
}

/* ── Footer ── */
.ep-footer {
  text-align: center;
  padding: .5rem 1rem 1.75rem;
  font-size: .78rem;
  color: var(--muted);
  max-width: 440px;
  width: 100%;
}
.ep-footer a { color: var(--teal-d); text-decoration: none; font-weight: 600; }

/* ── Activate flash ── */
.ep-flash {
  display: flex;
  align-items: center;
  gap: .5rem;
  background: #e6fbf7;
  color: var(--teal-d);
  border: 1px solid #b9f0e6;
  border-radius: 14px;
  padding: .8rem 1rem;
  font-size: .85rem;
  font-weight: 600;
  max-width: 440px;
  width: 100%;
  box-sizing: border-box;
}
.ep-flash .material-symbols-outlined { color: var(--teal); font-size: 1.2rem; }
</style>

<div class="ep-wrap">

  <!-- ── Sticky teal header ── -->
  <header class="ep-header">
    <a href="/" class="ep-header-logo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
        <circle cx="7" cy="7" r="1" fill="white" stroke="none"/>
      </svg>
      SafeTag
    </a>
    <div class="ep-verified"><span class="material-symbols-outlined">verified</span> Verified Profile</div>
  </header>

  <% if (activated) { %>
    <div style="padding:.75rem 1rem 0;width:100%;max-width:440px;box-sizing:border-box;">
      <div class="ep-flash"><span class="material-symbols-outlined">check_circle</span> Your SafeTag is now active. Share this page with your family.</div>
    </div>
  <% } %>

  <!-- ── Page body ── -->
  <div class="ep-body">

    <!-- Profile hero -->
    <div class="ep-hero">
      <% var _cat = (profile.category || '').toLowerCase(); %>
      <div class="ep-avatar">
        <% if (profile.photo_url) { %>
          <img src="<%= profile.photo_url %>" alt="" style="width:100%;height:100%;object-fit:cover;" />
        <% } else if (_cat === 'child') { %>
          <span class="material-symbols-outlined">child_care</span>
        <% } else if (_cat === 'elderly') { %>
          <span class="material-symbols-outlined">elderly</span>
        <% } else if (_cat === 'pet') { %>
          <span class="material-symbols-outlined">pets</span>
        <% } else if (_cat === 'traveler') { %>
          <span class="material-symbols-outlined">luggage</span>
        <% } else if (_cat === 'athlete') { %>
          <span class="material-symbols-outlined">directions_bike</span>
        <% } else { %>
          <span class="material-symbols-outlined">person</span>
        <% } %>
      </div>
      <h1 class="ep-name" style="color:var(--navy);"><%= profile.name %></h1>
      <p class="ep-subtitle">Emergency Profile</p>
      <div class="ep-chip-row">
        <% if (profile.age) { %>
          <span class="ep-chip">Age <%= profile.age %></span>
        <% } %>
        <% if (profile.category) { %>
          <span class="ep-chip"><%= profile.category %></span>
        <% } %>
      </div>
    </div>

    <!-- Medical Information -->
    <div class="ep-section">
      <div class="ep-section-head"><span class="material-symbols-outlined">medical_information</span> Medical Information</div>

      <div class="ep-field">
        <div class="ep-label">Blood Group</div>
        <% if (profile.blood_group) { %>
          <div class="ep-blood-row">
            <span class="material-symbols-outlined">bloodtype</span>
            <span class="ep-blood-val"><%= profile.blood_group %></span>
          </div>
        <% } else { %>
          <div class="ep-val ep-val-muted">Not recorded</div>
        <% } %>
      </div>

      <div class="ep-field">
        <div class="ep-label">Known Conditions</div>
        <div class="ep-val"><%= profile.medical_conditions || 'None' %></div>
      </div>

      <div class="ep-field">
        <div class="ep-label">Allergies</div>
        <% if (profile.allergies && profile.allergies.trim()) { %>
          <div class="ep-allergy-row">
            <% profile.allergies.split(',').map(function(a){ return a.trim(); }).filter(Boolean).forEach(function(a){ %>
              <span class="ep-allergy-pill"><span class="material-symbols-outlined">warning</span> <%= a %></span>
            <% }); %>
          </div>
        <% } else { %>
          <div class="ep-val">None</div>
        <% } %>
      </div>

      <% if (profile.medications) { %>
      <div class="ep-field">
        <div class="ep-label">Medications</div>
        <div class="ep-val"><span class="ep-contact-line"><span class="material-symbols-outlined">medication</span> <%= profile.medications %></span></div>
      </div>
      <% } %>
    </div>

    <!-- Emergency Contact -->
    <div class="ep-section">
      <div class="ep-section-head"><span class="material-symbols-outlined">contacts</span> Emergency Contact</div>

      <% if (profile.parent_name) { %>
      <div class="ep-field">
        <div class="ep-label">Contact</div>
        <div class="ep-val"><span class="ep-contact-line"><span class="material-symbols-outlined">family_restroom</span> <%= profile.parent_name %></span></div>
      </div>
      <% } %>

      <div class="ep-field">
        <div class="ep-label">Primary Contact</div>
        <div class="ep-val">Tap below to call</div>
      </div>

      <!-- Contact numbers are revealed on tap (see script below): they are NOT
           emitted as plain digits or tel: links in the page source, so casual
           scrapers/bots that harvest the raw HTML get nothing. -->
      <div class="ep-btn-area" id="epBtnArea">
        <% if (profile.mobile_primary) { %>
        <button id="epRevealBtn" type="button" class="ep-call-primary" onclick="revealContact()">
          <span class="material-symbols-outlined">call</span> Show Emergency Contact
        </button>
        <noscript>
          <div class="ep-loc-status" style="display:block;">Enable JavaScript to view the emergency contact number.</div>
        </noscript>
        <% } %>
      </div>
    </div>

    <!-- Address / Home Location -->
    <% if (profile.address || profile.custom_message) { %>
    <div class="ep-section">
      <% if (profile.address) { %>
      <div class="ep-field" style="<%= profile.custom_message ? '' : 'border-bottom:none;' %>">
        <div class="ep-label">Home Address</div>
        <div class="ep-val"><%= profile.address %></div>
        <% if (profile.latitude && profile.longitude) { %>
          <a href="https://maps.google.com/?q=<%= profile.latitude %>,<%= profile.longitude %>"
             target="_blank" rel="noopener" class="ep-map-link">
            <span class="material-symbols-outlined">location_on</span> Open in Maps &rarr;
          </a>
        <% } %>
      </div>
      <% } %>
      <% if (profile.custom_message) { %>
      <div class="ep-field" style="border-bottom:none;">
        <div class="ep-label">Message from Family</div>
        <div class="ep-val" style="font-style:italic;color:var(--muted);">"<%= profile.custom_message %>"</div>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Share location via WhatsApp (on-demand, not auto-triggered) -->
    <% if (profile.mobile_primary) { %>
    <button id="epLocBtn" class="ep-loc-btn" onclick="shareLocation()">
      <span class="material-symbols-outlined">share_location</span> Alert Emergency Contact via WhatsApp
    </button>
    <div id="epLocStatus" class="ep-loc-status"></div>
    <% } %>

    <!-- Footer -->
    <div class="ep-footer">
      <p style="margin:0 0 .3rem;">This information can save lives in an emergency.</p>
      <p style="margin:0;">Protected by <a href="/">SafeTag</a> &middot; India's emergency ID platform</p>
    </div>

  </div><!-- end ep-body -->
</div><!-- end ep-wrap -->

<script>
(function () {
  // Contact numbers are base64-encoded so they are NOT present as plain digits
  // (or tel: links) in the page source — this defeats naive scrapers/bots.
  // A responder taps "Show Emergency Contact" to decode and reveal the actions.
  var C = {
    p: <%- JSON.stringify(Buffer.from(String(profile.mobile_primary   || ''), 'utf8').toString('base64')) %>,
    s: <%- JSON.stringify(Buffer.from(String(profile.mobile_secondary || ''), 'utf8').toString('base64')) %>,
    w: <%- JSON.stringify(Buffer.from(String(profile.owner_whatsapp    || ''), 'utf8').toString('base64')) %>
  };
  var tagId   = <%- JSON.stringify(tag_id) %>;
  var name    = <%- JSON.stringify(profile.name || '') %>;
  function dec(b) { try { return b ? atob(b) : ''; } catch (e) { return ''; } }

  window.revealContact = function () {
    var p = dec(C.p), s = dec(C.s), w = dec(C.w);
    var waMsg = encodeURIComponent('🚨 I found someone with a SafeTag ID: ' + tagId + '. Person: ' + name);
    var ico = '<span class="material-symbols-outlined">call</span> ';
    var waIco = '<span class="material-symbols-outlined">chat</span> ';
    var html = '';
    if (p) html += '<a href="tel:+91' + p + '" class="ep-call-primary">' + ico + 'Call Emergency Contact</a>';
    if (s) html += '<a href="tel:+91' + s + '" class="ep-call-alt">' + ico + 'Call Emergency Contact 2</a>';
    if (w) html += '<a href="https://wa.me/91' + w + '?text=' + waMsg + '" target="_blank" rel="noopener" class="ep-wa-btn">' + waIco + 'WhatsApp Emergency Contact</a>';
    var btn = document.getElementById('epRevealBtn');
    if (!btn) return;
    btn.insertAdjacentHTML('afterend', html);
    btn.remove();
  };

  window.shareLocation = function () {
    var btn    = document.getElementById('epLocBtn');
    var status = document.getElementById('epLocStatus');
    var primary = dec(C.p);
    if (!primary) return;
    if (!navigator.geolocation) {
      status.textContent = 'Location not supported on this device.';
      status.style.display = 'block';
      return;
    }
    var LOC_LABEL = '<span class="material-symbols-outlined">share_location</span> Alert Emergency Contact via WhatsApp';
    btn.innerHTML = '<span class="material-symbols-outlined">hourglass_top</span> Getting location…';
    btn.disabled = true;
    navigator.geolocation.getCurrentPosition(
      function (pos) {
        var lat  = pos.coords.latitude.toFixed(5);
        var lng  = pos.coords.longitude.toFixed(5);
        var maps = 'https://maps.google.com/?q=' + lat + ',' + lng;
        var msg  = encodeURIComponent(
          '🚨 EMERGENCY — I found someone with a SafeTag.\n' +
          'Tag ID: ' + tagId + '\n' +
          'Person: ' + name + '\n' +
          'My location: ' + maps
        );
        window.open('https://wa.me/91' + primary + '?text=' + msg, '_blank');
        btn.innerHTML = LOC_LABEL;
        btn.disabled = false;
      },
      function () {
        var msg = encodeURIComponent(
          '🚨 EMERGENCY — I found someone with a SafeTag.\n' +
          'Tag ID: ' + tagId + '\n' +
          'Person: ' + name + '\n' +
          '(Could not get precise location)'
        );
        window.open('https://wa.me/91' + primary + '?text=' + msg, '_blank');
        btn.innerHTML = LOC_LABEL;
        btn.disabled = false;
      },
      { timeout: 10000 }
    );
  };
})();
</script>

<%- include('layout/_foot', { hideFooter: true }) %>
