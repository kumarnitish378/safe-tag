<%- include('layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="scan-emergency-bg min-h-screen">
  <div class="max-w-3xl mx-auto pb-10 lg:grid lg:grid-cols-5 lg:gap-0 lg:items-start">
  <!-- LEFT PANEL: emergency card (full width on mobile, 3/5 on desktop) -->
  <div class="lg:col-span-3">
    <!-- Brand bar -->
    <div class="bg-brand text-white px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/static/images/websiteLogo.png" alt="SafeTag" class="h-6 object-contain" style="max-width:24px;" onerror="this.style.display='none'" />
        <span class="font-semibold">SafeTag</span>
      </a>
      <div class="flex items-center gap-2 text-xs"><span class="w-2 h-2 bg-success rounded-full inline-block"></span> VERIFIED PROFILE</div>
    </div>

    <!-- Emergency bar -->
    <div class="bg-danger text-white px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xl">⚠️</span>
        <strong class="tracking-wide uppercase text-sm">Emergency Identification Card</strong>
      </div>
      <span class="mono text-xs opacity-90"><%= tag_id %></span>
    </div>

    <% if (activated) { %>
      <div class="px-4 pt-4"><div class="flash flash-success">✅ Your SafeTag is now active. Bookmark this page or share with family.</div></div>
    <% } %>

    <!-- Identity card -->
    <div class="card mx-4 mt-4 overflow-hidden">
      <div class="bg-navy text-white p-5 flex gap-4 items-center">
        <% if (profile.photo_url) { %>
          <img src="<%= profile.photo_url %>" alt="" class="w-16 h-16 rounded-full object-cover border-2 border-white/40" />
        <% } else { %>
          <div class="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center text-3xl">
            <% if (profile.category === 'CHILD') { %>👧<% } else if (profile.category === 'ELDERLY') { %>👴<% } else if (profile.category === 'PET') { %>🐕<% } else if (profile.category === 'TRAVELER') { %>🧳<% } else { %>👤<% } %>
          </div>
        <% } %>
        <div class="flex-1 min-w-0">
          <div class="text-2xl font-bold text-white truncate"><%= profile.name %></div>
          <div class="text-sm opacity-90 flex items-center gap-2 mt-1">
            <span>Age <%= profile.age %></span>
            <% if (profile.blood_group) { %><span class="pill pill-danger mono"><%= profile.blood_group %></span><% } %>
            <% if (profile.category) { %><span class="pill bg-white/10 text-white"><%= profile.category %></span><% } %>
          </div>
        </div>
      </div>

      <div class="p-5 space-y-3 text-sm">
        <% if (profile.parent_name) { %>
          <div><div class="text-xs uppercase font-bold text-slate-500 mb-1">Parent / Guardian</div><div class="text-navy font-semibold"><%= profile.parent_name %></div></div>
        <% } %>
        <% if (profile.allergies) { %>
          <div>
            <div class="text-xs uppercase font-bold text-slate-500 mb-1">Allergies</div>
            <div class="flex flex-wrap gap-1">
              <% profile.allergies.split(',').map(function(a){return a.trim();}).filter(Boolean).forEach(function(a){ %><span class="pill pill-warning"><%= a %></span><% }); %>
            </div>
          </div>
        <% } %>
        <% if (profile.medical_conditions) { %>
          <div><div class="text-xs uppercase font-bold text-slate-500 mb-1">Medical Conditions</div><div><%= profile.medical_conditions %></div></div>
        <% } %>
        <% if (profile.medications) { %>
          <div><div class="text-xs uppercase font-bold text-slate-500 mb-1">Medications</div><div><%= profile.medications %></div></div>
        <% } %>
        <% if (profile.address) { %>
          <div>
            <div class="text-xs uppercase font-bold text-slate-500 mb-1">Address</div>
            <div>
              <%= profile.address %>
              <% if (profile.latitude && profile.longitude) { %>
                <a class="text-brand font-semibold ml-1" target="_blank" rel="noopener" href="https://maps.google.com/?q=<%= profile.latitude %>,<%= profile.longitude %>">📍 Map</a>
              <% } %>
            </div>
          </div>
        <% } %>
        <% if (profile.custom_message) { %>
          <div class="border border-amber-300 bg-amber-50 rounded-card p-3">
            <div class="text-xs uppercase font-bold text-amber-700 mb-1">Message from Family</div>
            <div class="text-amber-900"><%= profile.custom_message %></div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- CALL BUTTONS -->
    <div class="px-4 mt-4 space-y-3">
      <a href="tel:+91<%= profile.mobile_primary %>" class="block bg-success hover:bg-green-600 text-white text-center font-bold text-lg py-4 rounded-card">
        📞 Call Now — +91 <%= profile.mobile_primary %>
      </a>
      <% if (profile.mobile_secondary) { %>
        <a href="tel:+91<%= profile.mobile_secondary %>" class="block border-2 border-success text-success font-semibold text-center py-3 rounded-card">
          📞 Call alternate — +91 <%= profile.mobile_secondary %>
        </a>
      <% } %>
      <button id="whatsappBtn" class="block bg-green-700 hover:bg-green-800 text-white font-semibold text-center w-full py-3 rounded-card">
        💬 Send My Location via WhatsApp
      </button>
      <div id="locStatus" class="text-center text-sm hidden"></div>
    </div>

    <!-- Footer -->
    <div class="text-center text-xs text-slate-500 mt-6 px-4">
      Powered by <a href="/" class="text-brand font-semibold">SafeTag · safe-tag.in</a><br/>
      <a href="/store" class="text-brand">Protect your family → Get SafeTag ₹149</a>
    </div>
  </div><!-- end left panel -->

  <!-- RIGHT PANEL: desktop only sidebar -->
  <div class="hidden lg:flex lg:col-span-2 flex-col gap-4 p-6 bg-white/80 backdrop-blur min-h-screen border-l border-slate-200">
    <div class="text-xs uppercase font-bold text-slate-500 tracking-wide mb-1">What to do now</div>
    <div class="space-y-3">
      <div class="flex gap-3 p-3 bg-green-50 border border-green-200 rounded-card">
        <span class="text-2xl">📞</span>
        <div><div class="font-semibold text-sm text-navy">Call the emergency contact</div><div class="text-xs text-slate-500">Tap the green button on the left</div></div>
      </div>
      <div class="flex gap-3 p-3 bg-blue-50 border border-blue-200 rounded-card">
        <span class="text-2xl">📍</span>
        <div><div class="font-semibold text-sm text-navy">Share your location</div><div class="text-xs text-slate-500">Tap "Send My Location via WhatsApp"</div></div>
      </div>
      <div class="flex gap-3 p-3 bg-amber-50 border border-amber-200 rounded-card">
        <span class="text-2xl">🏥</span>
        <div><div class="font-semibold text-sm text-navy">Note blood group &amp; allergies</div><div class="text-xs text-slate-500">Share with paramedics immediately</div></div>
      </div>
    </div>

    <div class="mt-6 border-t border-slate-200 pt-5">
      <div class="text-xs uppercase font-bold text-slate-500 mb-3">Protect your own family</div>
      <p class="text-sm text-slate-600 leading-relaxed mb-4">You just saw how SafeTag works. One scan — instant emergency profile. Get one for your child, parent, or pet.</p>
      <a href="/store" class="btn-warn w-full justify-center text-sm py-2.5">Get SafeTag from ₹149 →</a>
      <a href="/demo" class="btn-outline w-full justify-center text-sm py-2.5 mt-2">See full demo</a>
    </div>

    <div class="mt-auto pt-4 text-center">
      <a href="/" class="flex items-center justify-center gap-2">
        <img src="/static/images/faviconIcon.png" alt="SafeTag" class="w-6 h-6 object-contain rounded" onerror="this.style.display='none'" />
        <span class="font-sora font-bold text-navy text-sm">SafeTag</span>
      </a>
      <p class="text-xs text-slate-400 mt-1">safe-tag.in</p>
    </div>
  </div>

  </div><!-- end max-w-3xl grid -->
</div>

<script>
(function(){
  var tagId = <%- JSON.stringify(tag_id) %>;
  var flaskUrl = <%- JSON.stringify(flaskApiUrl) %>;
  var primary = <%- JSON.stringify(profile.mobile_primary || '') %>;
  var btn = document.getElementById('whatsappBtn');
  var status = document.getElementById('locStatus');
  var coords = null;

  function setStatus(msg, ok) {
    status.className = ok ? 'text-center text-sm text-green-700' : 'text-center text-sm text-slate-600';
    status.textContent = msg;
    status.classList.remove('hidden');
  }

  function buildWhatsappLink(lat, lng) {
    var maps = (lat && lng) ? ('https://maps.google.com/?q=' + lat + ',' + lng) : '';
    var msg = 'Hello, I found someone with a SafeTag (' + tagId + ').' + (maps ? (' Location: ' + maps) : '');
    return 'https://wa.me/91' + primary + '?text=' + encodeURIComponent(msg);
  }

  // Try to get geolocation silently on load — send alert to owner
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(function(p){
      coords = { lat: p.coords.latitude, lng: p.coords.longitude };
      try {
        fetch(flaskUrl + '/api/location-alert', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tag_id: tagId, lat: coords.lat, lng: coords.lng })
        }).then(function(r){ return r.json(); }).then(function(d){
          if (d && d.delivered) setStatus('✅ Owner notified with your location', true);
        }).catch(function(){});
      } catch (e) {}
    }, function(){ /* denied — ok */ }, { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 });
  }

  btn.addEventListener('click', function(){
    if (coords) {
      window.location.href = buildWhatsappLink(coords.lat, coords.lng);
    } else if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(p){
        window.location.href = buildWhatsappLink(p.coords.latitude, p.coords.longitude);
      }, function(){
        window.location.href = buildWhatsappLink(null, null);
      });
    } else {
      window.location.href = buildWhatsappLink(null, null);
    }
  });
})();
</script>

<%- include('layout/_foot', { hideFooter: true }) %>
