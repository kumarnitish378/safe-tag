    <img src="/static/images/hero-crowd-scan.jpg" alt="" class="w-full h-full object-cover object-center opacity-10" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy/65 via-navy/35 to-transparent"></div>
  </div>

