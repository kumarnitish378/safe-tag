<!-- ============================================================
  SECTION 3 — STORE PREVIEW (moved up — friction reduction)
  ============================================================ -->
<section class="section bg-white" id="shop">
  <div class="section-inner">
    <div class="flex items-end justify-between mb-6">
      <div>
        <h2 class="text-4xl font-bold" data-i18n="section.shop">Shop SafeTags</h2>
        <p class="text-slate-500 mt-1 text-lg" data-i18n="section.shop.sub">Starts at ₹149. Ships across India.</p>
      </div>
      <a href="/store" class="text-brand font-semibold hover:underline">See all →</a>
    </div>
    <% if (featured && featured.length) { %>
      <div class="relative">
        <!-- Prev button -->
        <button id="shopPrev" aria-label="Previous" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-9 h-9 bg-white dark:bg-slate-700 shadow-md rounded-full flex items-center justify-center text-navy dark:text-white hover:bg-brand hover:text-white transition -ml-4 text-xl leading-none select-none">‹</button>
        <!-- Track -->
        <div id="shopTrack" class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-2 px-10">
          <% featured.forEach(function(p){ %>
            <a href="/store/<%= p.id %>" class="card p-4 flex-shrink-0 w-52 snap-start block hover:-translate-y-1 transition-transform">
              <div class="w-full h-36 bg-slate-100 rounded-card mb-3 flex items-center justify-center overflow-hidden">
                <% if (p.photo_url) { %>
                  <img src="<%= p.photo_url %>" class="w-full h-36 object-cover rounded-card" alt="<%= p.name %>" />
                <% } else { %>
                  <span class="text-5xl">🏷️</span>
                <% } %>
              </div>
              <% if (p.is_featured) { %><span class="pill pill-warning text-xs mb-1 inline-block">⭐ Best Value</span><% } %>
              <div class="capitalize text-xs text-slate-500 mb-1"><%= p.category %></div>
              <h3 class="font-semibold text-sm mb-2 text-navy leading-snug"><%= p.name %></h3>
              <div class="flex items-center justify-between">
                <span class="font-sora text-lg text-navy font-bold">₹<%= p.price_inr %></span>
                <span class="btn-brand text-xs py-1 px-2.5">Buy →</span>
              </div>
            </a>
          <% }); %>
          <!-- Browse all card -->
          <a href="/store" class="card p-4 flex-shrink-0 w-44 snap-start flex flex-col items-center justify-center text-center gap-2 border-2 border-dashed border-slate-200 hover:border-brand transition">
            <span class="text-3xl">🏪</span>
            <span class="text-sm font-semibold text-brand">See all products →</span>
          </a>
        </div>
        <!-- Next button -->
        <button id="shopNext" aria-label="Next" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-9 h-9 bg-white dark:bg-slate-700 shadow-md rounded-full flex items-center justify-center text-navy dark:text-white hover:bg-brand hover:text-white transition -mr-4 text-xl leading-none select-none">›</button>
      </div>
      <script>
      (function(){
        var track = document.getElementById('shopTrack');
        var btnPrev = document.getElementById('shopPrev');
        var btnNext = document.getElementById('shopNext');
        if (!track || !btnPrev || !btnNext) return;
        var STEP = 224; /* w-52 (208px) + gap-4 (16px) */
        var timer;
        function slide(dir) {
          var max = track.scrollWidth - track.clientWidth;
          var pos = track.scrollLeft + dir * STEP;
          if (pos > max + 10) pos = 0;
          if (pos < -10) pos = max;
          track.scrollTo({ left: pos, behavior: 'smooth' });
        }
        function startAuto() { timer = setInterval(function(){ slide(1); }, 3200); }
        function stopAuto() { clearInterval(timer); }
        btnNext.addEventListener('click', function(){ stopAuto(); slide(1); startAuto(); });
        btnPrev.addEventListener('click', function(){ stopAuto(); slide(-1); startAuto(); });
        track.addEventListener('mouseenter', stopAuto);
        track.addEventListener('mouseleave', startAuto);
        track.addEventListener('touchstart', stopAuto, { passive: true });
        track.addEventListener('touchend', startAuto, { passive: true });
        startAuto();
      })();
      </script>
    <% } else { %>
      <div class="card p-10 text-center">
        <div class="text-4xl mb-2">🏷️</div>
        <p>New products coming soon. <a class="text-brand font-semibold" href="/store">Browse store</a>.</p>
      </div>
    <% } %>
    <div class="text-center mt-6">
      <a href="/store" class="btn-warn px-10 py-3 text-base">See All SafeTag Products →</a>
    </div>
  </div>
</section>

