<%- include('layout/_head') %>

<!-- ============================================================
  SECTION 1 — HERO: Story-first with crowd background image
  ============================================================ -->
<section class="relative bg-gradient-to-br from-navy via-[#0B1E3D] to-[#091224] text-white overflow-hidden">
  <!-- Background crowd image with dark overlay -->
  <div class="absolute inset-0">
    <img src="/static/images/hero-crowd-scan.png" alt="" class="w-full h-full object-cover object-center opacity-10" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/70 to-transparent"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 pt-6 pb-14 md:pb-20">
    <div class="grid md:grid-cols-2 gap-10 items-center">

      <!-- Left: Narrative hook -->
      <div>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-red-500/20 text-red-300 border border-red-400/20 px-3 py-1 rounded-full mb-5" data-i18n="hero.badge">
          ⚠️ 12,000+ children go missing in India every month
        </span>

        <blockquote class="text-3xl md:text-4xl font-extrabold text-white leading-tight mb-4">
          "14 hours.<br/>No ID. No way<br/>to reach her family."
        </blockquote>

        <p class="text-slate-300 text-base leading-relaxed max-w-md mb-3">
          A 6-year-old went missing at Kumbh Mela. She had no phone, couldn't remember her parents' number, and was too scared to speak. It took fourteen hours to reunite her family.
        </p>
        <p class="text-teal-300 font-semibold text-lg mb-7" data-i18n="hero.tagline">
          SafeTag exists so this never happens again.
        </p>

        <p class="text-slate-300 text-sm leading-relaxed max-w-sm mb-6">
          One QR scan on any phone camera opens a name, blood group, emergency contacts, and a direct call button — in under 3 seconds. No app. No registration. No barrier for the rescuer.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/store" class="btn-warn" data-i18n="hero.cta1">🛒 Protect My Family — from ₹149</a>
          <a href="/demo" class="btn-outline border-white/30 text-white hover:!text-white hover:!border-white" data-i18n="hero.cta2">See Live Demo</a>
        </div>

        <!-- Stats bar -->
        <div class="mt-10 grid grid-cols-3 gap-3 max-w-sm">
          <div>
            <div class="font-sora font-bold text-white text-2xl">12,400+</div>
            <div class="text-xs text-slate-400">Tags Activated</div>
          </div>
          <div>
            <div class="font-sora font-bold text-white text-2xl">182</div>
            <div class="text-xs text-slate-400">Happy Reunions</div>
          </div>
          <div>
            <div class="font-sora font-bold text-white text-2xl">&lt; 3s</div>
            <div class="text-xs text-slate-400">Avg Open Time</div>
          </div>
        </div>
      </div>

      <!-- Right: Emergency card mockup -->
      <div class="hidden md:block">
        <div class="bg-white rounded-cardLg shadow-2xl p-0 overflow-hidden max-w-sm mx-auto light-card">
          <div class="bg-brand text-white px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="/static/images/websiteLogo.png" alt="SafeTag" class="h-6 object-contain bg-white/20 rounded p-0.5" style="max-width:24px;" onerror="this.style.display='none'" />
              <span class="font-semibold text-sm">SafeTag · VERIFIED</span>
            </div>
            <span class="flex items-center gap-1 text-xs"><span class="w-2 h-2 bg-green-300 rounded-full"></span> LIVE</span>
          </div>
          <div class="bg-navy text-white p-4">
            <div class="text-xs opacity-70 mb-1">⚠️ Emergency Identification</div>
            <div class="text-2xl font-bold">Aarav Sharma</div>
            <div class="text-sm flex items-center gap-2 mt-1">
              Age 8
              <span class="pill bg-red-500 text-white text-xs px-2 py-0.5 rounded-full font-bold">O+</span>
              <span class="pill bg-white/10 text-white text-xs">CHILD</span>
            </div>
          </div>
          <div class="p-4 text-sm space-y-2">
            <div>
              <div class="text-xs uppercase font-bold text-slate-400">Allergies</div>
              <div class="flex gap-1 mt-1">
                <span class="pill pill-warning">Peanuts</span>
                <span class="pill pill-warning">Penicillin</span>
              </div>
            </div>
            <div>
              <div class="text-xs uppercase font-bold text-slate-400">Medical</div>
              <div class="text-slate-700">Mild asthma · Salbutamol inhaler</div>
            </div>
          </div>
          <div class="px-4 pb-4">
            <a href="/demo" class="block text-center bg-success text-white font-bold py-3 rounded-card">
              📞 Call Now — +91 98765 43210
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

