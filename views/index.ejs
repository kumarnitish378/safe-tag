          <!-- Identity row -->
          <div style="padding:1rem 1rem .75rem;display:flex;align-items:center;gap:.85rem;">
            <div style="width:62px;height:62px;border-radius:50%;background:#f0fdfa;border:2.5px solid #0D9488;display:flex;align-items:center;justify-content:center;font-size:1.9rem;flex-shrink:0;">👧</div>
            <div>
              <div style="font-size:1.15rem;font-weight:800;color:#0a2342;line-height:1.2;">Aarav Sharma</div>
              <div style="display:flex;gap:.35rem;margin-top:.4rem;flex-wrap:wrap;align-items:center;">
