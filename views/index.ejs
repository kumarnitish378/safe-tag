<%- include('layout/_head') %>

<!-- ============================================================
  SECTION 1 — HERO: Story-first (loss aversion + narrative hook)
  Research: Lead with the fear + story before the product pitch.
  Stories are 22x more memorable than facts. (AIHA / Safe365)
  ============================================================ -->
<section class="bg-gradient-to-br from-navy via-[#0B1E3D] to-[#091224] text-white overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 pt-6 pb-14 md:pb-20">
    <div class="grid md:grid-cols-2 gap-10 items-center">

      <!-- Left: Narrative hook -->
      <div>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-red-500/20 text-red-300 border border-red-400/20 px-3 py-1 rounded-full mb-5" data-i18n="hero.badge">
          ⚠️ 12,000+ children go missing in India every month
        </span>

        <blockquote class="text-3xl md:text-4xl font-extrabold text-white leading-tight mb-4">
          "14 hours.<br/>No ID. No way<br/>to reach her family."
        </blockquote>

        <p class="text-slate-300 text-base leading-relaxed max-w-md mb-3">
          A 6-year-old went missing at Kumbh Mela. She had no phone, couldn't remember her parents' number, and was too scared to speak. It took fourteen hours to reunite her family.
        </p>
        <p class="text-teal-300 font-semibold text-lg mb-7" data-i18n="hero.tagline">
          SafeTag exists so this never happens again.
        </p>

        <p class="text-slate-300 text-sm leading-relaxed max-w-sm mb-6">
          One QR scan on any phone camera opens a name, blood group, emergency contacts, and a direct call button — in under 3 seconds. No app. No registration. No barrier for the rescuer.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/store" class="btn-warn">🛒 Protect My Family — from ₹149</a>
          <a href="/demo" class="btn-outline border-white/30 text-white hover:!text-white hover:!border-white">See Live Demo</a>
        </div>

        <!-- Stats bar -->
        <div class="mt-10 grid grid-cols-3 gap-3 max-w-sm">
          <div>
            <div class="font-sora font-bold text-white text-2xl">12,400+</div>
            <div class="text-xs text-slate-400">Tags Activated</div>
          </div>
          <div>
            <div class="font-sora font-bold text-white text-2xl">182</div>
            <div class="text-xs text-slate-400">Happy Reunions</div>
          </div>
          <div>
            <div class="font-sora font-bold text-white text-2xl">&lt; 3s</div>
            <div class="text-xs text-slate-400">Avg Open Time</div>
          </div>
        </div>
      </div>

      <!-- Right: Emergency card mockup -->
      <div class="hidden md:block">
        <div class="bg-white rounded-cardLg shadow-2xl p-0 overflow-hidden max-w-sm mx-auto">
          <div class="bg-brand text-white px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="/static/images/websiteLogo.png" alt="SafeTag" class="h-6 object-contain bg-white/20 rounded p-0.5" style="max-width:24px;" onerror="this.style.display='none'" />
              <span class="font-semibold text-sm">SafeTag · VERIFIED</span>
            </div>
            <span class="flex items-center gap-1 text-xs"><span class="w-2 h-2 bg-green-300 rounded-full"></span> LIVE</span>
          </div>
          <div class="bg-navy text-white p-4">
            <div class="text-xs opacity-70 mb-1">⚠️ Emergency Identification</div>
            <div class="text-2xl font-bold">Aarav Sharma</div>
            <div class="text-sm flex items-center gap-2 mt-1">
              Age 8
              <span class="pill bg-red-500 text-white text-xs px-2 py-0.5 rounded-full font-bold">O+</span>
              <span class="pill bg-white/10 text-white text-xs">CHILD</span>
            </div>
          </div>
          <div class="p-4 text-sm space-y-2">
            <div>
              <div class="text-xs uppercase font-bold text-slate-400">Allergies</div>
              <div class="flex gap-1 mt-1">
                <span class="pill pill-warning">Peanuts</span>
                <span class="pill pill-warning">Penicillin</span>
              </div>
            </div>
            <div>
              <div class="text-xs uppercase font-bold text-slate-400">Medical</div>
              <div class="text-slate-700">Mild asthma · Salbutamol inhaler</div>
            </div>
          </div>
          <div class="px-4 pb-4">
            <a href="/demo" class="block text-center bg-success text-white font-bold py-3 rounded-card">
              📞 Call Now — +91 98765 43210
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================
  SECTION 2 — TRUST BAR: Immediate credibility signals
  ============================================================ -->
<section class="bg-white border-y border-slate-100">
  <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap items-center justify-center gap-6 text-sm font-semibold text-slate-600">
    <span>🇮🇳 Made in India</span>
    <span class="text-slate-300">|</span>
    <span>📱 No app required</span>
    <span class="text-slate-300">|</span>
    <span>🔒 Data never shared</span>
    <span class="text-slate-300">|</span>
    <span>⚡ Opens in under 3 seconds</span>
    <span class="text-slate-300">|</span>
    <span>🌐 Works on any phone camera</span>
  </div>
</section>

<!-- ============================================================
  SECTION 3 — STORE PREVIEW (moved up — friction reduction: show product early)
  ============================================================ -->
<section class="section bg-white" id="shop">
  <div class="section-inner">
    <div class="flex items-end justify-between mb-6">
      <div>
        <h2 class="text-3xl font-bold" data-i18n="section.shop">Shop SafeTags</h2>
        <p class="text-slate-500 mt-1" data-i18n="section.shop.sub">Starts at ₹149. Ships across India.</p>
      </div>
      <a href="/store" class="text-brand font-semibold hover:underline">See all →</a>
    </div>
    <% if (featured && featured.length) { %>
      <div class="grid md:grid-cols-3 gap-5">
        <% featured.forEach(function(p){ %>
          <a href="/store/<%= p.id %>" class="card p-5 hover:-translate-y-1 transition-transform block">
            <div class="w-full h-40 bg-slate-100 rounded-card mb-4 flex items-center justify-center overflow-hidden">
              <% if (p.photo_url) { %>
                <img src="<%= p.photo_url %>" class="w-full h-40 object-cover rounded-card" alt="<%= p.name %>" />
              <% } else { %>
                <span class="text-5xl">🏷️</span>
              <% } %>
            </div>
            <div class="capitalize text-xs text-slate-500 mb-1"><%= p.category %></div>
            <h3 class="font-semibold mb-1 text-navy"><%= p.name %></h3>
            <div class="mt-2 flex items-center justify-between">
              <span class="font-sora text-xl text-navy font-bold">₹<%= p.price_inr %></span>
              <span class="btn-brand text-sm py-1.5 px-3">Buy →</span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card p-10 text-center">
        <div class="text-4xl mb-2">🏷️</div>
        <p>New products coming soon. <a class="text-brand font-semibold" href="/store">Browse store</a>.</p>
      </div>
    <% } %>
    <div class="text-center mt-8">
      <a href="/store" class="btn-warn px-10 py-3 text-base">See All SafeTag Products →</a>
    </div>
  </div>
</section>

<!-- ============================================================
  SECTION 4 — HOW IT WORKS: Confidence through clarity
  ============================================================ -->
<section id="how" class="section">
  <div class="section-inner">
    <h2 class="text-3xl font-bold text-center mb-2" data-i18n="section.how">How SafeTag Works</h2>
    <p class="text-center text-slate-500 mb-10 max-w-xl mx-auto" data-i18n="section.how.sub">From order to life-saving — 4 steps. No app on either side. Works on any Android or iPhone camera.</p>
    <div class="grid md:grid-cols-4 gap-5">
      <%
        var steps = [
          { e:'🛒', t:'Buy & Attach', d:'Order a SafeTag keychain, card, sticker or wristband. Attach it to a bag, lanyard, collar, or ID badge.', step:1 },
          { e:'📝', t:'Set Up Profile', d:'Scan the QR code on your tag, fill in name, blood group, emergency contacts, and medical info. Takes 2 minutes.', step:2 },
          { e:'📷', t:'Stranger Scans', d:'In an emergency, anyone scans the QR with their phone camera — like a normal QR. No app download needed.', step:3 },
          { e:'📞', t:'Instant Contact', d:'The emergency profile opens in under 3 seconds. They call directly. Your WhatsApp gets the location alert.', step:4 },
        ];
        steps.forEach(function(s){ %>
        <div class="card p-5">
          <div class="text-3xl mb-3"><%= s.e %></div>
          <div class="text-xs font-bold text-brand mb-1 uppercase">Step <%= s.step %></div>
          <h3 class="font-semibold mb-2 text-navy"><%= s.t %></h3>
          <p class="text-sm leading-relaxed text-slate-600"><%= s.d %></p>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-8">
      <a href="/demo" class="btn-brand">See the Emergency Page Live →</a>
    </div>
  </div>
</section>

