<%- include('layout/_head') %>

<!-- ============================================================
  HERO — Liquid animated background + glass stats
  ============================================================ -->
<section class="relative overflow-hidden lq-mesh" style="background:linear-gradient(135deg,#0A2342 0%,#0B1E3D 55%,#091224 100%);min-height:92vh;display:flex;align-items:center;">

  <!-- Animated blobs -->
  <div class="lq-blob" style="width:520px;height:520px;background:#0D9488;top:-120px;left:-100px;opacity:.22;"></div>
  <div class="lq-blob lq-blob-b" style="width:380px;height:380px;background:#5eead4;top:40%;right:-80px;opacity:.14;"></div>
  <div class="lq-blob lq-blob-c" style="width:280px;height:280px;background:#0D9488;bottom:-60px;left:35%;opacity:.18;"></div>

  <!-- Cursor glow -->
  <div class="cursor-glow"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 w-full">
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- LEFT: Story + CTAs -->
      <div>
        <span class="reveal inline-flex items-center gap-1.5 text-sm font-semibold badge-pulse rounded-full mb-5 px-4 py-1.5"
              style="background:rgba(239,68,68,0.18);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);"
              data-i18n="hero.badge">
          ⚠️ 12,000+ children go missing in India every month
        </span>

        <h1 class="reveal d1 text-xl font-bold mb-2 tracking-wide" style="color:#5eead4;">India's QR + NFC Emergency ID Tag</h1>

        <blockquote class="reveal d2 text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mb-4" style="color:#fff;">
          "14 hours.<br/>No ID. No way<br/>to reach her family."
        </blockquote>

        <p class="reveal d3 text-lg leading-relaxed mb-3" style="color:#cbd5e1;">
          A 6-year-old went missing at Kumbh Mela. No phone, no voice, fourteen hours of terror before her family found her. One small tag would have ended it in 7 minutes.
        </p>
        <p class="reveal d3 font-semibold text-xl mb-5" style="color:#5eead4;" data-i18n="hero.tagline">
          SafeTag exists so this never happens to your family.
        </p>

        <p class="reveal d4 text-base leading-relaxed mb-3" style="color:#cbd5e1;">
          Every SafeTag has <strong style="color:#fff;">two ways to save a life</strong>: a QR code any camera can scan, and a built-in NFC chip that works even if the QR is scratched.
        </p>

        <div class="reveal d4 flex items-center gap-3 mb-7 flex-wrap">
          <span class="glass px-3 py-1.5 text-sm font-semibold" style="color:#5eead4;">📷 QR Scan</span>
          <span style="color:#475569;">+</span>
          <span class="glass px-3 py-1.5 text-sm font-semibold" style="color:#5eead4;">📡 NFC Tap</span>
          <span style="color:#475569;">=</span>
          <span class="glass px-3 py-1.5 text-sm font-bold" style="color:#fff;border-color:rgba(13,148,136,0.4);">Dual Protection</span>
        </div>

        <div class="reveal d5 flex flex-wrap gap-3">
          <a href="/store" class="btn-lq btn-warn text-base px-7 py-3" data-i18n="hero.cta1">🛒 Protect My Family — from ₹149</a>
          <a href="/demo" class="btn-lq glass px-6 py-3 text-base font-semibold" style="color:#fff;" data-i18n="hero.cta2">See Live Demo</a>
        </div>

        <!-- Stats row -->
        <div class="reveal d5 mt-8 grid grid-cols-3 gap-4 pt-6" style="border-top:1px solid rgba(255,255,255,0.1);">
          <div class="glass p-4 text-center rounded-xl">
            <div class="font-sora font-bold text-3xl stat-num" style="color:#fff;" data-count="12400" data-suffix="+">0</div>
            <div class="text-xs mt-1" style="color:#94a3b8;">Tags Activated</div>
          </div>
          <div class="glass p-4 text-center rounded-xl">
            <div class="font-sora font-bold text-3xl stat-num" style="color:#5eead4;" data-count="182">0</div>
            <div class="text-xs mt-1" style="color:#94a3b8;">Happy Reunions</div>
          </div>
          <div class="glass p-4 text-center rounded-xl">
            <div class="font-sora font-bold text-3xl stat-num" style="color:#fff;">< 3s</div>
            <div class="text-xs mt-1" style="color:#94a3b8;">Avg Open Time</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Emergency profile mockup -->
      <div class="hidden md:flex flex-col items-center gap-5">
        <div class="lq-float-slow w-full max-w-xs">
          <!-- Outer glow ring -->
          <div class="grad-border rounded-2xl">
            <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
              <!-- Alert strip -->
              <div style="background:#dc2626;color:#fff;padding:.5rem 1rem;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;display:flex;align-items:center;gap:.4rem;">
                <span>⚠️</span> Emergency Profile — SafeTag
              </div>
              <!-- Identity -->
              <div style="padding:1rem 1rem .75rem;display:flex;align-items:center;gap:.85rem;">
                <div class="pulse-ring-wrap" style="width:62px;height:62px;flex-shrink:0;">
                  <div class="lq-pulse"></div>
                  <div class="lq-pulse p2"></div>
                  <div style="width:62px;height:62px;border-radius:50%;background:#f0fdfa;border:2.5px solid #0D9488;display:flex;align-items:center;justify-content:center;font-size:1.9rem;position:relative;z-index:1;">👧</div>
                </div>
                <div>
                  <div style="font-size:1.15rem;font-weight:800;color:#0a2342;line-height:1.2;">Aarav Sharma</div>
                  <div style="display:flex;gap:.35rem;margin-top:.4rem;flex-wrap:wrap;align-items:center;">
                    <span style="background:#dc2626;color:#fff;border-radius:99px;padding:.15rem .65rem;font-size:.82rem;font-weight:900;font-family:monospace;">O+</span>
                    <span style="background:#f0fdfa;color:#0f766e;border-radius:99px;padding:.15rem .6rem;font-size:.72rem;font-weight:600;">Age 8</span>
                    <span style="background:#f0fdfa;color:#0f766e;border-radius:99px;padding:.15rem .6rem;font-size:.72rem;font-weight:600;">Child</span>
                  </div>
                  <div style="font-size:.8rem;color:#64748b;margin-top:.3rem;">👨‍👩‍👧 Parent: Priya Sharma</div>
                </div>
              </div>
              <!-- Allergy -->
              <div style="margin:0 1rem;background:#fef3c7;border:1px solid #fbbf24;border-radius:8px;padding:.45rem .75rem;font-size:.75rem;color:#92400e;font-weight:600;">
                ⚠️ Allergies: Peanuts, Penicillin
              </div>
              <!-- Buttons -->
              <div style="padding:.75rem 1rem 1rem;display:flex;flex-direction:column;gap:.45rem;">
                <div style="background:#16a34a;color:#fff;border-radius:10px;padding:.7rem;text-align:center;font-weight:700;font-size:.92rem;">📞 Call Emergency Contact</div>
                <div style="background:#25D366;color:#fff;border-radius:10px;padding:.6rem;text-align:center;font-weight:600;font-size:.85rem;">💬 Send Location via WhatsApp</div>
              </div>
            </div>
          </div>
        </div>
        <div class="text-center">
          <div class="text-sm mb-2" style="color:#94a3b8;">↑ What a rescuer sees after scanning</div>
          <div class="flex justify-center gap-2 flex-wrap">
            <span class="glass text-xs px-3 py-1 font-semibold rounded-full" style="color:#5eead4;">📷 Any phone camera</span>
            <span class="glass text-xs px-3 py-1 font-semibold rounded-full" style="color:#5eead4;">📡 NFC tap also works</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

