<!-- ============================================================
  SECTION 9 — FAQ: Objection handling
  ============================================================ -->
<section id="faq" class="section">
  <div class="section-inner max-w-3xl">
    <h2 class="text-3xl font-bold text-center mb-8" data-i18n="section.faq">Frequently Asked Questions</h2>
    <div class="space-y-3">
      <%
        var faqs = [
          { q:'Do I need an app to scan a SafeTag?',
            a:'No. Any modern phone camera opens the SafeTag URL like a standard QR code. NFC-equipped phones can also tap the chip. The rescuer needs zero setup.' },
          { q:'Can I update the information after buying?',
            a:'Yes. Sign in to your dashboard and update the profile at any time. Changes go live instantly — no need to replace the tag.' },
          { q:'Is my personal information private?',
            a:'Your data is only shown when someone physically scans your tag — it cannot be listed or searched online. We never share data with third parties.' },
          { q:'What if the QR code gets scratched?',
            a:'Every SafeTag also carries an RFID/NFC chip. Either method opens the same emergency profile.' },
          { q:'Can I use it for my pet?',
            a:'Yes. Select "PET" as the category and fill in your own details as the emergency contact. Any finder can scan and reach you immediately.' },
          { q:'Do you do bulk orders for schools or hospitals?',
            a:'Yes. Contact us via the manufacturer portal. Batches of up to 10,000 tags can be created at once with CSV output for RFID programming and QR printing.' },
        ];
        faqs.forEach(function(f){ %>
        <details class="card p-5 cursor-pointer group">
          <summary class="font-semibold text-navy list-none flex items-center justify-between">
            <%= f.q %>
            <span class="text-brand text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600"><%= f.a %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

