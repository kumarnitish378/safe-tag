<!-- ============================================================
  SECTION 3 — STORE PREVIEW (moved up — friction reduction)
  ============================================================ -->
<section class="section bg-white" id="shop">
  <div class="section-inner">
    <div class="flex items-end justify-between mb-6">
      <div>
        <h2 class="text-3xl font-bold" data-i18n="section.shop">Shop SafeTags</h2>
        <p class="text-slate-500 mt-1" data-i18n="section.shop.sub">Starts at ₹149. Ships across India.</p>
      </div>
      <a href="/store" class="text-brand font-semibold hover:underline">See all →</a>
    </div>
    <% if (featured && featured.length) { %>
      <div class="grid md:grid-cols-3 gap-5">
        <% featured.forEach(function(p){ %>
          <a href="/store/<%= p.id %>" class="card p-5 hover:-translate-y-1 transition-transform block">
            <div class="w-full h-40 bg-slate-100 rounded-card mb-4 flex items-center justify-center overflow-hidden">
              <% if (p.photo_url) { %>
                <img src="<%= p.photo_url %>" class="w-full h-40 object-cover rounded-card" alt="<%= p.name %>" />
              <% } else { %>
                <span class="text-5xl">🏷️</span>
              <% } %>
            </div>
            <div class="capitalize text-xs text-slate-500 mb-1"><%= p.category %></div>
            <h3 class="font-semibold mb-1 text-navy"><%= p.name %></h3>
            <div class="mt-2 flex items-center justify-between">
              <span class="font-sora text-xl text-navy font-bold">₹<%= p.price_inr %></span>
              <span class="btn-brand text-sm py-1.5 px-3">Buy →</span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card p-10 text-center">
        <div class="text-4xl mb-2">🏷️</div>
        <p>New products coming soon. <a class="text-brand font-semibold" href="/store">Browse store</a>.</p>
      </div>
    <% } %>
    <div class="text-center mt-8">
      <a href="/store" class="btn-warn px-10 py-3 text-base">See All SafeTag Products →</a>
    </div>
  </div>
</section>

<!-- ============================================================
  SECTION 4 — HOW IT WORKS: SVG step icons + clarity
  ============================================================ -->
<section id="how" class="section">
  <div class="section-inner">
    <h2 class="text-3xl font-bold text-center mb-2" data-i18n="section.how">How SafeTag Works</h2>
    <p class="text-center text-slate-500 mb-10 max-w-xl mx-auto" data-i18n="section.how.sub">From order to life-saving — 4 steps. No app on either side. Works on any Android or iPhone camera.</p>
    <div class="grid md:grid-cols-4 gap-5">

      <!-- Step 1: Buy & Attach -->
      <div class="card p-5">
        <div class="mb-3 w-12 h-12">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="18" width="32" height="26" rx="4" fill="#ccfbf1" stroke="#0D9488" stroke-width="2"/>
            <path d="M17 18v-4a7 7 0 0 1 14 0v4" stroke="#0D9488" stroke-width="2" stroke-linecap="round"/>
            <rect x="16" y="26" width="5" height="5" rx="1" fill="#0A2342"/>
            <rect x="27" y="26" width="5" height="5" rx="1" fill="#0A2342"/>
            <rect x="16" y="35" width="5" height="5" rx="1" fill="#0A2342"/>
            <rect x="27" y="35" width="2" height="2" fill="#0A2342"/>
            <rect x="30" y="35" width="2" height="2" fill="#0A2342"/>
            <rect x="27" y="38" width="2" height="2" fill="#0A2342"/>
            <rect x="30" y="38" width="2" height="2" fill="#0A2342"/>
          </svg>
        </div>
        <div class="text-xs font-bold text-brand mb-1 uppercase">Step 1</div>
        <h3 class="font-semibold mb-2 text-navy">Buy &amp; Attach</h3>
        <p class="text-sm leading-relaxed text-slate-600">Order a SafeTag keychain, card, sticker or wristband. Attach it to a bag, lanyard, collar, or ID badge.</p>
      </div>

      <!-- Step 2: Set Up Profile -->
      <div class="card p-5">
        <div class="mb-3 w-12 h-12">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="28" height="34" rx="4" fill="#ccfbf1" stroke="#0D9488" stroke-width="2"/>
            <rect x="18" y="6" width="12" height="8" rx="4" fill="#0D9488"/>
            <line x1="16" y1="24" x2="32" y2="24" stroke="#0A2342" stroke-width="2" stroke-linecap="round"/>
            <line x1="16" y1="30" x2="28" y2="30" stroke="#0A2342" stroke-width="2" stroke-linecap="round"/>
            <circle cx="33" cy="36" r="6" fill="#0D9488"/>
            <path d="M30.5 36l2 2 4-4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="text-xs font-bold text-brand mb-1 uppercase">Step 2</div>
        <h3 class="font-semibold mb-2 text-navy">Set Up Profile</h3>
        <p class="text-sm leading-relaxed text-slate-600">Scan the QR on your tag, fill in name, blood group, emergency contacts, and medical info. Takes 2 minutes.</p>
      </div>

      <!-- Step 3: Stranger Scans -->
      <div class="card p-5">
        <div class="mb-3 w-12 h-12">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="15" y="5" width="18" height="32" rx="4" fill="#ccfbf1" stroke="#0D9488" stroke-width="2"/>
            <rect x="19" y="12" width="10" height="10" rx="1.5" fill="#0A2342"/>
            <circle cx="24" cy="31" r="2" fill="#0D9488"/>
            <path d="M7 14v-5h5" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M7 28v5h5" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M41 14v-5h-5" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M41 28v5h-5" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="text-xs font-bold text-brand mb-1 uppercase">Step 3</div>
        <h3 class="font-semibold mb-2 text-navy">Stranger Scans</h3>
        <p class="text-sm leading-relaxed text-slate-600">In an emergency, anyone scans the QR with their phone camera — like a normal QR. No app download needed.</p>
      </div>

      <!-- Step 4: Instant Contact -->
      <div class="card p-5">
        <div class="mb-3 w-12 h-12">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="19" fill="#ccfbf1" stroke="#0D9488" stroke-width="2"/>
            <path d="M17 16c0 0 1.5 2 1.5 6S17 28 17 28l3.5 3.5c0 0 2-1.5 6-1.5s5.5 1.5 5.5 1.5L34 30c0 0-3.5-3-3.5-7V17L17 16z" fill="#0D9488"/>
