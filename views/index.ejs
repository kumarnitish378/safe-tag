          <div>
            <div class="font-sora font-bold text-white text-3xl">12,400+</div>
            <div class="text-sm text-slate-400 mt-0.5">Tags Activated</div>
          </div>
          <div>
            <div class="font-sora font-bold text-white text-3xl">182</div>
            <div class="text-sm text-slate-400 mt-0.5">Happy Reunions</div>
          </div>
          <div>
            <div class="font-sora font-bold text-white text-3xl">&lt; 3s</div>
            <div class="text-sm text-slate-400 mt-0.5">Avg Open Time</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Emergency profile mockup (desktop only) -->
