<script>
  // Scroll reveal
  (function(){
    var els = document.querySelectorAll('.rv');
    if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return;}
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
    els.forEach(function(e){io.observe(e)});
  })();

  // Hero image slider — auto-advance + arrows + dots + swipe, pauses on hover.
  // Static slides only (no external fetch).
  (function(){
    var slider = document.getElementById('heroSlider');
    if(!slider) return;
    var track = slider.querySelector('.hero-track');
    var dotsWrap = slider.querySelector('.hero-dots');
    var reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    var slides = [], dots = [], n = 0, i = 0, timer = null;

    function go(idx){
      if(!n) return;
      i = (idx + n) % n;
      track.style.transform = 'translateX(-' + (i * 100) + '%)';
      dots.forEach(function(d, k){ d.classList.toggle('active', k === i); });
    }
    function next(){ go(i + 1); }
    function prev(){ go(i - 1); }
    function start(){ if(!reduce && !timer && n > 1){ timer = setInterval(next, 4500); } }
    function stop(){ if(timer){ clearInterval(timer); timer = null; } }
    function restart(){ stop(); start(); }

    function setup(){
      slides = [].slice.call(track.querySelectorAll('.hero-slide'));
      n = slides.length;
      slider.classList.toggle('single', n < 2);
      dotsWrap.innerHTML = '';
      slides.forEach(function(_, idx){
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', 'Go to image ' + (idx + 1));
        b.addEventListener('click', function(){ go(idx); restart(); });
        dotsWrap.appendChild(b);
      });
      dots = [].slice.call(dotsWrap.children);
      i = 0; go(0); restart();
    }

    slider.querySelector('.next').addEventListener('click', function(){ next(); restart(); });
    slider.querySelector('.prev').addEventListener('click', function(){ prev(); restart(); });
    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', start);
    var x0 = null;
    slider.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; stop(); }, {passive:true});
    slider.addEventListener('touchend', function(e){
      if(x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if(Math.abs(dx) > 40){ dx < 0 ? next() : prev(); }
      x0 = null; start();
    }, {passive:true});

    setup();
  })();
</script>

