    </div>
    <div class="grid md:grid-cols-4 gap-5">
      <% [
        { step:'01', icon:'🛒', title:'Buy & Attach', body:'Order a SafeTag keychain, card, sticker or wristband. Attach it to a bag, lanyard, collar, or ID badge.' },
        { step:'02', icon:'✏️', title:'Set Up Profile', body:'Scan the QR on your tag, fill in name, blood group, emergency contacts, and medical info. Takes 2 minutes.' },
        { step:'03', icon:'📷', title:'Scan QR or Tap NFC', body:'Anyone scans the QR with their camera — or taps the NFC chip. Either opens the emergency profile instantly. No app ever.' },
        { step:'04', icon:'📞', title:'Instant Contact', body:'The emergency profile opens in under 3 seconds. They call directly. Your WhatsApp gets the location alert.' },
      ].forEach(function(s, i){ %>
        <div class="reveal glass-light p-6 rounded-2xl d<%= i+1 %>" style="border-top:3px solid #0D9488;">
          <div class="text-xs font-bold mb-3" style="color:#0D9488;letter-spacing:.08em;">STEP <%= s.step %></div>
          <div class="text-3xl mb-3"><%= s.icon %></div>
          <h3 class="font-semibold mb-2 text-navy text-lg"><%= s.title %></h3>
          <p class="text-base leading-relaxed text-slate-600"><%= s.body %></p>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-8">
      <a href="/demo" class="btn-lq btn-brand px-8 py-3">See the Emergency Page Live →</a>
    </div>
  </div>
</section>

