<%- include('layout/_head') %>

<section class="section">
  <div class="section-inner max-w-md">
    <div class="flex items-center gap-3 mb-4">
      <span class="pill pill-mono"><%= tag_id %></span>
      <a href="/dashboard" class="text-sm text-brand font-semibold">← Back to dashboard</a>
    </div>
    <h1 class="text-2xl font-bold mb-4">Edit emergency profile</h1>

    <% if (errors._form) { %><div class="flash flash-error">⚠️ <%= errors._form %></div><% } %>

    <form method="POST" action="/profile/edit/<%= tag_id %>" class="space-y-5">
      <%- include('layout/_csrf') %>
      <div class="card p-5 space-y-4">
        <div><label class="label">Full Name</label><input class="input" name="name" required value="<%= profile.name||'' %>" /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label">Age</label><input class="input" type="number" name="age" min="1" max="120" value="<%= profile.age||'' %>" /></div>
          <div>
            <label class="label">Blood Group</label>
            <select class="input" name="blood_group">
              <option value="">—</option>
              <% ['A+','A-','B+','B-','O+','O-','AB+','AB-','Unknown'].forEach(function(b){ %><option <%= profile.blood_group===b?'selected':'' %>><%= b %></option><% }); %>
            </select>
          </div>
        </div>
        <div><label class="label">Parent / Guardian</label><input class="input" name="parent_name" value="<%= profile.parent_name||'' %>" /></div>
        <div>
          <label class="label">Category</label>
          <select class="input" name="category">
            <option value="">—</option>
            <% ['ADULT','CHILD','ELDERLY','TRAVELER','PET'].forEach(function(c){ %><option <%= profile.category===c?'selected':'' %>><%= c %></option><% }); %>
          </select>
        </div>
      </div>

      <div class="card p-5 space-y-4">
        <div><label class="label">Primary Mobile (10-digit)</label><input class="input" name="mobile_primary" value="<%= profile.mobile_primary||'' %>" /></div>
        <div><label class="label">Secondary Mobile</label><input class="input" name="mobile_secondary" value="<%= profile.mobile_secondary||'' %>" /></div>
        <div><label class="label">Owner WhatsApp</label><input class="input" name="owner_whatsapp" value="<%= profile.owner_whatsapp||'' %>" /></div>
        <div><label class="label">Email</label><input class="input" type="email" name="email" value="<%= profile.email||'' %>" /></div>
        <div><label class="label">Address</label><textarea class="input" name="address" rows="3"><%= profile.address||'' %></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label">Lat</label><input class="input mono text-sm" name="latitude" value="<%= profile.latitude||'' %>" /></div>
          <div><label class="label">Lng</label><input class="input mono text-sm" name="longitude" value="<%= profile.longitude||'' %>" /></div>
        </div>
      </div>

      <div class="card p-5 space-y-4">
        <div><label class="label">Allergies</label><textarea class="input" name="allergies" rows="2"><%= profile.allergies||'' %></textarea></div>
        <div><label class="label">Medical Conditions</label><textarea class="input" name="medical_conditions" rows="2"><%= profile.medical_conditions||'' %></textarea></div>
        <div><label class="label">Medications</label><textarea class="input" name="medications" rows="2"><%= profile.medications||'' %></textarea></div>
        <div><label class="label">Note to Rescuer</label><textarea class="input" name="custom_message" rows="2"><%= profile.custom_message||'' %></textarea></div>
      </div>

      <div class="flex gap-2">
        <button class="btn-brand flex-1 justify-center">Save changes</button>
        <a href="/emergency/<%= tag_id %>" target="_blank" class="btn-outline">Preview</a>
      </div>
    </form>
  </div>
</section>

<%- include('layout/_foot') %>
