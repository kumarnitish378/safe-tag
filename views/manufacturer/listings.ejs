<%- include('../layout/_head') %>

<section class="page-shell">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-6 reveal">
      <div>
        <span class="eyebrow">Store</span>
        <h1 class="text-3xl font-bold mt-2">My product listings</h1>
      </div>
      <a class="btn" style="padding:.6rem 1.25rem;font-size:.9rem;box-shadow:none" href="/manufacturer/listings/new">
        <span class="material-symbols-outlined" style="color:#fff;font-size:1.15em">add</span>New Listing
      </a>
    </div>

    <% if (!listings.length) { %>
      <div class="empty-state reveal"><p>No listings yet. <a class="font-semibold" style="color:var(--teal-d)" href="/manufacturer/listings/new">Create one</a>.</p></div>
    <% } else { %>
      <div class="grid md:grid-cols-2 gap-4">
        <% listings.forEach(function(l, i){ %>
          <div class="p-5 reveal d<%= (i%5)+1 %>" style="background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm)">
            <div class="flex justify-between items-start gap-2 mb-2">
              <h3 class="font-semibold" style="color:var(--navy)"><%= l.name %></h3>
              <% if (l.is_rejected) { %><span class="pill pill-danger">Rejected</span>
              <% } else if (l.is_approved) { %><span class="pill pill-success">Live</span>
              <% } else { %><span class="pill pill-warning">Pending</span><% } %>
            </div>
            <div class="text-xs capitalize" style="color:var(--muted)"><%= l.category %></div>
            <p class="text-sm mt-2 line-clamp-2" style="color:var(--muted)"><%= (l.description||'').slice(0,140) %></p>
            <div class="flex items-center justify-between mt-3">
              <span class="font-bold" style="color:var(--navy)">₹<%= l.price_inr %></span>
              <span class="text-xs" style="color:var(--muted)">Stock <%= l.quantity_available %></span>
            </div>
            <form method="POST" action="/manufacturer/listings/<%= l.id %>/delete" class="mt-3" onsubmit="return confirm('Delete this listing?')">
      <%- include('../layout/_csrf') %>
              <button class="btn-ghost" style="padding:.5rem 1rem;font-size:.85rem">Delete</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
</section>

<%- include('../layout/_foot') %>
