<%- include('../layout/_head') %>

<section class="section">
  <div class="section-inner">
    <div class="flex items-center justify-between mb-6 reveal">
      <h1 class="text-3xl font-bold">My product listings</h1>
      <a class="btn-brand btn-lq text-sm" href="/manufacturer/listings/new">+ New Listing</a>
    </div>

    <% if (!listings.length) { %>
      <div class="glass-light p-10 text-center reveal"><p>No listings yet. <a class="text-brand font-semibold" href="/manufacturer/listings/new">Create one</a>.</p></div>
    <% } else { %>
      <div class="grid md:grid-cols-2 gap-4">
        <% listings.forEach(function(l, i){ %>
          <div class="glass-light p-5 reveal d<%= (i%5)+1 %>">
            <div class="flex justify-between mb-2"><h3 class="font-semibold"><%= l.name %></h3>
              <% if (l.is_rejected) { %><span class="pill pill-danger">Rejected</span>
              <% } else if (l.is_approved) { %><span class="pill pill-success">Live</span>
              <% } else { %><span class="pill pill-warning">Pending</span><% } %>
            </div>
            <div class="text-xs capitalize text-slate-500"><%= l.category %></div>
            <p class="text-sm mt-2 line-clamp-2"><%= (l.description||'').slice(0,140) %></p>
            <div class="flex items-center justify-between mt-3">
              <span class="font-bold text-navy">₹<%= l.price_inr %></span>
              <span class="text-xs text-slate-500">Stock <%= l.quantity_available %></span>
            </div>
            <form method="POST" action="/manufacturer/listings/<%= l.id %>/delete" class="mt-3" onsubmit="return confirm('Delete this listing?')">
      <%- include('../layout/_csrf') %>
              <button class="btn-outline btn-lq text-sm">Delete</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../layout/_foot') %>
