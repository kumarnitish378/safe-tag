<%- include('../layout/_head') %>

<section class="section">
  <div class="section-inner max-w-md">
    <div class="glass-light p-6 reveal">
      <h1 class="text-2xl font-bold mb-1">Manufacturer sign in</h1>
      <p class="text-sm text-slate-500 mb-5">Sign in to manage your batches and product listings.</p>

      <% if (errors._form) { %><div class="flash flash-error">⚠️ <%= errors._form %></div><% } %>

      <form method="POST" action="/manufacturer/login" class="space-y-4">
      <%- include('../layout/_csrf') %>
        <div><label class="label">Email</label><input class="input" type="email" name="email" required value="<%= values.email||'' %>" /></div>
        <div><label class="label">Password</label><input class="input" type="password" name="password" required /></div>
        <button class="btn-brand btn-lq w-full justify-center">Sign in</button>
      </form>
      <p class="text-sm text-slate-500 mt-4 text-center">New here? <a class="text-brand font-semibold" href="/manufacturer/register">Register your workshop</a>.</p>
    </div>
  </div>
</section>

<%- include('../layout/_foot') %>
