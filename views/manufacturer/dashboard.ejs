<%- include('../layout/_head') %>

<section class="page-shell">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-6 reveal">
      <div>
        <h1 class="text-3xl font-bold"><%= manufacturer.business_name %></h1>
        <p class="text-sm text-slate-500"><%= manufacturer.email %> · <%= manufacturer.mobile %></p>
      </div>
      <div class="flex gap-2">
        <a class="btn-outline btn-lq text-sm" href="/manufacturer/orders">Orders</a>
        <a class="btn-outline btn-lq text-sm" href="/manufacturer/listings">My Listings</a>
        <a class="btn-brand btn-lq text-sm" href="/manufacturer/batch/new">+ New Batch</a>
      </div>
    </div>

    <% if (!manufacturer.is_approved) { %>
      <div class="glass-light p-5 mb-4 border border-blue-200 bg-blue-50 flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="flex-1">
          <p class="font-semibold text-navy">Your account is pending admin approval.</p>
          <p class="text-sm text-slate-500 mt-1">You can prepare batches and listings now, but they won't go live until SafeTag admin approves you. Click the button to send a request.</p>
        </div>
        <form method="POST" action="/manufacturer/request-approval" class="shrink-0">
          <%- include('../layout/_csrf') %>
          <button class="btn-brand btn-lq text-sm whitespace-nowrap">📧 Request Approval</button>
        </form>
      </div>
    <% } %>

    <% var totalTags = (batches||[]).reduce(function(a,b){ return a+b.quantity; },0);
       var totalActive = (batches||[]).reduce(function(a,b){ return a+b.activated_count; },0);
       var rate = totalTags ? Math.round(totalActive*1000/totalTags)/10 : 0;
    %>

    <div class="grid sm:grid-cols-3 gap-3 mb-6">
      <div class="glass-light metric-card reveal d1"><div class="metric-label">Total tags produced</div><div class="text-3xl font-sora font-bold text-navy" data-count="<%= totalTags %>"><%= totalTags %></div></div>
      <div class="glass-light metric-card reveal d2"><div class="metric-label">Activated</div><div class="text-3xl font-sora font-bold text-success" data-count="<%= totalActive %>"><%= totalActive %></div><div class="text-xs"><%= rate %>%</div></div>
      <div class="glass-light metric-card reveal d3"><div class="metric-label">Listings</div><div class="text-3xl font-sora font-bold text-navy" data-count="<%= listings.length %>"><%= listings.length %></div></div>
    </div>

    <h2 class="text-xl font-bold mb-3">Batches</h2>
    <% if (!batches.length) { %>
      <div class="empty-state reveal">No batches yet. <a class="text-brand font-semibold" href="/manufacturer/batch/new">Create your first batch</a>.</div>
    <% } else { %>
      <div class="glass-light data-panel table-wrap mb-8 reveal">
        <table class="table">
          <thead><tr><th>#</th><th>Batch name</th><th>Quantity</th><th>Activated</th><th>Rate</th><th></th></tr></thead>
          <tbody>
            <% batches.forEach(function(b){ %>
              <tr>
                <td class="mono">#<%= b.id %></td>
                <td><%= b.batch_name %></td>
                <td><%= b.quantity %></td>
                <td><%= b.activated_count %></td>
                <td><%= b.activation_rate %>%</td>
                <td><a class="text-brand font-semibold" href="/manufacturer/batch/<%= b.id %>">Open →</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <h2 class="text-xl font-bold mb-3">My listings</h2>
    <% if (!listings.length) { %>
      <div class="empty-state reveal">No listings yet. <a class="text-brand font-semibold" href="/manufacturer/listings/new">List a product</a>.</div>
    <% } else { %>
      <div class="glass-light data-panel table-wrap reveal">
        <table class="table">
          <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th></tr></thead>
          <tbody>
            <% listings.forEach(function(l){ %>
              <tr>
                <td><%= l.name %></td>
                <td class="capitalize"><%= l.category %></td>
                <td>₹<%= l.price_inr %></td>
                <td><%= l.quantity_available %></td>
                <td>
                  <% if (l.is_rejected) { %><span class="pill pill-danger">Rejected</span>
                  <% } else if (l.is_approved) { %><span class="pill pill-success">Live</span>
                  <% } else { %><span class="pill pill-warning">Pending</span><% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
</section>

<%- include('../layout/_foot') %>
