<%- include('../layout/_head') %>

<section class="section">
  <div class="section-inner">
    <a href="/manufacturer/dashboard" class="text-sm text-brand font-semibold">← Dashboard</a>
    <div class="flex items-center justify-between mt-2 mb-4 flex-wrap gap-3">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-3xl font-bold"><%= batch.batch_name %></h1>
          <% if (batch.payment_status === 'paid') { %>
            <span class="pill pill-success">Paid</span>
          <% } else { %>
            <span class="pill pill-warning">Payment pending</span>
          <% } %>
        </div>
        <p class="text-sm text-slate-500 mt-0.5">
          Batch #<%= batch.id %> · <%= batch.quantity.toLocaleString() %> tags
          <% if (batch.paid_amount) { %>
            · ₹<%= (batch.paid_amount / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> charged
          <% } %>
        </p>
      </div>
      <% if (batch.payment_status === 'paid') { %>
        <a class="btn-brand text-sm" href="/manufacturer/batch/<%= batch.id %>/csv">⬇ Download CSV</a>
      <% } else { %>
        <a class="btn-brand text-sm" href="/manufacturer/batch/<%= batch.id %>/pay">Complete Payment →</a>
      <% } %>
    </div>

    <% if (batch.payment_status !== 'paid') { %>
      <div class="flash flash-error mb-4">
        ⚠️ Tags will be generated after payment is completed.
        <a href="/manufacturer/batch/<%= batch.id %>/pay" class="underline font-semibold ml-1">Pay now →</a>
      </div>
    <% } %>

    <% if (tags.length > 0) { %>

    <!-- Toolbar: filter + page size -->
    <div class="mb-3 flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm text-slate-500 font-medium">Status:</span>
        <button onclick="setFilter('all')"      id="filter-all"      class="pill pill-brand text-xs cursor-pointer border-0 bg-transparent">All (<%= tags.length %>)</button>
        <button onclick="setFilter('active')"   id="filter-active"   class="pill pill-mono  text-xs cursor-pointer border-0 bg-transparent">Active (<%= tags.filter(function(t){return t.is_active}).length %>)</button>
        <button onclick="setFilter('inactive')" id="filter-inactive" class="pill pill-mono  text-xs cursor-pointer border-0 bg-transparent">Inactive (<%= tags.filter(function(t){return !t.is_active}).length %>)</button>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <span class="text-slate-500">Show:</span>
        <select id="pageSizeSelect" onchange="setPageSize(this.value)" class="input" style="width:auto;padding:.3rem .7rem;">
          <option value="20">20</option>
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="all">All</option>
        </select>
        <span id="countDisplay" class="text-slate-500 text-xs whitespace-nowrap"></span>
      </div>
    </div>

    <div class="card overflow-hidden">
      <table class="table" id="tagTable">
        <thead><tr><th>Tag ID</th><th>Status</th><th>Scans</th><th>Activated</th></tr></thead>
        <tbody>
          <% tags.forEach(function(t){ %>
            <tr data-status="<%= t.is_active ? 'active' : 'inactive' %>">
              <td class="mono"><%= t.tag_id %></td>
              <td><% if (t.is_active) { %><span class="pill pill-success">Active</span><% } else { %><span class="pill pill-warning">Inactive</span><% } %></td>
              <td><%= t.scan_count %></td>
              <td class="text-xs text-slate-500"><%= t.activated_at ? t.activated_at.split('T')[0] : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <script>
    (function () {
      var allRows = Array.from(document.querySelectorAll('#tagTable tbody tr'));
      var currentFilter = 'all';
      var currentSize = 20;

      function getFiltered() {
        if (currentFilter === 'all') return allRows;
        return allRows.filter(function (r) { return r.dataset.status === currentFilter; });
      }

      function render() {
        var filtered = getFiltered();
        var limit = currentSize === 'all' ? filtered.length : currentSize;
        allRows.forEach(function (r) { r.style.display = 'none'; });
        filtered.slice(0, limit).forEach(function (r) { r.style.display = ''; });
        document.getElementById('countDisplay').textContent =
          'Showing ' + Math.min(limit, filtered.length) + ' of ' + filtered.length;
        ['all', 'active', 'inactive'].forEach(function (f) {
          var btn = document.getElementById('filter-' + f);
          if (btn) btn.className = 'pill text-xs cursor-pointer border-0 bg-transparent ' +
            (f === currentFilter ? 'pill-brand' : 'pill-mono');
        });
      }

      window.setFilter = function (f) { currentFilter = f; render(); };
      window.setPageSize = function (v) {
        currentSize = v === 'all' ? 'all' : parseInt(v, 10);
        render();
      };

      render();
    })();
    </script>

    <% } %>
  </div>
</section>

<%- include('../layout/_foot') %>
