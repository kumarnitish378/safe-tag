<%- include('layout/_head', { noIndex: true }) %>

<style>
  /* Non-layered CSS so it beats Tailwind @layer utilities */
  .pm-opt { border:1.5px solid #e2e8f0; border-radius:12px; cursor:pointer; transition:border-color .15s,background .15s; }
  .pm-opt:hover { background:#f8fafc; }
  .pm-opt[data-sel="1"] { border-color:#0D9488 !important; background:#f0fdfa !important; }
  .pm-ring { width:20px; height:20px; border-radius:50%; border:2px solid #cbd5e1; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:border-color .15s; }
  .pm-opt[data-sel="1"] .pm-ring { border-color:#0D9488 !important; }
  .pm-dot  { width:10px; height:10px; border-radius:50%; background:transparent; transition:background .15s; }
  .pm-opt[data-sel="1"] .pm-dot  { background:#0D9488 !important; }
</style>

<div class="page-shell">
  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/store" class="text-brand font-semibold hover:underline">Store</a>
    <span>›</span>
    <a href="/store/<%= product.id %>" class="hover:underline truncate max-w-xs"><%= product.name %></a>
    <span>›</span>
    <span class="text-navy font-medium">Checkout</span>
  </nav>

  <div class="grid lg:grid-cols-3 gap-8 items-start">

    <!-- LEFT: Form sections (2/3) -->
    <div class="lg:col-span-2 space-y-5">
      <div class="page-hero reveal">
        <div class="page-kicker">Secure checkout</div>
        <h1 class="page-title">Confirm delivery and payment</h1>
        <p class="page-subtitle">Your SafeTag ships across India with setup details included in the package.</p>
      </div>

      <% if (errors && errors._form) { %>
        <div class="flash flash-error">⚠️ <%= errors._form %></div>
      <% } %>

      <form method="POST" action="/checkout/<%= product.id %>" id="checkoutForm" class="space-y-5">
        <%- include('layout/_csrf') %>
        <input type="hidden" name="quantity" value="<%= quantity %>" />
        <input type="hidden" name="payment_method" id="pmHidden" value="upi" />

        <!-- Section 1: Contact & Delivery -->
        <div class="glass-light form-panel p-6 reveal">
          <h2 class="font-semibold text-navy mb-5 flex items-center gap-2.5 text-base">
            <span class="w-7 h-7 rounded-full bg-brand text-white text-sm flex items-center justify-center font-bold flex-shrink-0">1</span>
            Delivery Details
          </h2>
          <div class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="label">Full Name *</label>
                <input class="input" name="recipient_name" required placeholder="Name on address label" maxlength="100" value="<%= values.recipient_name||'' %>" />
              </div>
              <div>
                <label class="label">Mobile Number *</label>
                <div class="flex">
                  <span class="px-3 py-2 bg-slate-100 border border-slate-200 border-r-0 rounded-l-card text-sm text-slate-600 flex-shrink-0">+91</span>
                  <input class="input rounded-l-none" name="recipient_phone" required pattern="[6-9][0-9]{9}" placeholder="10-digit number" maxlength="10" value="<%= values.recipient_phone||'' %>" />
                </div>
              </div>
            </div>

            <div>
              <label class="label">Address Line 1 *</label>
              <input class="input" name="address_line1" required placeholder="House / Flat no., Building name, Street" maxlength="200" value="<%= values.address_line1||'' %>" />
            </div>
            <div>
              <label class="label">Address Line 2 <span class="text-xs text-slate-400 font-normal">(optional)</span></label>
              <input class="input" name="address_line2" placeholder="Landmark, Colony, Area" maxlength="200" value="<%= values.address_line2||'' %>" />
            </div>

            <div class="grid sm:grid-cols-3 gap-4">
              <div>
                <label class="label">City *</label>
                <input class="input" name="city" required placeholder="e.g. Jaipur" maxlength="100" value="<%= values.city||'' %>" />
              </div>
              <div>
                <label class="label">State *</label>
                <select class="input" name="state" required>
                  <option value="">Select state</option>
                  <% ['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh','Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal','Delhi','Jammu & Kashmir','Ladakh','Puducherry','Chandigarh','Andaman & Nicobar','Lakshadweep','Other'].forEach(function(s){ %>
                    <option value="<%= s %>" <%= values.state===s?'selected':'' %>><%= s %></option>
                  <% }); %>
                </select>
              </div>
              <div>
                <label class="label">PIN Code *</label>
                <input class="input" name="pincode" required pattern="[1-9][0-9]{5}" placeholder="6 digits" maxlength="6" value="<%= values.pincode||'' %>" />
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Payment Method -->
        <div class="glass-light form-panel p-6 reveal">
          <h2 class="font-semibold text-navy mb-5 flex items-center gap-2.5 text-base">
            <span class="w-7 h-7 rounded-full bg-brand text-white text-sm flex items-center justify-center font-bold flex-shrink-0">2</span>
            Payment Method
          </h2>

          <div class="space-y-2.5" id="paymentOptions">
            <!-- UPI — selected by default (data-sel="1") -->
            <div class="pm-opt flex items-center gap-4 p-4" data-value="upi" data-sel="1" onclick="selectPM(this)">
              <div class="pm-ring"><div class="pm-dot"></div></div>
              <div class="flex-1">
                <div class="font-semibold text-sm" style="color:#0A2342">UPI Payment</div>
                <div class="text-xs text-slate-500 mt-0.5">Google Pay · PhonePe · Paytm · BHIM · Any UPI app</div>
              </div>
              <span class="text-2xl">📱</span>
            </div>
            <!-- Card -->
            <div class="pm-opt flex items-center gap-4 p-4" data-value="card" data-sel="0" onclick="selectPM(this)">
              <div class="pm-ring"><div class="pm-dot"></div></div>
              <div class="flex-1">
                <div class="font-semibold text-sm" style="color:#0A2342">Credit / Debit Card</div>
                <div class="text-xs text-slate-500 mt-0.5">Visa · Mastercard · RuPay — all cards accepted</div>
              </div>
              <span class="text-2xl">💳</span>
            </div>
            <!-- COD -->
            <div class="pm-opt flex items-center gap-4 p-4" data-value="cod" data-sel="0" onclick="selectPM(this)">
              <div class="pm-ring"><div class="pm-dot"></div></div>
              <div class="flex-1">
                <div class="font-semibold text-sm" style="color:#0A2342">Cash on Delivery</div>
                <div class="text-xs text-slate-500 mt-0.5">Pay when your order arrives · +₹30 handling charge applies</div>
              </div>
              <span class="text-2xl">💵</span>
            </div>
          </div>

          <div id="codNotice" class="hidden mt-4 p-3 bg-amber-50 border border-amber-200 rounded-card text-sm text-amber-800 flex gap-2 items-start">
            <span class="flex-shrink-0">ℹ️</span>
            <span>Cash on Delivery has an additional ₹30 handling charge. New total: <strong>₹<span id="codTotal"><%= totalInr + 30 %></span></strong></span>
          </div>
        </div>

        <!-- Place Order -->
        <button type="submit" class="btn-warn btn-lq w-full justify-center text-lg py-4 font-bold rounded-card">
          🔒 Place Order — ₹<span id="btnTotal"><%= totalInr %></span>
        </button>
        <p class="text-xs text-center text-slate-400 mt-1">SSL encrypted · 7-day returns · Made in India 🇮🇳</p>
      </form>
    </div>

    <!-- RIGHT: Order Summary (1/3) -->
    <div>
      <div class="glass-light stable-panel p-5 sticky top-20 reveal">
        <h3 class="font-semibold text-navy mb-4">Order Summary</h3>

        <div class="flex gap-3 pb-4 border-b border-slate-100">
          <div class="w-16 h-16 bg-slate-100 rounded-card flex items-center justify-center flex-shrink-0 overflow-hidden">
            <% if (product.photo_url) { %>
              <img src="<%= product.photo_url %>" class="w-16 h-16 object-cover" alt="<%= product.name %>" />
            <% } else { %>
              <span class="text-3xl">🏷️</span>
            <% } %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-navy text-sm leading-snug"><%= product.name %></div>
            <div class="text-xs text-slate-500 capitalize mt-0.5"><%= product.category %></div>
            <div class="text-xs text-slate-400 mt-1">Qty: <%= quantity %></div>
          </div>
        </div>

        <div class="pt-4 space-y-2.5 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">Subtotal (×<%= quantity %>)</span>
            <span class="font-medium">₹<%= totalInr %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Shipping</span>
            <span class="font-semibold" style="color:#22C55E">FREE</span>
          </div>
          <div id="codRowSidebar" class="hidden flex justify-between" style="color:#b45309">
            <span>COD charge</span>
            <span>+₹30</span>
          </div>
          <div class="flex justify-between font-bold text-navy text-base border-t border-slate-100 pt-3">
            <span>Total</span>
            <span id="totalSidebar">₹<%= totalInr %></span>
          </div>
        </div>

        <div class="mt-5 pt-4 border-t border-slate-100 space-y-2.5 text-xs text-slate-500">
          <div class="flex gap-2">🔒 256-bit SSL secure checkout</div>
          <div class="flex gap-2">🚚 Pan-India delivery in 5–7 days</div>
          <div class="flex gap-2">↩️ 7-day hassle-free returns</div>
          <div class="flex gap-2">📞 support@safe-tag.in</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
var _baseTotal = <%= totalInr %>;
var _isCod = false;

function selectPM(el) {
  document.querySelectorAll('.pm-opt').forEach(function(o) {
    o.setAttribute('data-sel', o === el ? '1' : '0');
  });
  document.getElementById('pmHidden').value = el.getAttribute('data-value');
  _isCod = (el.getAttribute('data-value') === 'cod');
  updateTotals();
}

function updateTotals() {
  var total = _baseTotal + (_isCod ? 30 : 0);
  document.getElementById('btnTotal').textContent = total;
  document.getElementById('totalSidebar').textContent = '₹' + total;
  document.getElementById('codTotal').textContent = _baseTotal + 30;
  document.getElementById('codNotice').classList.toggle('hidden', !_isCod);
  document.getElementById('codRowSidebar').classList.toggle('hidden', !_isCod);
}
</script>

<%- include('layout/_foot') %>
