<%
  // NOTE: use `var` (function-scoped) — a bare `head = ...` inside EJS's
  // with(locals) leaks to the process global and breaks other pages. hideNav /
  // hideFooter are passed as include data below for the same reason.
  var head = `<style>
    .auth-wrap{display:flex;min-height:100vh;background:var(--white)}
    .auth-left{
      display:none;width:44%;min-width:340px;background:var(--navy);
      padding:3rem 3.5rem;flex-direction:column;justify-content:space-between;
      position:sticky;top:0;height:100vh;overflow:hidden;
    }
    @media (min-width:960px){.auth-left{display:flex}}
    .auth-right{
      flex:1;display:flex;align-items:center;justify-content:center;
      padding:2.5rem 2rem;background:var(--white);min-height:100vh;
    }
    .auth-box{width:100%;max-width:400px}
    .auth-box h1,.auth-box h2{font-family:'Sora',sans-serif;color:var(--navy)}
    .auth-point{display:flex;align-items:flex-start;gap:.6rem;color:#cbd5e1;font-size:.9rem;line-height:1.5}
    .auth-check{color:var(--teal);font-size:1.15rem;flex-shrink:0;margin-top:.05rem}
    .auth-form{display:flex;flex-direction:column;gap:1rem}
    .auth-field{display:flex;flex-direction:column;gap:.4rem}
    .auth-label{font-weight:600;font-size:.88rem;color:var(--navy)}
    .auth-input{
      width:100%;background:#fff;border:1.5px solid var(--line);border-radius:10px;
      padding:.72rem .85rem;font-size:.95rem;color:var(--navy);
      font-family:'Inter',sans-serif;transition:.15s;
    }
    .auth-input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(13,148,136,.15)}
    .auth-err{color:#dc2626;font-size:.8rem}
    .auth-flash{
      background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;border-radius:10px;
      padding:.7rem .85rem;font-size:.88rem;display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;
    }
    .auth-flash .material-symbols-outlined{color:#dc2626;font-size:1.1rem}
    .auth-logo-mobile{display:flex;justify-content:center;margin-bottom:2rem}
    @media (min-width:960px){.auth-logo-mobile{display:none}}
  </style>`;
%>
<%- include('../layout/_head', { hideNav: true, head: head }) %>

<div class="auth-wrap">

  <!-- ── Left branding panel (desktop only) ── -->
  <div class="auth-left">
    <a href="/" style="display:flex;align-items:center;gap:.6rem;color:#fff;font-weight:700;font-size:1.1rem;text-decoration:none;font-family:'Sora',sans-serif;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
        <circle cx="7" cy="7" r="1" fill="white" stroke="none"/>
      </svg>
      SafeTag
    </a>

    <div>
      <h1 style="font-size:2rem;font-weight:800;color:#fff;line-height:1.25;margin:0 0 1rem;font-family:'Sora',sans-serif;">
        Emergency identity.<br>One scan.
      </h1>
      <p style="color:#5eead4;font-size:.93rem;line-height:1.7;margin:0 0 1.75rem;">
        Your SafeTag connects first responders to blood group, allergies, and emergency contacts in under 3 seconds. No app needed.
      </p>
      <div style="display:flex;flex-direction:column;gap:.65rem;">
        <div class="auth-point">
          <span class="material-symbols-outlined auth-check">check</span>
          QR + NFC tags for children, elderly &amp; pets
        </div>
        <div class="auth-point">
          <span class="material-symbols-outlined auth-check">check</span>
          Works on any Android or iPhone — no app needed
        </div>
        <div class="auth-point">
          <span class="material-symbols-outlined auth-check">check</span>
          Blood group, allergies &amp; emergency contacts
        </div>
        <div class="auth-point">
          <span class="material-symbols-outlined auth-check">check</span>
          Ships across India from ₹149
        </div>
      </div>
    </div>

    <p style="color:rgba(255,255,255,.5);font-size:.75rem;">© 2025 SafeTag. All rights reserved.</p>
  </div>

  <!-- ── Right form panel ── -->
  <div class="auth-right">
    <div class="auth-box">

      <!-- Mobile logo -->
      <div class="auth-logo-mobile">
        <a href="/" style="display:flex;align-items:center;gap:.6rem;color:#0A2342;font-weight:700;font-size:1.1rem;text-decoration:none;font-family:'Sora',sans-serif;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0A2342" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
            <circle cx="7" cy="7" r="1" fill="#0A2342" stroke="none"/>
          </svg>
          SafeTag
        </a>
      </div>

      <h2 style="font-size:1.65rem;font-weight:700;margin:0 0 .3rem;">Welcome back</h2>
      <p style="color:var(--muted);font-size:.9rem;margin:0 0 1.5rem;">Sign in to manage your SafeTags.</p>

      <% if (errors._form) { %>
      <div class="auth-flash"><span class="material-symbols-outlined">error</span><%= errors._form %></div>
      <% } %>
      <% if (flash && flash.error && flash.error.length) { %>
        <% flash.error.forEach(function(m){ %>
        <div class="auth-flash"><span class="material-symbols-outlined">error</span><%= m %></div>
        <% }); %>
      <% } %>

      <form method="POST" action="/login" class="auth-form">
        <%- include('../layout/_csrf') %>
        <input type="hidden" name="next" value="<%= next || '/dashboard' %>" />
        <div class="auth-field">
          <label class="auth-label">Email</label>
          <input class="auth-input" type="email" name="email" required value="<%= (values.email||'') %>" autocomplete="email" />
        </div>
        <div class="auth-field">
          <label class="auth-label">Password</label>
          <input class="auth-input" type="password" name="password" required autocomplete="current-password" />
        </div>
        <div style="text-align:right;margin-top:-.45rem;">
          <a href="/forgot-password" style="color:var(--teal-d);font-weight:600;font-size:.82rem;">Forgot password?</a>
        </div>
        <button type="submit" class="btn" style="justify-content:center;width:100%;margin-top:.2rem;">Sign in</button>
      </form>

      <p style="text-align:center;color:var(--muted);font-size:.875rem;margin-top:1.25rem;">
        New to SafeTag? <a href="/register" style="color:var(--teal-d);font-weight:600;">Create an account</a>
      </p>
    </div>
  </div>

</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
