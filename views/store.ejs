<%- include('layout/_head') %>

<style>
  .store-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;margin-bottom:.5rem}
  .store-head h1{font-size:clamp(1.9rem,4vw,2.6rem);font-weight:800;margin:.65rem 0 .55rem}
  .store-filter select{padding:.6rem .9rem;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--navy);font-family:inherit;font-weight:600;cursor:pointer}
  .store-filter select:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(13,148,136,.15)}
  .prod-ph{aspect-ratio:1/1;width:100%;display:flex;align-items:center;justify-content:center;background:#f1f5f9}
  .prod-ph .material-symbols-outlined{font-size:3.2rem;color:#94a3b8}
  .prod .pb .cat{display:block;color:var(--muted);font-size:.85rem;margin:.15rem 0 .5rem;text-transform:capitalize}
  .prod .feat-badge{display:inline-flex;align-items:center;gap:.3rem;background:#fef3c7;color:#92400e;border-radius:999px;padding:.2rem .6rem;font-size:.72rem;font-weight:700;margin-bottom:.4rem}
  .prod .feat-badge .material-symbols-outlined{color:#d97706;font-size:1rem}
  .prod .desc{color:var(--muted);font-size:.85rem;margin:.1rem 0 .65rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .prod .prow{display:flex;align-items:center;justify-content:space-between}
  .prod .view{display:inline-flex;align-items:center;gap:.25rem;color:var(--teal-d);font-weight:700;font-size:.9rem}
  .prod .view .material-symbols-outlined{color:currentColor;font-size:1.1rem}
  .empty{text-align:center;padding:4rem 1rem;color:var(--muted)}
  .empty .material-symbols-outlined{font-size:3rem;color:#94a3b8}
  .empty h3{font-size:1.25rem;margin:.55rem 0 .3rem}
</style>

<section class="section">
  <div class="wrap">
    <div class="store-head reveal">
      <div>
        <span class="eyebrow">SafeTag Store</span>
        <h1>Emergency ID tags for everyday India</h1>
        <p class="lead">Choose QR + NFC keychains, cards, stickers and wristbands that open a medical profile in seconds. No app needed.</p>
      </div>
      <form method="GET" action="/store" class="store-filter">
        <select name="category" onchange="this.form.submit()">
          <option value="">All categories</option>
          <% ['keychain','card','sticker','wristband'].forEach(function(c){ %>
            <option value="<%= c %>" <%= category===c?'selected':'' %>><%= c.charAt(0).toUpperCase()+c.slice(1) %></option>
          <% }) %>
        </select>
      </form>
    </div>

    <% if (!products.length) { %>
      <div class="empty reveal">
        <span class="material-symbols-outlined">sell</span>
        <h3>No products yet</h3>
        <p>Check back soon — manufacturers are listing new SafeTags every week.</p>
      </div>
    <% } else { %>
      <div class="prods">
        <% products.forEach(function(p, i){ %>
          <a href="/store/<%= p.id %>" class="prod reveal">
            <% if (p.photo_url) { %>
              <img src="<%= p.photo_url %>" alt="<%= p.name %>" />
            <% } else { %>
              <div class="prod-ph"><span class="material-symbols-outlined">sell</span></div>
            <% } %>
            <div class="pb">
              <% if (p.is_featured) { %><span class="feat-badge"><span class="material-symbols-outlined">star</span>Featured</span><% } %>
              <b><%= p.name %></b>
              <span class="cat"><%= p.category %> · by <%= p.manufacturer_name %></span>
              <p class="desc"><%= (p.description||'').slice(0,90) %></p>
              <div class="prow">
                <span class="price">₹<%= p.price_inr %></span>
                <span class="view">View <span class="material-symbols-outlined">arrow_forward</span></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('layout/_foot') %>
