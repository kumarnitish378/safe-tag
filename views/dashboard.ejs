<%- include('layout/_head') %>

<section class="page-shell">
    <div class="page-hero">
      <div>
        <div class="page-kicker">Family safety dashboard</div>
        <h1 class="page-title">My SafeTags</h1>
        <p class="page-subtitle">Welcome, <%= user.name || user.email %>. Manage activated tags, orders, QR codes and emergency profiles from one place.</p>
      </div>
      <div class="page-actions">
        <button onclick="document.getElementById('claimModal').classList.remove('hidden')" class="btn-outline text-sm">+ Activate a Tag</button>
        <a class="btn-warn text-sm" href="/store">Buy More Tags</a>
      </div>
    </div>

    <div class="grid sm:grid-cols-3 gap-3 mb-6">
      <div class="glass-light metric-card reveal">
        <div class="metric-label mb-1">Total tags</div>
        <div class="text-3xl font-sora font-bold text-navy stat-num" data-count="<%= stats.total %>">0</div>
      </div>
      <div class="glass-light metric-card reveal d2">
        <div class="metric-label mb-1">Active</div>
        <div class="text-3xl font-sora font-bold text-success stat-num" data-count="<%= stats.active %>">0</div>
      </div>
      <div class="glass-light metric-card reveal d3">
        <div class="metric-label mb-1">Pending Activation</div>
        <div class="text-3xl font-sora font-bold text-warning stat-num" data-count="<%= stats.pending %>">0</div>
      </div>
    </div>

    <% if (!tags.length && orders && orders.length) { %>
      <!-- User has orders but no activated tags yet -->
      <div class="card p-6 mb-6 border-l-4 border-brand">
        <div class="flex gap-3 items-start">
          <span class="text-3xl flex-shrink-0">📦</span>
          <div>
            <h3 class="font-semibold text-navy mb-1">Your tags are on the way!</h3>
            <p class="text-sm text-slate-600">Once you receive your SafeTag, scan the QR code on the tag to activate it — it will appear here automatically.</p>
          </div>
        </div>
      </div>
    <% } %>

    <% if (!tags.length && (!orders || !orders.length)) { %>
      <div class="empty-state">
        <div class="text-5xl mb-2">🏷️</div>
        <h3 class="text-xl font-semibold mb-1">No tags yet</h3>
        <p class="mb-5">Order a SafeTag and scan it once you receive it — you'll be brought right back here.</p>
        <div class="flex gap-3 justify-center">
          <a href="/store" class="btn-brand">Buy a Tag</a>
          <button onclick="document.getElementById('claimModal').classList.remove('hidden')" class="btn-outline">Already have one?</button>
        </div>
      </div>
    <% } %>

    <% if (tags.length) { %>
      <div class="section-heading"><h2>My Tags</h2></div>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        <% tags.forEach(function(t){ %>
          <div class="card p-5 stable-panel">
            <div class="flex items-center justify-between mb-2">
              <span class="pill pill-mono"><%= t.tag_id %></span>
              <% if (t.is_active) { %><span class="pill pill-success">Active</span><% } else { %><span class="pill pill-warning">Pending</span><% } %>
            </div>
            <% if (t.profile) { %>
              <h3 class="text-lg font-semibold"><%= t.profile.name %></h3>
              <p class="text-sm text-slate-500"><%= t.profile.mobile_primary ? '+91 ' + t.profile.mobile_primary : '' %></p>
            <% } else { %>
              <h3 class="text-lg font-semibold text-slate-400">No profile yet</h3>
              <p class="text-sm text-slate-500">Scan your tag to activate.</p>
            <% } %>
            <div class="text-xs text-slate-500 mt-2 break-all"><a class="text-brand" href="<%= baseUrl %>/<%= t.tag_id %>" id="url-<%= t.tag_id %>"><%= baseUrl %>/<%= t.tag_id %>/…</a></div>
            <div class="mt-4 flex flex-wrap gap-2">
              <% if (t.is_active) { %>
                <a class="btn-brand text-sm" href="/profile/edit/<%= t.tag_id %>">Edit Profile</a>
                <a class="btn-outline text-sm" href="/emergency/<%= t.tag_id %>" target="_blank">Preview</a>
              <% } %>
              <a class="btn-outline text-sm" href="/qr/<%= t.tag_id %>" target="_blank">QR PNG</a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (orders && orders.length) { %>
      <div class="section-heading"><h2>My Orders</h2><a class="text-brand text-sm font-semibold" href="/orders">View all</a></div>
      <div class="space-y-3">
        <% orders.forEach(function(o){ %>
          <%
            var statusLabel = o.status === 'paid' ? 'Paid'
              : o.status === 'dispatched' ? 'Dispatched'
              : o.status === 'delivered' ? 'Delivered'
              : o.status === 'cancelled' ? 'Cancelled'
              : 'Order Placed';
            var statusClass = o.status === 'delivered' ? 'pill-success'
              : o.status === 'dispatched' ? 'pill-brand'
              : o.status === 'cancelled' ? 'pill-danger'
              : 'pill-warning';
            var shippingAddr = '';
            try { var addr = JSON.parse(o.shipping_address || '{}'); shippingAddr = [addr.address_line1, addr.city, addr.state, addr.pincode].filter(Boolean).join(', '); } catch(e) {}
          %>
          <div class="card p-5 flex gap-4 items-start stable-panel">
            <div class="w-14 h-14 bg-slate-100 rounded-xl flex items-center justify-center flex-shrink-0 overflow-hidden">
              <% if (o.product && o.product.photo_url) { %>
                <img src="<%= o.product.photo_url %>" class="w-14 h-14 object-cover" alt="<%= o.product.name %>" />
              <% } else { %>
                <span class="text-2xl">🏷️</span>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2 flex-wrap">
                <div>
                  <div class="font-semibold text-navy text-sm"><%= o.product ? o.product.name : 'SafeTag' %></div>
                  <div class="text-xs text-slate-500 mt-0.5">Qty: <%= o.quantity %> &nbsp;·&nbsp; ₹<%= o.amount_inr %></div>
                  <% if (shippingAddr) { %><div class="text-xs text-slate-400 mt-0.5 truncate max-w-xs"><%= shippingAddr %></div><% } %>
                  <% if (o.tracking_id) { %><div class="text-xs text-slate-500 mt-1">Tracking: <span class="font-mono"><%= o.tracking_id %></span></div><% } %>
                </div>
                <span class="pill <%= statusClass %> flex-shrink-0"><%= statusLabel %></span>
              </div>
              <% if (o.status !== 'delivered' && o.status !== 'cancelled') { %>
                <p class="text-xs text-slate-500 mt-2">Once delivered, scan the QR code on your tag to activate it and it will appear in <strong>My Tags</strong> above.</p>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

</section>

<!-- Claim tag modal -->
<div id="claimModal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center px-4">
  <div class="card max-w-md w-full p-6">
    <div class="flex items-center justify-between mb-3"><h3 class="text-lg font-bold">Activate / Claim a tag</h3><button onclick="document.getElementById('claimModal').classList.add('hidden')" class="text-slate-500">✕</button></div>
    <p class="text-sm text-slate-600 mb-4">Enter the tag ID and security key printed on your SafeTag to link it to this account. Or, if not yet registered, scan the physical tag to begin.</p>
    <form method="POST" action="/dashboard/claim" class="space-y-3">
      <%- include('layout/_csrf') %>
      <div><label class="label">Tag ID</label><input class="input mono" name="tag_id" required maxlength="10" /></div>
      <div><label class="label">Security key</label><input class="input mono" name="security_key" required maxlength="32" /></div>
      <div class="flex justify-end gap-2"><button type="button" onclick="document.getElementById('claimModal').classList.add('hidden')" class="btn-outline">Cancel</button><button class="btn-brand">Claim</button></div>
    </form>
  </div>
</div>

<%- include('layout/_foot') %>
