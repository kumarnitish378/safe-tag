<%- include('layout/_head') %>

<style>
  .pd-breadcrumb{display:flex;align-items:center;gap:.5rem;font-size:.9rem;color:var(--muted);flex-wrap:wrap;margin-bottom:1.5rem}
  .pd-breadcrumb a{color:var(--teal-d);font-weight:600}
  .pd-breadcrumb a:hover{text-decoration:underline}
  .pd-breadcrumb .cur{color:var(--navy);font-weight:600}
  .pd-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
  .pd-media{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:#f1f5f9;min-height:360px;display:flex;align-items:center;justify-content:center}
  .pd-media img{width:100%;max-height:440px;object-fit:cover}
  .pd-media .material-symbols-outlined{font-size:5rem;color:#94a3b8}
  .pd-badges{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.9rem}
  .pd-by{font-size:.72rem;color:#94a3b8;text-transform:uppercase;font-weight:700;letter-spacing:.05em}
  .pd-title{font-size:clamp(1.7rem,3vw,2.2rem);font-weight:800;margin:.35rem 0 .9rem}
  .pd-pricerow{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
  .pd-price{font-size:2.4rem;font-weight:800;color:var(--navy);font-family:'Sora',sans-serif}
  .pd-strike{color:#94a3b8;text-decoration:line-through;font-size:.95rem}
  .pd-card{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm);padding:1.4rem}
  .pd-card .cap{font-size:.72rem;text-transform:uppercase;font-weight:800;color:var(--muted);letter-spacing:.05em;margin-bottom:.85rem}
  .pd-box{list-style:none;display:flex;flex-direction:column;gap:.55rem;font-size:.92rem;color:var(--ink)}
  .pd-box li{display:flex;gap:.5rem;align-items:flex-start}
  .pd-box .material-symbols-outlined{color:var(--teal);font-size:1.15rem}
  .pd-qtyrow{display:flex;align-items:center;gap:1rem;margin-bottom:1rem}
  .pd-stepper{display:flex;align-items:center;gap:.5rem}
  .pd-stepbtn{width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:#fff;font-weight:700;color:var(--navy);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
  .pd-stepbtn:hover{background:#f1f5f9;border-color:var(--teal)}
  .pd-qtyinput{width:64px;text-align:center;padding:.45rem;border:1px solid var(--line);border-radius:8px;font-family:inherit;color:var(--navy)}
  .pd-qtyinput:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(13,148,136,.15)}
  .pd-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;text-align:center}
  .pd-trust .t{border:1px solid var(--line);border-radius:14px;padding:.9rem .4rem;font-size:.72rem;color:var(--muted)}
  .pd-trust .t .material-symbols-outlined{font-size:1.5rem;color:var(--teal)}
  .pd-trust .t b{display:block;color:var(--navy);font-size:.8rem;margin-top:.25rem}
  .pd-stack{display:flex;flex-direction:column;gap:1.25rem}
  .btn.full{width:100%;justify-content:center}
  .btn .material-symbols-outlined{color:currentColor}
  .steps{margin-top:0}
  .step .stepnum{width:44px;height:44px;border-radius:999px;background:#e6fbf7;display:flex;align-items:center;justify-content:center;margin-bottom:.7rem}
  .step .stepnum .material-symbols-outlined{color:var(--teal);font-size:1.5rem}
  .pd-section h2{font-size:1.35rem;font-weight:800;margin-bottom:1rem}
  .pd-about{color:var(--muted);line-height:1.7;white-space:pre-line}
  @media(max-width:820px){.pd-grid{grid-template-columns:1fr;gap:1.6rem}}
</style>

<section class="section">
  <div class="wrap">

    <nav class="pd-breadcrumb">
      <a href="/store">Store</a>
      <span>›</span>
      <span class="cur" style="text-transform:capitalize"><%= product.category %></span>
      <span>›</span>
      <span class="cur"><%= product.name %></span>
    </nav>

    <div class="pd-grid">

      <!-- Left: image + badges -->
      <div class="reveal-left">
        <div class="pd-media">
          <% if (product.photo_url) { %>
            <img src="<%= product.photo_url %>" alt="<%= product.name %>" />
          <% } else { %>
            <span class="material-symbols-outlined">sell</span>
          <% } %>
        </div>
        <div class="pd-badges">
          <span class="pill pill-brand" style="text-transform:capitalize"><%= product.category %></span>
          <% if (product.is_featured) { %><span class="pill pill-warning"><span class="material-symbols-outlined" style="color:currentColor;font-size:1rem">star</span> Best Value</span><% } %>
          <% if (product.quantity_available > 0) { %>
            <span class="pill pill-success"><span class="material-symbols-outlined" style="color:currentColor;font-size:1rem">check_circle</span> In Stock (<%= product.quantity_available %> left)</span>
          <% } else { %>
            <span class="pill pill-danger">Out of Stock</span>
          <% } %>
        </div>
      </div>

      <!-- Right: info + buy -->
      <div class="pd-stack reveal">
        <div>
          <p class="pd-by">by <%= product.manufacturer_name %></p>
          <h1 class="pd-title"><%= product.name %></h1>
          <div class="pd-pricerow">
            <span class="pd-price">₹<%= product.price_inr %></span>
            <% if (product.is_featured) { %>
              <span class="pd-strike">₹<%= Math.round(product.price_inr * 1.2) %></span>
              <span class="pill pill-success">Save ₹<%= Math.round(product.price_inr * 0.2) %></span>
            <% } %>
          </div>
        </div>

        <!-- What's in the box -->
        <div class="pd-card">
          <p class="cap">What's in the box</p>
          <ul class="pd-box">
            <li><span class="material-symbols-outlined">check</span>1× SafeTag (<span style="text-transform:capitalize"><%= product.category %></span>)</li>
            <li><span class="material-symbols-outlined">check</span>Unique Tag ID + Security Key card</li>
            <li><span class="material-symbols-outlined">check</span>QR code label (pre-applied)</li>
            <li><span class="material-symbols-outlined">check</span>Setup guide (scan to activate)</li>
          </ul>
        </div>

        <!-- Buy / OOS -->
        <% if (product.quantity_available > 0) { %>
          <div class="pd-card">
            <div class="pd-qtyrow">
              <label class="label" style="margin-bottom:0">Quantity</label>
              <div class="pd-stepper">
                <button type="button" onclick="var q=document.getElementById('qtyInput'); q.value=Math.max(1,+q.value-1); updateTotal();" class="pd-stepbtn">−</button>
                <input id="qtyInput" class="pd-qtyinput" type="number" min="1" max="<%= product.quantity_available %>" value="1" onchange="updateTotal()" />
                <button type="button" onclick="var q=document.getElementById('qtyInput'); q.value=Math.min(<%= product.quantity_available %>,+q.value+1); updateTotal();" class="pd-stepbtn">+</button>
              </div>
            </div>
            <a id="buyBtn" href="/checkout/<%= product.id %>?qty=1" class="btn full">
              Buy Now — ₹<span id="totalPrice"><%= product.price_inr %></span>
            </a>
            <% if (!user) { %><p style="font-size:.78rem;text-align:center;color:var(--muted);margin-top:.7rem">You'll be asked to sign in to complete the purchase.</p><% } %>
          </div>
          <script>
            var _unitPrice = <%= product.price_inr %>;
            function updateTotal(){
              var q = Math.max(1, Math.min(<%= product.quantity_available %>, parseInt(document.getElementById('qtyInput').value)||1));
              document.getElementById('totalPrice').textContent = _unitPrice * q;
              document.getElementById('buyBtn').href = '/checkout/<%= product.id %>?qty=' + q;
            }
          </script>
        <% } else { %>
          <div class="pd-card" style="text-align:center">
            <span class="pill pill-danger">Out of Stock</span>
            <p style="font-size:.9rem;color:var(--muted);margin-top:.8rem">Check back soon or <a href="/store" style="color:var(--teal-d);font-weight:600">browse other products</a>.</p>
          </div>
        <% } %>

        <!-- Trust badges -->
        <div class="pd-trust">
          <div class="t"><span class="material-symbols-outlined">lock</span><b>Secure</b>checkout</div>
          <div class="t"><span class="material-symbols-outlined">local_shipping</span><b>Pan-India</b>shipping</div>
          <div class="t"><span class="material-symbols-outlined">undo</span><b>7-day</b>returns</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- About -->
<section class="section" style="padding-top:0">
  <div class="wrap" style="max-width:820px">
    <div class="pd-section reveal">
      <h2>About this product</h2>
      <div class="pd-about"><%= product.description %></div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section" style="background:var(--cream)">
  <div class="wrap" style="max-width:820px">
    <div class="pd-section">
      <h2 class="reveal">How it works</h2>
      <div class="steps">
        <div class="step reveal">
          <div class="stepnum"><span class="material-symbols-outlined">inventory_2</span></div>
          <h3>1. Receive &amp; Attach</h3>
          <p>Attach the tag to a bag, lanyard, collar or wristband.</p>
        </div>
        <div class="step reveal">
          <div class="stepnum"><span class="material-symbols-outlined">qr_code_scanner</span></div>
          <h3>2. Scan to Activate</h3>
          <p>Scan the QR, fill in emergency info. Takes under 2 minutes.</p>
        </div>
        <div class="step reveal">
          <div class="stepnum"><span class="material-symbols-outlined">emergency</span></div>
          <h3>3. One Scan in Emergency</h3>
          <p>Any phone camera opens the emergency profile instantly.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('layout/_foot') %>
