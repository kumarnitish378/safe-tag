<%- include('layout/_head') %>

<section class="section center">
  <div class="wrap" style="max-width:600px;">
    <span class="material-symbols-outlined" style="font-size:3.5rem;color:var(--teal);">build_circle</span>
    <h1 style="font-family:'Sora',sans-serif;font-size:clamp(2.4rem,6vw,3.4rem);font-weight:800;color:var(--navy);margin:1rem 0 .4rem;">500</h1>
    <h2 style="font-family:'Sora',sans-serif;font-size:1.5rem;font-weight:700;color:var(--navy);margin:0 0 1rem;">Something went wrong</h2>
    <p class="lead">The server ran into an unexpected error. This is on us — not you.</p>
    <p style="color:var(--muted);font-size:.9rem;margin-top:.5rem;">
      Our team has been notified. Please try again in a moment.
    </p>

    <div style="display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;margin-top:2rem;">
      <a href="/" class="btn">Back to Home</a>
      <button onclick="history.back()" class="btn-ghost" style="cursor:pointer;">← Go Back</button>
    </div>

    <p style="color:var(--muted);font-size:.82rem;margin-top:2rem;">
      If this keeps happening, contact us at
      <a href="mailto:support@safe-tag.in" style="color:var(--teal-d);font-weight:600;">support@safe-tag.in</a>
    </p>
  </div>
</section>

<%- include('layout/_foot') %>
