<%- include('../layout/_head') %>

<div class="id-shell ds-choose" style="align-items:flex-start; padding-top:2.5rem; padding-bottom:3rem; --acc:#0D9488; --head-bg:linear-gradient(150deg,#0D9488 0%,#0f766e 55%,#0A2342 130%);">
  <div class="w-full" style="max-width:44rem;">
    <div class="choose-head reveal">
      <span class="eyebrow"><span class="material-symbols-outlined">auto_awesome</span> Universal SafeTag</span>
      <h1 class="choose-title">What should this tag do?</h1>
      <p class="choose-sub">Tag <span class="mono"><%= tag_id %></span> — you choose its purpose.</p>
      <p class="choose-hint">Pick one to continue. This choice is locked in once you activate.</p>
    </div>

    <div class="choose-grid">
      <% choices.forEach(function(c){ %>
        <a href="/register/<%= tag_id %>?type=<%= c.id %>" class="choose-card reveal"
           style="--acc:<%= c.accent || '#0D9488' %>; --head-bg:<%= c.headBg || 'linear-gradient(135deg,#0D9488,#0A2342)' %>;">
          <span class="choose-icon material-symbols-outlined"><%= c.icon %></span>
          <span class="choose-body">
            <span class="choose-label"><%= c.label %></span>
            <% if (c.tagline) { %><span class="choose-tagline"><%= c.tagline %></span><% } %>
          </span>
          <span class="choose-arrow material-symbols-outlined">arrow_forward</span>
        </a>
      <% }); %>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<style>
  /* Universal template chooser — design-system light scan page */
  .ds-choose{
    background:
      radial-gradient(70% 45% at 50% 0%, rgba(13,148,136,.06), transparent 60%),
      linear-gradient(180deg,#f4faf9 0%, var(--cream) 100%);
  }
  .choose-head{ text-align:center; margin-bottom:1.6rem; }
  .choose-head .eyebrow{ margin-bottom:.95rem; }
  .choose-head .eyebrow .material-symbols-outlined{ font-size:1rem; color:var(--teal-d); }
  .choose-title{
    font-family:'Sora',sans-serif; font-weight:800; letter-spacing:-.02em;
    font-size:clamp(1.6rem,4vw,2.1rem); color:var(--navy); line-height:1.15;
  }
  .choose-sub{ color:var(--muted); font-size:.95rem; margin-top:.55rem; }
  .choose-sub .mono{ color:var(--navy); }
  .choose-hint{ color:#94a3b8; font-size:.82rem; margin-top:.3rem; }

  .choose-grid{ display:grid; grid-template-columns:1fr; gap:.85rem; }
  @media (min-width:560px){ .choose-grid{ grid-template-columns:1fr 1fr; } }

  .choose-card{
    display:flex; align-items:center; gap:.95rem;
    background:var(--white); border:1.5px solid var(--line); border-radius:16px;
    padding:1.05rem 1.15rem; text-decoration:none; color:inherit;
    box-shadow:var(--shadow-sm);
    transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;
    position:relative; overflow:hidden;
  }
  .choose-card::before{
    content:""; position:absolute; left:0; top:0; bottom:0; width:5px; background:var(--head-bg);
  }
  .choose-card:hover{
    transform:translateY(-3px); border-color:var(--acc);
    box-shadow:0 16px 30px -14px color-mix(in srgb, var(--acc) 55%, transparent);
  }
  .choose-icon{
    flex:0 0 auto; width:2.9rem; height:2.9rem; border-radius:.85rem;
    display:grid; place-items:center; font-size:1.5rem;
    background:var(--head-bg); color:#fff;
  }
  .choose-body{ display:flex; flex-direction:column; min-width:0; flex:1; }
  .choose-label{ font-family:'Sora',sans-serif; font-weight:700; color:var(--navy); line-height:1.2; }
  .choose-tagline{ font-size:.78rem; color:var(--muted); margin-top:.18rem; }
  .choose-arrow{
    color:var(--acc); flex:0 0 auto; opacity:.5; font-size:1.2rem;
    transition:opacity .16s, transform .16s;
  }
  .choose-card:hover .choose-arrow{ opacity:1; transform:translateX(3px); }
  .id-foot{ color:var(--muted); margin-top:1.4rem; }
</style>

<%- include('../layout/_foot') %>
