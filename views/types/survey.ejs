<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell" style="--acc:#059669; --head-bg:linear-gradient(135deg,#34d399 0%,#059669 55%,#065f46 130%); align-items:flex-start; padding-top:2rem;">
  <div class="w-full" style="max-width:25rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">📝</div>
        <h1 class="id-name" style="font-size:1.35rem;"><%= p.title %></h1>
      </div>

      <div class="id-body">
        <% if (typeof submitted !== 'undefined' && submitted) { %>
          <div class="text-center py-8">
            <div class="text-5xl">🎉</div>
            <h2 class="font-semibold mt-3">Thank you!</h2>
            <p class="text-sm text-slate-500 mt-1">Your response has been recorded.</p>
          </div>
        <% } else { %>
          <% if (p.intro) { %><p class="id-note mb-4"><%= p.intro %></p><% } %>
          <form method="POST" action="/t/<%= tag_id %>/submit" class="space-y-4">
            <%- include('../layout/_csrf') %>
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <% (p.questions || []).forEach(function(q, i){ %>
              <div>
                <label class="label" style="display:flex;align-items:center;gap:.5rem;">
                  <span style="flex:0 0 auto;width:22px;height:22px;border-radius:9999px;background:#059669;color:#fff;
                               font-size:.7rem;font-weight:800;display:inline-flex;align-items:center;justify-content:center;"><%= i+1 %></span>
                  <span><%= q %></span>
                </label>
                <input class="input" name="q<%= i %>" maxlength="500" />
              </div>
            <% }); %>
            <button type="submit" class="btn-acc">Submit response</button>
          </form>
        <% } %>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
