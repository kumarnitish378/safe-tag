<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell">
  <div class="w-full" style="max-width:26rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">📝</div>
        <h1 class="id-name"><%= p.title %></h1>
      </div>

      <div class="id-body">
        <% if (typeof submitted !== 'undefined' && submitted) { %>
          <div class="text-center py-8">
            <div class="text-5xl">✅</div>
            <h2 class="font-semibold mt-3">Thank you!</h2>
            <p class="text-sm text-slate-500 mt-1">Your response has been recorded.</p>
          </div>
        <% } else { %>
          <% if (p.intro) { %><p class="id-note mb-4"><%= p.intro %></p><% } %>
          <form method="POST" action="/t/<%= tag_id %>/submit" class="space-y-4">
            <%- include('../layout/_csrf') %>
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <% (p.questions || []).forEach(function(q, i){ %>
              <div>
                <label class="label"><%= q %></label>
                <input class="input" name="q<%= i %>" maxlength="500" />
              </div>
            <% }); %>
            <button type="submit" class="btn-brand btn-lq btn-pill">Submit</button>
          </form>
        <% } %>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
