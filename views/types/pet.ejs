<%- include('../layout/_head', { hideFooter: true }) %>

<style>
  .st-wrap{--acc:#ea580c;min-height:calc(100dvh - 66px);display:flex;align-items:center;justify-content:center;padding:1.5rem;background:var(--cream)}
  .st-card{width:100%;max-width:28rem;background:var(--white);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--line)}
  .st-head{position:relative;text-align:center;color:#fff;padding:2.25rem 1.5rem 1.75rem;background:var(--acc);
    background-image:linear-gradient(150deg,color-mix(in srgb,var(--acc) 84%,#0a2342) 0%,color-mix(in srgb,var(--acc) 48%,#0a2342) 130%)}
  .st-avatar{width:86px;height:86px;margin:0 auto;border-radius:999px;display:flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,.2);box-shadow:0 0 0 6px rgba(255,255,255,.12)}
  .st-avatar .material-symbols-outlined{font-size:2.5rem;color:#fff}
  .st-chip{display:inline-flex;align-items:center;gap:.35rem;margin-top:.85rem;padding:.3rem .8rem;border-radius:999px;
    background:rgba(255,255,255,.2);font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .st-chip .material-symbols-outlined{font-size:.95rem;color:#fff}
  .st-name{font-family:'Sora',sans-serif;font-weight:800;color:#fff;font-size:1.9rem;line-height:1.12;letter-spacing:-.02em;margin-top:.5rem}
  .st-sub{font-size:.92rem;opacity:.9;margin-top:.3rem}
  .st-body{padding:1.5rem}
  .st-note{font-size:.95rem;line-height:1.6;color:var(--muted);text-align:center;margin-bottom:1rem}
  .st-field{padding:.75rem 0;border-bottom:1px solid var(--line)}
  .st-field:last-of-type{border-bottom:none}
  .st-label{display:flex;align-items:center;gap:.35rem;font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .st-label .material-symbols-outlined{font-size:1rem;color:var(--acc)}
  .st-value{font-size:1rem;color:var(--ink);margin-top:.2rem}
  .st-actions{display:flex;flex-direction:column;gap:.6rem;margin-top:1.25rem}
  .st-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.95rem 1.2rem;border-radius:999px;
    font-family:inherit;font-weight:700;font-size:1.05rem;border:none;cursor:pointer;transition:.15s;min-height:44px}
  .st-btn .material-symbols-outlined{font-size:1.25rem;color:currentColor}
  .st-btn-acc{background:var(--acc);color:#fff}
  .st-btn-acc:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .st-btn-out{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
  .st-btn-out:hover{border-color:var(--acc);color:var(--acc)}
  .st-foot{text-align:center;font-size:.72rem;color:var(--muted);margin-top:1.25rem;letter-spacing:.02em}
</style>

<div class="st-wrap" style="--acc:#ea580c;">
  <div class="st-card reveal">
    <div class="st-head">
      <div class="st-avatar"><span class="material-symbols-outlined">pets</span></div>
      <span class="st-chip"><span class="material-symbols-outlined">pets</span>I'm lost · Please help</span>
      <h1 class="st-name"><%= p.petName %></h1>
      <% if (p.species) { %><p class="st-sub"><%= p.species %></p><% } %>
    </div>

    <div class="st-body">
      <p class="st-note">Hi! I'm a little lost. If you found me, please call my family — they miss me!</p>

      <% if (p.medical) { %>
        <div class="st-field"><div class="st-label"><span class="material-symbols-outlined">medical_services</span>Medical notes</div><div class="st-value"><%= p.medical %></div></div>
      <% } %>
      <div class="st-field"><div class="st-label"><span class="material-symbols-outlined">person</span>My human</div><div class="st-value"><%= p.ownerName %></div></div>
      <% if (p.address) { %>
        <div class="st-field"><div class="st-label"><span class="material-symbols-outlined">home</span>Home</div><div class="st-value"><%= p.address %></div></div>
      <% } %>

      <div class="st-actions">
        <a href="tel:<%= p.contact %>" class="st-btn st-btn-acc"><span class="material-symbols-outlined">call</span>Call my family</a>
        <a href="https://wa.me/91<%= p.contact %>?text=<%= encodeURIComponent('Hi! I found your pet ' + (p.petName||'')) %>" class="st-btn st-btn-out"><span class="material-symbols-outlined">chat</span>Message on WhatsApp</a>
      </div>
    </div>
  </div>
  <p class="st-foot">Powered by SafeTag</p>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
