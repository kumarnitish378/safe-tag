<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell">
  <div class="w-full" style="max-width:26rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">🐾</div>
        <h1 class="id-name"><%= p.petName %></h1>
        <% if (p.species) { %><p class="id-sub"><%= p.species %></p><% } %>
        <span class="id-chip">LOST PET</span>
      </div>

      <div class="id-body">
        <div class="id-banner mb-3">👋 I'm lost! Please help me get home.</div>

        <% if (p.medical) { %>
          <div class="id-field"><div class="id-label">Medical notes</div><div class="id-value"><%= p.medical %></div></div>
        <% } %>
        <div class="id-field"><div class="id-label">Owner</div><div class="id-value"><%= p.ownerName %></div></div>
        <% if (p.address) { %>
          <div class="id-field"><div class="id-label">Home address</div><div class="id-value"><%= p.address %></div></div>
        <% } %>

        <div class="id-actions">
          <a href="tel:<%= p.contact %>" class="btn-brand btn-lq btn-pill">📞 Call the owner</a>
          <a href="https://wa.me/91<%= p.contact %>?text=<%= encodeURIComponent('Hi, I found your pet ' + (p.petName||'')) %>" class="btn-outline btn-pill">💬 WhatsApp the owner</a>
        </div>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
