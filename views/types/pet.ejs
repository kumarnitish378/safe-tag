<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="page-shell page-shell-compact">
  <div class="card overflow-hidden p-0 reveal">
    <div class="bg-brand text-white p-6 text-center">
      <div class="w-20 h-20 mx-auto rounded-full bg-white/20 flex items-center justify-center text-3xl">🐾</div>
      <h1 class="text-2xl font-bold mt-3"><%= p.petName %></h1>
      <% if (p.species) { %><p class="opacity-90 text-sm mt-1"><%= p.species %></p><% } %>
    </div>

    <div class="p-6 space-y-3">
      <div class="flash flash-info">👋 I'm lost! Please help me get home.</div>

      <% if (p.medical) { %>
        <div>
          <div class="label">Medical notes</div>
          <p class="text-sm text-slate-700"><%= p.medical %></p>
        </div>
      <% } %>

      <div>
        <div class="label">Owner</div>
        <p class="text-sm text-slate-700"><%= p.ownerName %></p>
      </div>
      <% if (p.address) { %>
        <div>
          <div class="label">Home address</div>
          <p class="text-sm text-slate-700"><%= p.address %></p>
        </div>
      <% } %>

      <div class="space-y-2 pt-1">
        <a href="tel:<%= p.contact %>" class="btn-brand btn-lq w-full justify-center">📞 Call the owner</a>
        <a href="https://wa.me/91<%= p.contact %>?text=<%= encodeURIComponent('Hi, I found your pet ' + (p.petName||'')) %>"
           class="btn-outline w-full justify-center">💬 WhatsApp the owner</a>
      </div>
    </div>
  </div>
  <p class="text-center text-xs text-slate-400 mt-4">Powered by SafeTag</p>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
