<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell">
  <div class="w-full" style="max-width:26rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">📱</div>
        <h1 class="id-name"><%= p.name %></h1>
        <% if (p.bio) { %><p class="id-sub"><%= p.bio %></p><% } %>
      </div>

      <div class="id-body">
        <%
          var links = [
            { url: p.instagram, label: 'Instagram', icon: '📷' },
            { url: p.youtube,   label: 'YouTube',   icon: '▶️' },
            { url: p.facebook,  label: 'Facebook',  icon: '👍' },
            { url: p.twitter,   label: 'X / Twitter', icon: '𝕏' },
            { url: p.linkedin,  label: 'LinkedIn',  icon: '💼' },
            { url: p.whatsapp ? ('https://wa.me/91' + p.whatsapp) : null, label: 'WhatsApp', icon: '💬' },
            { url: p.website,   label: 'Website',   icon: '🌐' }
          ].filter(function(l){ return l.url; });
        %>
        <% if (!links.length) { %>
          <p class="id-note">No links added yet.</p>
        <% } %>
        <div class="id-actions" style="margin-top:.25rem;">
          <% links.forEach(function(l){ %>
            <a href="<%= l.url %>" target="_blank" rel="noopener" class="btn-outline btn-pill"><%= l.icon %> <%= l.label %></a>
          <% }); %>
        </div>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
