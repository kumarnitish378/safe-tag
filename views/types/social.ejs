<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="scan-wrap" style="--acc:#8b5cf6;">
  <style>
    .scan-wrap{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:1.75rem 1.15rem;background:var(--cream);font-family:'Inter',system-ui,sans-serif}
    .scan-card{width:100%;max-width:28rem;background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden}
    .scan-head{text-align:center;padding:2.25rem 1.5rem 1.75rem;color:#fff;background:linear-gradient(150deg,#a78bfa 0%,#8b5cf6 55%,#6366f1 130%)}
    .scan-avatar{width:84px;height:84px;margin:0 auto 1rem;border-radius:9999px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.18);box-shadow:0 0 0 6px rgba(255,255,255,.12)}
    .scan-avatar .material-symbols-outlined{color:#fff;font-size:2.3rem}
    .scan-name{font-family:'Sora',system-ui,sans-serif;font-weight:800;font-size:1.55rem;line-height:1.15;letter-spacing:-.02em;color:#fff}
    .scan-bio{margin-top:.45rem;font-size:.95rem;line-height:1.5;color:rgba(255,255,255,.9)}
    .scan-body{padding:1.5rem}
    .link-list{display:flex;flex-direction:column;gap:.7rem}
    .link-btn{display:flex;align-items:center;gap:.75rem;min-height:48px;padding:.85rem 1.1rem;border-radius:14px;background:#fff;border:1.5px solid var(--line);color:var(--ink);font-weight:600;font-size:.98rem;transition:transform .14s,border-color .14s,box-shadow .14s}
    .link-btn:hover{transform:translateY(-2px);border-color:var(--acc);box-shadow:var(--shadow-sm)}
    .link-btn .ic{color:var(--acc);font-size:1.4rem}
    .link-btn .chev{margin-left:auto;color:var(--muted);font-size:1.2rem}
    .scan-empty{text-align:center;color:var(--muted);font-size:.95rem;padding:.75rem 0}
    .scan-foot{text-align:center;font-size:.72rem;color:var(--muted);letter-spacing:.02em;margin-top:1.35rem}
  </style>

  <div class="scan-card reveal">
    <div class="scan-head">
      <div class="scan-avatar"><span class="material-symbols-outlined">hub</span></div>
      <h1 class="scan-name"><%= p.name %></h1>
      <% if (p.bio) { %><p class="scan-bio"><%= p.bio %></p><% } %>
    </div>

    <div class="scan-body">
      <%
        var links = [
          { url: p.instagram, label: 'Instagram',   icon: 'photo_camera' },
          { url: p.youtube,   label: 'YouTube',      icon: 'play_circle' },
          { url: p.facebook,  label: 'Facebook',     icon: 'groups' },
          { url: p.twitter,   label: 'X / Twitter',  icon: 'alternate_email' },
          { url: p.linkedin,  label: 'LinkedIn',     icon: 'work' },
          { url: p.whatsapp ? ('https://wa.me/91' + p.whatsapp) : null, label: 'WhatsApp', icon: 'chat' },
          { url: p.website,   label: 'Website',      icon: 'language' }
        ].filter(function(l){ return l.url; });
      %>
      <% if (!links.length) { %><p class="scan-empty">No links added yet.</p><% } %>
      <div class="link-list">
        <% links.forEach(function(l){ %>
          <a href="<%= l.url %>" target="_blank" rel="noopener" class="link-btn">
            <span class="material-symbols-outlined ic"><%= l.icon %></span>
            <span><%= l.label %></span>
            <span class="material-symbols-outlined chev">chevron_right</span>
          </a>
        <% }); %>
      </div>
      <p class="scan-foot">Powered by SafeTag</p>
    </div>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
