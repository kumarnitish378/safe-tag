<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell" style="--acc:#f59e0b; --head-bg:linear-gradient(135deg,#334155 0%,#1e293b 60%,#0f172a 130%);">
  <div class="w-full" style="max-width:25rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">🚗</div>
        <h1 class="id-name" style="font-size:1.25rem;">Vehicle Owner</h1>
        <!-- license-plate motif -->
        <div style="display:inline-block;margin-top:.85rem;background:#facc15;color:#111827;font-family:ui-monospace,monospace;
                    font-weight:800;font-size:1.35rem;letter-spacing:.12em;padding:.45rem 1rem;border-radius:8px;
                    border:3px solid #111827;box-shadow:0 4px 0 rgba(0,0,0,.25);">
          <%= p.vehicleNo %>
        </div>
      </div>

      <div class="id-body">
        <p class="id-note">Registered to <strong><%= p.name %></strong></p>
        <% if (p.note) { %><p class="id-note mt-1" style="font-style:italic;">"<%= p.note %>"</p><% } %>

        <% if (notified) { %>
          <div class="text-center py-6">
            <div class="text-4xl">✅</div>
            <h2 class="font-semibold mt-2">Message sent</h2>
            <p class="text-sm text-slate-500 mt-1">The owner has been notified. Thank you!</p>
          </div>
        <% } else { %>
          <form method="POST" action="/t/<%= tag_id %>/notify" class="space-y-3 mt-4">
            <%- include('../layout/_csrf') %>
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div>
              <label class="label">Message to the owner</label>
              <textarea class="input" name="message" rows="3" required maxlength="1000"
                placeholder="e.g. Your lights are on / you're blocking the exit"></textarea>
            </div>
            <div>
              <label class="label">How can they reach you? (optional)</label>
              <input class="input" name="reply" maxlength="120" placeholder="Phone or email" />
            </div>
            <button type="submit" class="btn-acc" style="color:#111827;">📨 Notify the owner</button>
            <p class="text-xs text-slate-400 text-center">🔒 The owner's number stays private.</p>
          </form>
        <% } %>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
