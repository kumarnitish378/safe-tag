<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="page-shell page-shell-compact">
  <div class="card overflow-hidden p-0 reveal">
    <div class="bg-brand text-white p-6 text-center">
      <div class="w-20 h-20 mx-auto rounded-full bg-white/20 flex items-center justify-center text-3xl">💼</div>
      <h1 class="text-2xl font-bold mt-3"><%= p.name %></h1>
      <% if (p.title || p.company) { %>
        <p class="opacity-90 text-sm mt-1"><%= [p.title, p.company].filter(Boolean).join(' · ') %></p>
      <% } %>
    </div>

    <div class="p-6 space-y-3">
      <% if (p.about) { %><p class="text-slate-600 text-sm leading-relaxed"><%= p.about %></p><% } %>

      <div class="space-y-2">
        <% if (p.phone) { %>
          <a href="tel:<%= p.phone %>" class="btn-brand btn-lq w-full justify-center">📞 Call</a>
        <% } %>
        <% if (p.phone) { %>
          <a href="https://wa.me/91<%= p.phone %>" class="btn-outline w-full justify-center">💬 WhatsApp</a>
        <% } %>
        <% if (p.email) { %>
          <a href="mailto:<%= p.email %>" class="btn-outline w-full justify-center">✉️ Email</a>
        <% } %>
        <% if (p.website) { %>
          <a href="<%= p.website %>" target="_blank" rel="noopener" class="btn-outline w-full justify-center">🌐 Website</a>
        <% } %>
      </div>

      <button onclick="saveContact()" class="btn-brand btn-lq w-full justify-center mt-2">⬇️ Save Contact</button>
    </div>
  </div>
  <p class="text-center text-xs text-slate-400 mt-4">Powered by SafeTag</p>
</div>

<script>
  function saveContact() {
    var lines = [
      'BEGIN:VCARD','VERSION:3.0',
      'FN:<%= (p.name||"").replace(/[\r\n]/g," ") %>',
      <% if (p.company) { %>'ORG:<%= (p.company||"").replace(/[\r\n]/g," ") %>',<% } %>
      <% if (p.title) { %>'TITLE:<%= (p.title||"").replace(/[\r\n]/g," ") %>',<% } %>
      <% if (p.phone) { %>'TEL;TYPE=CELL:<%= p.phone %>',<% } %>
      <% if (p.email) { %>'EMAIL:<%= p.email %>',<% } %>
      <% if (p.website) { %>'URL:<%= p.website %>',<% } %>
      'END:VCARD'
    ];
    var blob = new Blob([lines.join('\n')], { type: 'text/vcard' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = '<%= (p.name||"contact").replace(/[^a-zA-Z0-9]/g,"_") %>.vcf';
    a.click();
  }
</script>

<%- include('../layout/_foot', { hideFooter: true }) %>
