<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<style>
  .st-wrap{--acc:#4f46e5;min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:var(--cream)}
  .st-card{width:100%;max-width:28rem;background:var(--white);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--line)}
  .st-head{position:relative;text-align:center;color:#fff;padding:2.25rem 1.5rem 1.75rem;background:var(--acc);
    background-image:linear-gradient(150deg,color-mix(in srgb,var(--acc) 84%,#0a2342) 0%,color-mix(in srgb,var(--acc) 48%,#0a2342) 130%)}
  .st-avatar{width:86px;height:86px;margin:0 auto;border-radius:999px;display:flex;align-items:center;justify-content:center;
    font-family:'Sora',sans-serif;font-weight:800;font-size:2.2rem;letter-spacing:.01em;color:#fff;
    background:rgba(255,255,255,.2);box-shadow:0 0 0 6px rgba(255,255,255,.12)}
  .st-name{font-family:'Sora',sans-serif;font-weight:800;color:#fff;font-size:1.5rem;line-height:1.15;letter-spacing:-.02em;margin-top:.9rem}
  .st-sub{font-size:.92rem;opacity:.9;margin-top:.3rem}
  .st-chip{display:inline-flex;align-items:center;gap:.35rem;margin-top:.85rem;padding:.3rem .8rem;border-radius:999px;
    background:rgba(255,255,255,.2);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .st-chip .material-symbols-outlined{font-size:.95rem;color:#fff}
  .st-body{padding:1.5rem}
  .st-note{font-size:.95rem;line-height:1.6;color:var(--muted);text-align:center;margin-bottom:1rem}
  .st-field{padding:.75rem 0;border-bottom:1px solid var(--line)}
  .st-field:last-of-type{border-bottom:none}
  .st-label{display:flex;align-items:center;gap:.35rem;font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .st-label .material-symbols-outlined{font-size:1rem;color:var(--acc)}
  .st-value{font-size:1rem;color:var(--ink);margin-top:.2rem}
  .st-actions{display:flex;flex-direction:column;gap:.6rem;margin-top:1.25rem}
  .st-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.85rem 1.2rem;border-radius:999px;
    font-family:inherit;font-weight:700;font-size:1rem;border:none;cursor:pointer;transition:.15s;min-height:44px}
  .st-btn .material-symbols-outlined{font-size:1.2rem;color:currentColor}
  .st-btn-acc{background:var(--acc);color:#fff}
  .st-btn-acc:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .st-btn-out{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
  .st-btn-out:hover{border-color:var(--acc);color:var(--acc)}
  .st-foot{text-align:center;font-size:.72rem;color:var(--muted);margin-top:1.25rem;letter-spacing:.02em}
</style>

<div class="st-wrap" style="--acc:#4f46e5;">
  <div class="st-card reveal">
    <div class="st-head">
      <div class="st-avatar"><%= (p.name||'?').trim().charAt(0).toUpperCase() %></div>
      <h1 class="st-name"><%= p.name %></h1>
      <% if (p.title || p.company) { %><p class="st-sub"><%= [p.title, p.company].filter(Boolean).join(' · ') %></p><% } %>
      <span class="st-chip"><span class="material-symbols-outlined">badge</span>Digital Card</span>
    </div>

    <div class="st-body">
      <% if (p.about) { %><p class="st-note"><%= p.about %></p><% } %>

      <% if (p.phone) { %><div class="st-field"><div class="st-label"><span class="material-symbols-outlined">call</span>Phone</div><div class="st-value">+91 <%= p.phone %></div></div><% } %>
      <% if (p.email) { %><div class="st-field"><div class="st-label"><span class="material-symbols-outlined">mail</span>Email</div><div class="st-value"><%= p.email %></div></div><% } %>
      <% if (p.website) { %><div class="st-field"><div class="st-label"><span class="material-symbols-outlined">language</span>Website</div><div class="st-value" style="word-break:break-all;"><%= p.website %></div></div><% } %>

      <div class="st-actions">
        <button onclick="saveContact()" class="st-btn st-btn-acc"><span class="material-symbols-outlined">download</span>Save to Contacts</button>
        <% if (p.phone) { %><a href="tel:<%= p.phone %>" class="st-btn st-btn-out"><span class="material-symbols-outlined">call</span>Call</a><% } %>
        <% if (p.phone) { %><a href="https://wa.me/91<%= p.phone %>" class="st-btn st-btn-out"><span class="material-symbols-outlined">chat</span>WhatsApp</a><% } %>
        <% if (p.email) { %><a href="mailto:<%= p.email %>" class="st-btn st-btn-out"><span class="material-symbols-outlined">mail</span>Email</a><% } %>
      </div>
    </div>
  </div>
  <p class="st-foot">Powered by SafeTag</p>
</div>

<script>
  function saveContact() {
    var lines = ['BEGIN:VCARD','VERSION:3.0','FN:<%= (p.name||"").replace(/[\r\n]/g," ") %>',
      <% if (p.company) { %>'ORG:<%= (p.company||"").replace(/[\r\n]/g," ") %>',<% } %>
      <% if (p.title) { %>'TITLE:<%= (p.title||"").replace(/[\r\n]/g," ") %>',<% } %>
      <% if (p.phone) { %>'TEL;TYPE=CELL:<%= p.phone %>',<% } %>
      <% if (p.email) { %>'EMAIL:<%= p.email %>',<% } %>
      <% if (p.website) { %>'URL:<%= p.website %>',<% } %>
      'END:VCARD'];
    var blob = new Blob([lines.join('\n')], { type: 'text/vcard' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = '<%= (p.name||"contact").replace(/[^a-zA-Z0-9]/g,"_") %>.vcf';
    a.click();
  }
</script>

<%- include('../layout/_foot', { hideFooter: true }) %>
