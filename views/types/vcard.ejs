<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell">
  <div class="w-full" style="max-width:26rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">💼</div>
        <h1 class="id-name"><%= p.name %></h1>
        <% if (p.title || p.company) { %>
          <p class="id-sub"><%= [p.title, p.company].filter(Boolean).join(' · ') %></p>
        <% } %>
      </div>

      <div class="id-body">
        <% if (p.about) { %><p class="id-note mb-4"><%= p.about %></p><% } %>

        <div class="id-actions">
          <% if (p.phone) { %><a href="tel:<%= p.phone %>" class="btn-brand btn-lq btn-pill">📞 Call</a><% } %>
          <% if (p.phone) { %><a href="https://wa.me/91<%= p.phone %>" class="btn-outline btn-pill">💬 WhatsApp</a><% } %>
          <% if (p.email) { %><a href="mailto:<%= p.email %>" class="btn-outline btn-pill">✉️ Email</a><% } %>
          <% if (p.website) { %><a href="<%= p.website %>" target="_blank" rel="noopener" class="btn-outline btn-pill">🌐 Website</a><% } %>
          <button onclick="saveContact()" class="btn-brand btn-lq btn-pill">⬇️ Save Contact</button>
        </div>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<script>
  function saveContact() {
    var lines = [
      'BEGIN:VCARD','VERSION:3.0',
      'FN:<%= (p.name||"").replace(/[\r\n]/g," ") %>',
      <% if (p.company) { %>'ORG:<%= (p.company||"").replace(/[\r\n]/g," ") %>',<% } %>
      <% if (p.title) { %>'TITLE:<%= (p.title||"").replace(/[\r\n]/g," ") %>',<% } %>
      <% if (p.phone) { %>'TEL;TYPE=CELL:<%= p.phone %>',<% } %>
      <% if (p.email) { %>'EMAIL:<%= p.email %>',<% } %>
      <% if (p.website) { %>'URL:<%= p.website %>',<% } %>
      'END:VCARD'
    ];
    var blob = new Blob([lines.join('\n')], { type: 'text/vcard' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = '<%= (p.name||"contact").replace(/[^a-zA-Z0-9]/g,"_") %>.vcf';
    a.click();
  }
</script>

<%- include('../layout/_foot', { hideFooter: true }) %>
