<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="page-shell page-shell-compact">
  <div class="card overflow-hidden p-0 reveal">
    <div class="bg-brand text-white p-6 text-center">
      <div class="w-20 h-20 mx-auto rounded-full bg-white/20 flex items-center justify-center text-3xl">🛍️</div>
      <h1 class="text-2xl font-bold mt-3"><%= p.business %></h1>
    </div>

    <div class="p-6 space-y-4">
      <% if (p.about) { %><p class="text-slate-600 text-sm leading-relaxed text-center"><%= p.about %></p><% } %>

      <% if (Array.isArray(p.products) && p.products.length) { %>
        <div>
          <div class="label">Products</div>
          <ul class="mt-1 space-y-1">
            <% p.products.forEach(function(item){ %>
              <li class="text-sm text-slate-700 flex items-center gap-2"><span class="text-brand">•</span><%= item %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <div class="space-y-2 pt-1">
        <% if (p.phone) { %><a href="tel:<%= p.phone %>" class="btn-brand btn-lq w-full justify-center">📞 Call</a><% } %>
        <% if (p.whatsapp) { %><a href="https://wa.me/91<%= p.whatsapp %>" class="btn-outline w-full justify-center">💬 WhatsApp</a><% } %>
        <% if (p.website) { %><a href="<%= p.website %>" target="_blank" rel="noopener" class="btn-outline w-full justify-center">🌐 Visit Website</a><% } %>
      </div>
    </div>
  </div>
  <p class="text-center text-xs text-slate-400 mt-4">Powered by SafeTag</p>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
