<%- include('../layout/_head', { hideNav: true, hideFooter: true }) %>

<div class="id-shell">
  <div class="w-full" style="max-width:26rem;">
    <div class="id-card reveal">
      <div class="id-head">
        <div class="id-avatar">🛍️</div>
        <h1 class="id-name"><%= p.business %></h1>
      </div>

      <div class="id-body">
        <% if (p.about) { %><p class="id-note mb-4"><%= p.about %></p><% } %>

        <% if (Array.isArray(p.products) && p.products.length) { %>
          <div class="id-field">
            <div class="id-label">Products</div>
            <ul class="mt-1 space-y-1">
              <% p.products.forEach(function(item){ %>
                <li class="id-value flex items-center gap-2"><span class="text-brand">•</span><%= item %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <div class="id-actions">
          <% if (p.phone) { %><a href="tel:<%= p.phone %>" class="btn-brand btn-lq btn-pill">📞 Call</a><% } %>
          <% if (p.whatsapp) { %><a href="https://wa.me/91<%= p.whatsapp %>" class="btn-outline btn-pill">💬 WhatsApp</a><% } %>
          <% if (p.website) { %><a href="<%= p.website %>" target="_blank" rel="noopener" class="btn-outline btn-pill">🌐 Visit Website</a><% } %>
        </div>
      </div>
    </div>
    <p class="id-foot">Powered by SafeTag</p>
  </div>
</div>

<%- include('../layout/_foot', { hideFooter: true }) %>
