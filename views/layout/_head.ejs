<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- Anti-flash: apply saved lang before any paint. Light-only design system. -->
  <script>
    (function(){
      try {
        document.documentElement.classList.remove('dark'); // no dark theme anymore
        if (localStorage.safetagLang === 'hi') document.documentElement.setAttribute('lang','hi');
      } catch(e) {}
    })();
  </script>

  <%
    var _title = (typeof title !== 'undefined' && title) ? title : 'SafeTag Emergency ID Tags India | QR + NFC Medical ID';
    var _desc  = (typeof seoDesc !== 'undefined' && seoDesc) ? seoDesc
               : 'Buy QR + NFC emergency ID tags in India. One scan shows blood group, allergies and contacts in seconds. No app needed for families or first responders.';
    var _image = (typeof seoImage !== 'undefined' && seoImage) ? seoImage : '/static/images/og-homepage.jpg';
  %>

  <title><%= _title %></title>
  <meta name="description" content="<%= _desc %>" />
  <meta name="author" content="SafeTag" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="keywords" content="SafeTag, emergency ID tag India, QR code emergency tag, NFC emergency ID, RFID tag India, child safety tag, lost child identification, elderly ID tag, medical alert tag, emergency contact tag, QR sticker India, NFC wristband India, buy emergency tag India, child safety ID card, dementia patient ID tag, pet safety tag India, solo traveler ID tag, school safety tag India" />
  <meta name="robots" content="<%= (typeof noIndex !== 'undefined' && noIndex) ? 'noindex, nofollow' : 'index, follow' %>" />
  <link rel="canonical" href="<%= baseUrl + path %>" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content="<%= _title %>" />
  <meta property="og:description" content="<%= _desc %>" />
  <meta property="og:image"       content="<%= baseUrl + _image %>" />
  <meta property="og:url"         content="<%= baseUrl + path %>" />
  <meta property="og:site_name"   content="SafeTag" />
  <meta property="og:locale"      content="en_IN" />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="<%= _title %>" />
  <meta name="twitter:description" content="<%= _desc %>" />
  <meta name="twitter:image"       content="<%= baseUrl + _image %>" />

  <!-- Brand / PWA -->
  <meta name="theme-color" content="#0D9488" />
  <meta name="application-name" content="SafeTag" />
  <link rel="icon" href="/static/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/static/favicon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <!-- Liquid UI design system (always loaded) -->
  <link rel="stylesheet" href="/static/css/liquid.css" />

  <% if (IS_PROD) { %>
  <!-- Production: Tailwind CLI-built CSS (~20-50 KB, only used classes) -->
  <link rel="stylesheet" href="/static/css/safetag.build.css" />
  <% } else { %>
  <!-- Dev: Tailwind CDN for rapid iteration (no build step needed) -->
  <script>
    tailwind = { config: {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand:   { DEFAULT: '#0D9488', 700: '#0F766E' },
            navy:    { DEFAULT: '#0A2342', 700: '#0B1E3D' },
            danger:  { DEFAULT: '#EF4444' },
            success: { DEFAULT: '#22C55E' },
            warning: { DEFAULT: '#F97316' },
            body:    { DEFAULT: '#475569' },
          },
          fontFamily: {
            sora: ['Sora', 'sans-serif'],
            dm:   ['"DM Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          borderRadius: { card: '12px', cardLg: '16px', pill: '20px' },
          boxShadow:    { soft: '0 1px 4px rgba(0,0,0,0.08)' },
        }
      }
    }};
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/static/css/safetag.css" />
  <% } %>
  <style>
    html, body { font-family: 'DM Sans', system-ui, sans-serif; color: #475569; }
    h1, h2, h3, h4, h5 { font-family: 'Sora', sans-serif; color: #0A2342; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .btn-brand  { background:#0D9488; color:#fff; padding:.75rem 1.25rem; border-radius:8px; font-weight:600; display:inline-flex; align-items:center; gap:.5rem; transition:.15s; }
    .btn-brand:hover  { background:#0F766E; }
    .btn-warn   { background:#F97316; color:#fff; padding:.75rem 1.25rem; border-radius:8px; font-weight:700; display:inline-flex; align-items:center; gap:.5rem; transition:.15s; }
    .btn-warn:hover   { background:#EA580C; }
    .btn-outline{ background:transparent; color:#0A2342; padding:.7rem 1.2rem; border-radius:8px; border:1px solid #cbd5e1; font-weight:600; display:inline-flex; align-items:center; justify-content:center; gap:.5rem; transition:.15s; }
    .btn-outline:hover{ border-color:#0D9488; color:#0D9488; }
    .btn-danger { background:#EF4444; color:#fff; padding:.75rem 1.25rem; border-radius:8px; font-weight:600; transition:.15s; }
    .btn-danger:hover { background:#dc2626; }

    /* ── Modern scan-page (tag profile) cards ───────────────────────── */
    .id-shell{ min-height:100dvh; display:flex; align-items:center; justify-content:center; padding:1.25rem; }
    .id-card{ width:100%; max-width:26rem; border-radius:26px; overflow:hidden; background:#fff;
              box-shadow:0 24px 70px rgba(2,6,23,.14); border:1px solid rgba(15,23,42,.06); }
    html.dark .id-card{ background:#0f172a; border-color:rgba(148,163,184,.14); box-shadow:0 24px 70px rgba(0,0,0,.55); }
    .id-head{ padding:2rem 1.5rem 1.75rem; text-align:center; color:#fff;
              background:var(--head-bg, linear-gradient(150deg,#0D9488 0%,#0f766e 55%,#0A2342 130%)); }
    /* per-type accent button (primary action coloured by --acc) */
    .btn-acc{ width:100%; justify-content:center; display:inline-flex; align-items:center; gap:.5rem;
              border-radius:9999px; padding:.8rem 1.2rem; font-weight:700; color:#fff;
              background:var(--acc,#0D9488); border:none; cursor:pointer; transition:.15s; }
    .btn-acc:hover{ filter:brightness(1.08); }
    .id-chip.acc{ background:rgba(255,255,255,.18); }
    .id-avatar{ width:88px; height:88px; margin:0 auto; border-radius:9999px; display:flex;
              align-items:center; justify-content:center; font-size:2.1rem;
              background:rgba(255,255,255,.18); box-shadow:0 0 0 6px rgba(255,255,255,.12); backdrop-filter:blur(4px); }
    .id-avatar img{ width:100%; height:100%; object-fit:cover; border-radius:9999px; }
    .id-name{ font-family:'Sora',system-ui,sans-serif; font-weight:800; font-size:1.5rem; line-height:1.15; margin-top:.85rem; }
    .id-sub{ font-size:.9rem; opacity:.92; margin-top:.3rem; }
    .id-chip{ display:inline-block; margin-top:.65rem; padding:.25rem .7rem; border-radius:9999px;
              background:rgba(255,255,255,.16); font-size:.72rem; font-weight:700; letter-spacing:.12em; }
    .id-body{ padding:1.5rem; }
    .id-note{ font-size:.9rem; line-height:1.6; color:#475569; text-align:center; }
    html.dark .id-note{ color:#94a3b8; }
    .id-field{ padding:.7rem 0; border-bottom:1px solid rgba(15,23,42,.07); }
    html.dark .id-field{ border-color:rgba(148,163,184,.14); }
    .id-field:last-of-type{ border-bottom:none; }
    .id-label{ font-size:.68rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:#94a3b8; }
    .id-value{ font-size:.98rem; color:#0f172a; margin-top:.15rem; }
    html.dark .id-value{ color:#e2e8f0; }
    .id-actions{ display:flex; flex-direction:column; gap:.55rem; margin-top:1.1rem; }
    .id-banner{ border-radius:14px; padding:.7rem .9rem; font-size:.85rem; font-weight:600; text-align:center;
              background:#ecfeff; color:#0f766e; border:1px solid rgba(13,148,136,.2); }
    html.dark .id-banner{ background:rgba(13,148,136,.12); color:#5eead4; }
    .id-foot{ text-align:center; font-size:.72rem; color:#94a3b8; margin-top:1.1rem; letter-spacing:.02em; }
    .btn-pill{ width:100%; justify-content:center; border-radius:9999px; padding-top:.8rem; padding-bottom:.8rem; }
    .card  { background:#fff; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,0.08); }
    .input { width:100%; padding:.7rem .9rem; border:1px solid #e2e8f0; border-radius:8px; background:#fff; color:#0A2342; font-family:inherit; }
    .input:focus { outline:none; border-color:#0D9488; box-shadow:0 0 0 3px rgba(13,148,136,.15); }
    .label { display:block; font-weight:600; color:#0A2342; margin-bottom:.4rem; font-size:.9rem; }
    .field-error { color:#EF4444; font-size:.85rem; margin-top:.25rem; }
    .pill { padding:.25rem .7rem; border-radius:20px; font-size:.78rem; font-weight:600; display:inline-flex; align-items:center; gap:.3rem; }
    .pill-success { background:#dcfce7; color:#166534; }
    .pill-warning { background:#fef3c7; color:#92400e; }
    .pill-danger  { background:#fee2e2; color:#991b1b; }
    .pill-brand   { background:#ccfbf1; color:#115e59; }
    .pill-mono    { background:#f1f5f9; color:#0A2342; font-family:'JetBrains Mono',monospace; }
    .navlink { padding:.5rem .8rem; color:#0A2342; font-weight:500; border-radius:8px; transition:.1s; }
    .navlink:hover { background:#f1f5f9; color:#0D9488; }
    .flash { padding:.8rem 1rem; border-radius:8px; margin-bottom:1rem; display:flex; gap:.6rem; align-items:flex-start; }
    .flash-success { background:#dcfce7; color:#166534; }
    .flash-error   { background:#fee2e2; color:#991b1b; }
    .flash-info    { background:#dbeafe; color:#1e40af; }
    .table { width:100%; border-collapse:collapse; }
    .table th, .table td { padding:.6rem .8rem; text-align:left; border-bottom:1px solid #e2e8f0; font-size:.9rem; }
    .table th { color:#0A2342; font-weight:700; background:#f8fafc; font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; }
    /* Toast */
    .toast { display:flex; align-items:flex-start; gap:.6rem; padding:.85rem 1rem; border-radius:10px; box-shadow:0 4px 20px rgba(0,0,0,.18); font-size:.9rem; font-weight:500; transition:opacity .4s, transform .4s; pointer-events:auto; }
    .toast-success { background:#dcfce7; color:#166534; border-left:4px solid #22c55e; }
    .toast-error   { background:#fee2e2; color:#991b1b; border-left:4px solid #ef4444; }
    .toast-info    { background:#dbeafe; color:#1e40af; border-left:4px solid #3b82f6; }
    .toast button  { background:none; border:none; cursor:pointer; font-size:1.2rem; line-height:1; padding:0 0 0 4px; opacity:.5; }
    .toast button:hover { opacity:1; }
    /* Stepper (register_tag) */
    .stepper-step  { display:flex; flex-direction:column; align-items:center; gap:4px; }
    .stepper-bubble{ width:28px; height:28px; border-radius:50%; background:#e2e8f0; color:#64748b; font-weight:700; font-size:.85rem; display:flex; align-items:center; justify-content:center; }
    .stepper-bubble.active { background:#0D9488; color:#fff; }
    .stepper-label { font-size:.7rem; color:#64748b; font-weight:500; }
    .stepper-line  { flex:1; height:2px; background:#e2e8f0; margin-bottom:18px; }
    /* ---- Scrollbar hiding utility ---- */
    .scrollbar-none { -ms-overflow-style:none; scrollbar-width:none; }
    .scrollbar-none::-webkit-scrollbar { display:none; }
    /* ---- Always-dark sections: force bg + text so non-layered h2{color} doesn't win over @layer utilities ---- */
    /* Hero gradient */
    .hero-grad { background: linear-gradient(135deg, #0A2342 0%, #0B1E3D 55%, #091224 100%) !important; }
    .hero-grad h1,.hero-grad h2,.hero-grad blockquote { color:#fff !important; }
    .hero-grad .text-slate-300 { color:#cbd5e1 !important; }
    .hero-grad .text-teal-300 { color:#5eead4 !important; }
    .hero-grad .text-slate-400 { color:#94a3b8 !important; }
    /* bg-navy sections (story, manufacturer etc.) */
    section.bg-navy { background:#0A2342 !important; }
    section.bg-navy h1,section.bg-navy h2,section.bg-navy h3,
    section.bg-navy h4,section.bg-navy h5 { color:#fff !important; }
    section.bg-navy .text-slate-300 { color:#cbd5e1 !important; }
    section.bg-navy .text-teal-300 { color:#5eead4 !important; }
    section.bg-navy .text-slate-600 { color:#cbd5e1 !important; }
    /* Final CTA gradient (from-brand to-[#0F766E]) */
    .cta-grad { background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%) !important; }
    .cta-grad h1,.cta-grad h2 { color:#fff !important; }
    .cta-grad p,.cta-grad .text-teal-100 { color:#ccfbf1 !important; }
    .cta-grad .text-teal-200 { color:#99f6e4 !important; }
    /* Footer always dark */
    footer.bg-navy { background:#1e293b !important; }
    footer.bg-navy h4 { color:#fff !important; }
    footer.bg-navy .text-slate-300 { color:#94a3b8 !important; }
    footer.bg-navy .text-slate-500 { color:#64748b !important; }
    /* ---- Dark mode overrides ---- */
    html.dark body { background:#0f172a; color:#94a3b8; }
    html.dark h1,html.dark h2,html.dark h3,html.dark h4,html.dark h5 { color:#f1f5f9; }
    html.dark .card { background:#1e293b; box-shadow:0 1px 6px rgba(0,0,0,.35); }
    html.dark .input { background:#1e293b; border-color:#334155; color:#f1f5f9; }
    html.dark .input:focus { border-color:#0D9488; }
    html.dark .label { color:#e2e8f0; }
    html.dark .navlink { color:#cbd5e1; }
    html.dark .navlink:hover { background:#1e293b; color:#5eead4; }
    html.dark .btn-outline { color:#e2e8f0; border-color:#475569; }
    html.dark .btn-outline:hover { border-color:#0D9488; color:#0D9488; }
    html.dark .table th { background:#1e293b; color:#f1f5f9; }
    html.dark .table td { border-color:#334155; }
    html.dark .table tr:hover td { background:#253349; }
    html.dark .flash-success { background:#14532d; color:#bbf7d0; }
    html.dark .flash-error { background:#7f1d1d; color:#fecaca; }
    html.dark .flash-info { background:#1e3a5f; color:#bfdbfe; }
    html.dark select.input option { background:#1e293b; }
    html.dark .bg-slate-50 { background:#0f172a !important; }
    html.dark .bg-slate-100 { background:#253349 !important; }
    /* sections go DARKER than cards so cards remain visible — hierarchy: body#0f172a < section#0f172a < card#1e293b */
    html.dark section.bg-white, html.dark .page-bg-white { background:#0f172a !important; }
    html.dark footer.bg-navy { background:#1e293b !important; }
    /* Bug fix: both selectors must be scoped to html.dark — comma-split was breaking light mode borders */
    html.dark .border-slate-100, html.dark .border-slate-200 { border-color:#334155 !important; }
    html.dark .text-slate-500 { color:#94a3b8; }
    html.dark .text-slate-600 { color:#94a3b8; }
    html.dark .text-slate-700 { color:#cbd5e1; }
    html.dark .section-inner .text-slate-500 { color:#94a3b8; }
    /* text-navy on divs/spans/summaries not covered by the h1-h5 rule */
    html.dark .text-navy { color:#e2e8f0 !important; }
    /* light-card: white cards on dark hero — keep body text dark so it's readable on white bg */
    html.dark .light-card .text-slate-700 { color:#374151 !important; }
    html.dark .light-card .text-slate-400 { color:#9ca3af !important; }
    html.dark .light-card .text-slate-600 { color:#4b5563 !important; }

    /* ---- Emergency page themes ---- */
    /* Default (classic) values are the SafeTag brand palette */
    .epage { --ep-top-bg:#0D9488; --ep-top-text:#fff; --ep-alert-bg:#EF4444; --ep-alert-text:#fff; --ep-id-bg:#0A2342; --ep-id-text:#fff; --ep-call-bg:#22C55E; --ep-call-hover:#16A34A; --ep-accent:#0D9488; --ep-page-bg:#EAEFF4; }
    .epage[data-theme="guardian"] { --ep-top-bg:#1e293b; --ep-top-text:#e2e8f0; --ep-alert-bg:#7f1d1d; --ep-alert-text:#fee2e2; --ep-id-bg:#0f172a; --ep-id-text:#f1f5f9; --ep-call-bg:#16A34A; --ep-call-hover:#15803D; --ep-accent:#38bdf8; --ep-page-bg:#1e293b; }
    .epage[data-theme="care"]     { --ep-top-bg:#ea580c; --ep-top-text:#fff; --ep-alert-bg:#dc2626; --ep-alert-text:#fff; --ep-id-bg:#7c2d12; --ep-id-text:#fff; --ep-call-bg:#16a34a; --ep-call-hover:#15803d; --ep-accent:#ea580c; --ep-page-bg:#fff7ed; }
    .epage[data-theme="medical"]  { --ep-top-bg:#1d4ed8; --ep-top-text:#fff; --ep-alert-bg:#b91c1c; --ep-alert-text:#fff; --ep-id-bg:#1e3a8a; --ep-id-text:#fff; --ep-call-bg:#16a34a; --ep-call-hover:#15803d; --ep-accent:#3b82f6; --ep-page-bg:#eff6ff; }
    .epage[data-theme="adventure"]{ --ep-top-bg:#166534; --ep-top-text:#fff; --ep-alert-bg:#dc2626; --ep-alert-text:#fff; --ep-id-bg:#14532d; --ep-id-text:#f0fdf4; --ep-call-bg:#16a34a; --ep-call-hover:#15803d; --ep-accent:#22c55e; --ep-page-bg:#f0fdf4; }
    .epage[data-theme="rose"]     { --ep-top-bg:#be123c; --ep-top-text:#fff; --ep-alert-bg:#9f1239; --ep-alert-text:#fff; --ep-id-bg:#881337; --ep-id-text:#fff; --ep-call-bg:#16a34a; --ep-call-hover:#15803d; --ep-accent:#fb7185; --ep-page-bg:#fff1f2; }
    /* Utility classes that read the CSS vars — used only inside .epage */
    .ep-top-bar   { background:var(--ep-top-bg) !important; color:var(--ep-top-text) !important; }
    .ep-alert-bar { background:var(--ep-alert-bg) !important; color:var(--ep-alert-text) !important; }
    .ep-id-header { background:var(--ep-id-bg) !important; color:var(--ep-id-text) !important; }
    .ep-call-btn  { background:var(--ep-call-bg) !important; color:#fff !important; }
    .ep-call-btn:hover { background:var(--ep-call-hover) !important; }
    .ep-page-bg   { background:var(--ep-page-bg) !important; }
    .ep-accent-text { color:var(--ep-accent) !important; }
  </style>
  <%- typeof head !== 'undefined' ? head : '' %>

  <!-- JSON-LD Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SafeTag",
    "url": "<%= baseUrl %>",
    "logo": "<%= baseUrl %>/static/images/websiteLogo.png",
    "description": "India's QR + NFC emergency identity tag for children, elderly, and pets.",
    "contactPoint": { "@type": "ContactPoint", "email": "support@safe-tag.in", "contactType": "customer support" }
  }
  </script>

  <!-- JSON-LD WebSite (enables Google Sitelinks Searchbox) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SafeTag",
    "url": "<%= baseUrl %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "<%= baseUrl %>/store?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <!-- Theme + Language runtime (called by navbar buttons; also on DOMContentLoaded) -->
  <script>
