      'btn.buy':'Get SafeTag Now — from ₹149','btn.demo':'See It Work First',
    },
    hi:{
      'nav.store':'स्टोर','nav.how':'कैसे काम करता है','nav.faq':'सवाल जवाब',
      'nav.manufacturer':'निर्माता','nav.dashboard':'डैशबोर्ड',
      'nav.admin':'एडमिन','nav.login':'लॉगिन','nav.signout':'साइन आउट',
      'nav.gettag':'टैग पाएं','nav.workshop':'मेरी वर्कशॉप',
