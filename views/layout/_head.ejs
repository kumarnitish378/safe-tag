<body class="min-h-screen flex flex-col" style="background:var(--white)">

<% if (typeof hideNav === 'undefined' || !hideNav) { %>
  <%- include('_navbar') %>
<% } %>

<!-- Toast container — fixed top-right, auto-dismiss -->
<% if ((flash.success && flash.success.length) || (flash.error && flash.error.length) || (flash.info && flash.info.length)) { %>
<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2" style="max-width:360px; pointer-events:none;">
  <% flash.success.forEach(function(m){ %>
    <div class="toast toast-success">
      <span>✅</span><span class="flex-1"><%= m %></span>
      <button onclick="this.parentElement.remove()" title="Dismiss">&times;</button>
    </div>
  <% }); %>
  <% flash.error.forEach(function(m){ %>
    <div class="toast toast-error">
      <span>⚠️</span><span class="flex-1"><%= m %></span>
      <button onclick="this.parentElement.remove()" title="Dismiss">&times;</button>
    </div>
  <% }); %>
  <% flash.info.forEach(function(m){ %>
    <div class="toast toast-info">
      <span>ℹ️</span><span class="flex-1"><%= m %></span>
      <button onclick="this.parentElement.remove()" title="Dismiss">&times;</button>
    </div>
  <% }); %>
</div>
<script>
  document.querySelectorAll('#toast-container .toast').forEach(function(el) {
    setTimeout(function() { el.style.opacity='0'; setTimeout(function(){ el.remove(); }, 400); }, 4500);
  });
</script>
<% } %>

