<nav class="lq-nav sticky top-0 z-30">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-2">
    <a href="/" class="flex items-center flex-shrink-0">
      <img src="/static/images/websiteLogo.png" alt="SafeTag" class="h-9 w-auto object-contain" onerror="this.style.display='none'" />
    </a>
    <div class="hidden md:flex items-center gap-0.5 ml-3">
      <a class="navlink dark:text-slate-200 dark:hover:bg-slate-700" href="/store" data-i18n="nav.store">Store</a>
      <a class="navlink dark:text-slate-200 dark:hover:bg-slate-700" href="/#how" data-i18n="nav.how">How it Works</a>
      <a class="navlink dark:text-slate-200 dark:hover:bg-slate-700" href="/#faq" data-i18n="nav.faq">FAQ</a>
      <% if (!manufacturer) { %><a class="navlink dark:text-slate-200 dark:hover:bg-slate-700" href="/manufacturer/login" data-i18n="nav.manufacturer">Manufacturer</a><% } %>
    </div>
    <div class="ml-auto flex items-center gap-1.5">
      <!-- Language toggle -->
      <div class="flex items-center rounded-lg border border-slate-200 dark:border-slate-600 overflow-hidden text-xs font-bold select-none">
        <button onclick="setLang('en')" id="langEn" class="px-2.5 py-1.5 transition bg-brand text-white" title="English">EN</button>
        <button onclick="setLang('hi')" id="langHi" class="px-2.5 py-1.5 transition text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700" title="हिन्दी">हिं</button>
      </div>
      <!-- Dark mode toggle -->
      <button onclick="toggleTheme()" id="themeBtn" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 transition text-base" title="Toggle dark/light mode">
        <span id="themeIcon">🌙</span>
      </button>
      <% if (user) { %>
        <a class="navlink dark:text-slate-200 hidden sm:block" href="/dashboard" data-i18n="nav.dashboard">Dashboard</a>
        <% if (user.is_admin) { %><a class="navlink dark:text-slate-200 hidden sm:block" href="/admin" data-i18n="nav.admin">Admin</a><% } %>
        <form method="POST" action="/logout" class="inline">
          <%- include('_csrf') %><button class="btn-outline dark:border-slate-600 dark:text-slate-200 text-sm" data-i18n="nav.signout">Sign out</button>
        </form>
      <% } else if (manufacturer) { %>
        <a class="navlink dark:text-slate-200 hidden sm:block" href="/manufacturer/dashboard" data-i18n="nav.workshop">My Workshop</a>
        <form method="POST" action="/manufacturer/logout" class="inline">
          <%- include('_csrf') %><button class="btn-outline dark:border-slate-600 dark:text-slate-200 text-sm" data-i18n="nav.signout">Sign out</button>
        </form>
      <% } else { %>
        <a class="navlink dark:text-slate-200 hidden sm:block" href="/login" data-i18n="nav.login">Login</a>
        <a class="btn-warn text-sm" href="/store" data-i18n="nav.gettag">Get Your Tag</a>
      <% } %>
    </div>
  </div>
</nav>
