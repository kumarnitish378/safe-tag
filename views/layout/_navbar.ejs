<style>
  /* Navbar — light glass header (theme.css design system) */
  .nav-actions{display:flex;align-items:center;gap:.7rem}
  .st-link{font-weight:600;font-size:.94rem;color:#334155;transition:color .15s}
  .st-link:hover{color:var(--teal-d)}
  .lang-toggle{display:flex;align-items:center;border:1px solid var(--line);border-radius:10px;
    overflow:hidden;font-size:.72rem;font-weight:700;user-select:none;box-shadow:0 1px 3px rgba(10,35,66,.06)}
  .lang-toggle button{border:none;cursor:pointer;font-family:inherit}
  .hamburger{display:none;width:34px;height:34px;flex-direction:column;align-items:center;
    justify-content:center;gap:6px;background:none;border:none;cursor:pointer;padding:0}
  .hamburger span{display:block;height:2px;width:20px;border-radius:2px;background:var(--navy);transition:all .2s}
  /* Re-show desktop links between 768–820px (theme hides .nav-links ≤820) */
  @media(max-width:820px){.nav-links{display:flex}}
  /* True mobile ≤767px: hide desktop cluster, show hamburger (matches #mobile-menu breakpoint) */
  @media(max-width:767px){
    .nav-links{display:none}
    .desk-only{display:none !important}
    .hamburger{display:flex}
  }
</style>

<header>
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="SafeTag home">
      <img src="/static/images/websiteLogo.png" alt="SafeTag" style="height:34px;width:auto;object-fit:contain" onerror="this.style.display='none'" />
    </a>

    <!-- Desktop nav links -->
    <nav class="nav-links" aria-label="Primary">
      <a href="/store" data-i18n="nav.store">Store</a>
      <a href="/#how" data-i18n="nav.how">How it Works</a>
      <a href="/#faq" data-i18n="nav.faq">FAQ</a>
      <a href="https://www.sftg.in/blog/" target="_blank" rel="noopener">Blog</a>
      <% if (!manufacturer) { %><a href="/manufacturer/login" data-i18n="nav.manufacturer">Manufacturer</a><% } %>
    </nav>

    <div class="nav-actions">
      <!-- Language toggle -->
      <div class="lang-toggle desk-only">
        <button onclick="setLang('en')" id="langEn" class="px-2.5 py-1.5 transition bg-brand text-white" title="English">EN</button>
        <button onclick="setLang('hi')" id="langHi" class="px-2.5 py-1.5 transition text-slate-500 hover:bg-slate-100" title="हिन्दी">हिं</button>
      </div>

      <!-- Desktop auth buttons -->
      <% if (user) { %>
        <a class="st-link desk-only" href="/dashboard" data-i18n="nav.dashboard">Dashboard</a>
        <% if (user.is_admin) { %><a class="st-link desk-only" href="/admin" data-i18n="nav.admin">Admin</a><% } %>
        <form method="POST" action="/logout" class="desk-only" style="display:inline">
          <%- include('_csrf') %><button class="btn-ghost" style="padding:.5rem 1.1rem;font-size:.88rem" data-i18n="nav.signout">Sign out</button>
        </form>
      <% } else if (manufacturer) { %>
        <a class="st-link desk-only" href="/manufacturer/dashboard" data-i18n="nav.workshop">My Workshop</a>
        <form method="POST" action="/manufacturer/logout" class="desk-only" style="display:inline">
          <%- include('_csrf') %><button class="btn-ghost" style="padding:.5rem 1.1rem;font-size:.88rem" data-i18n="nav.signout">Sign out</button>
        </form>
      <% } else { %>
        <a class="st-link desk-only" href="/login" data-i18n="nav.login">Login</a>
        <a class="btn desk-only" href="/store" data-i18n="nav.gettag">Get Your Tag</a>
      <% } %>

      <!-- Hamburger (mobile only) -->
      <button id="hamburgerBtn" class="hamburger" aria-label="Menu" onclick="toggleMobileMenu()">
        <span id="hb1"></span>
        <span id="hb2"></span>
        <span id="hb3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" aria-hidden="true">
    <a href="/store" data-i18n="nav.store">Store</a>
    <a href="/#how" data-i18n="nav.how">How it Works</a>
    <a href="/#faq" data-i18n="nav.faq">FAQ</a>
    <a href="https://www.sftg.in/blog/" target="_blank" rel="noopener">Blog</a>
    <% if (!manufacturer) { %><a href="/manufacturer/login" data-i18n="nav.manufacturer">Manufacturer</a><% } %>
    <div style="height:1px;background:var(--line);margin:4px 0;"></div>
    <% if (user) { %>
      <a href="/dashboard" data-i18n="nav.dashboard">Dashboard</a>
      <% if (user.is_admin) { %><a href="/admin" data-i18n="nav.admin">Admin</a><% } %>
      <form method="POST" action="/logout"><%- include('_csrf') %><button type="submit" data-i18n="nav.signout">Sign out</button></form>
    <% } else if (manufacturer) { %>
      <a href="/manufacturer/dashboard" data-i18n="nav.workshop">My Workshop</a>
      <form method="POST" action="/manufacturer/logout"><%- include('_csrf') %><button type="submit" data-i18n="nav.signout">Sign out</button></form>
    <% } else { %>
      <a href="/login" data-i18n="nav.login">Login</a>
      <a href="/store" data-i18n="nav.gettag" style="color:var(--teal-d);font-weight:700;">Get Your Tag →</a>
    <% } %>
  </div>
</header>

<script>
function _setHamburger(open) {
  var h1 = document.getElementById('hb1');
  var h2 = document.getElementById('hb2');
  var h3 = document.getElementById('hb3');
  if (!h1) return;
  if (open) {
    h1.style.transform = 'translateY(8px) rotate(45deg)';
    h2.style.opacity = '0';
    h3.style.transform = 'translateY(-8px) rotate(-45deg)';
  } else {
    h1.style.transform = '';
    h2.style.opacity = '';
    h3.style.transform = '';
  }
}
function toggleMobileMenu() {
  var menu = document.getElementById('mobile-menu');
  var open = menu.classList.toggle('open');
  menu.setAttribute('aria-hidden', String(!open));
  _setHamburger(open);
}
// Auto-close menu when any link inside it is clicked
document.addEventListener('DOMContentLoaded', function () {
  var menu = document.getElementById('mobile-menu');
  if (!menu) return;
  menu.querySelectorAll('a').forEach(function (link) {
    link.addEventListener('click', function () {
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      _setHamburger(false);
    });
  });
});
</script>
