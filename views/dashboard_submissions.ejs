<%- include('layout/_head') %>

<style>
  .stp{max-width:720px;margin:0 auto;padding:2rem 20px 4rem}
  .stp-back{display:inline-flex;align-items:center;gap:.25rem;font-size:.86rem;color:var(--teal-d);font-weight:700}
  .stp-back:hover{text-decoration:underline}
  .stp-back .material-symbols-outlined{font-size:1.1em;color:inherit}
  .stp-hero{margin:.9rem 0 1.8rem}
  .stp-kicker{display:inline-flex;align-items:center;gap:.4rem;font-size:.8rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--teal-d)}
  .stp-kicker .material-symbols-outlined{font-size:1.15em;color:inherit}
  .stp-title{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;margin-top:.4rem}
  .stp-sub{color:var(--muted);margin-top:.4rem;font-size:.95rem}
  .stp-card{background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm)}
  .stp-empty{text-align:center;padding:3rem 1.5rem;color:var(--muted)}
  .stp-list{display:flex;flex-direction:column;gap:.9rem}
  .sub-card{padding:1.2rem 1.3rem}
  .sub-date{font-size:.76rem;color:#94a3b8;margin-bottom:.6rem}
  .sub-msg{font-size:.92rem;color:var(--ink);white-space:pre-line;line-height:1.6}
  .sub-reply{font-size:.8rem;color:var(--muted);margin-top:.6rem;display:inline-flex;align-items:center;gap:.3rem}
  .sub-reply .material-symbols-outlined{font-size:1.05em;color:var(--teal)}
  .sub-q{margin-bottom:.8rem}
  .sub-q:last-child{margin-bottom:0}
  .sub-q .qlabel{display:block;font-weight:700;color:var(--navy);font-size:.82rem;margin-bottom:.15rem}
  .sub-q .qval{font-size:.92rem;color:var(--ink)}
</style>

<section class="stp">
  <a href="/dashboard" class="stp-back"><span class="material-symbols-outlined">arrow_back</span>Dashboard</a>
  <div class="stp-hero">
    <div class="stp-kicker"><span class="material-symbols-outlined">inbox</span>Responses</div>
    <h1 class="stp-title"><%= cfg.title || 'Survey responses' %></h1>
    <p class="stp-sub"><%= submissions.length %> response<%= submissions.length === 1 ? '' : 's' %> · Tag <span class="mono"><%= tag_id %></span></p>
  </div>

  <% if (!submissions.length) { %>
    <div class="stp-card stp-empty">No responses yet. Share your tag to start collecting.</div>
  <% } else { %>
    <div class="stp-list">
      <% submissions.forEach(function(s){ var a = s.answers || {}; %>
        <div class="stp-card sub-card">
          <div class="sub-date"><%= new Date(s.created_at).toLocaleString('en-IN') %></div>
          <% if (a.kind === 'contact') { %>
            <div class="sub-msg"><%= a.message || '' %></div>
            <% if (a.reply) { %><div class="sub-reply"><span class="material-symbols-outlined">reply</span>Reply to: <%= a.reply %></div><% } %>
          <% } else { %>
            <% Object.keys(a).forEach(function(q){ %>
              <div class="sub-q">
                <span class="qlabel"><%= q %></span>
                <div class="qval"><%= a[q] %></div>
              </div>
            <% }); %>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include('layout/_foot') %>
