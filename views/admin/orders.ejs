<%- include('../layout/_head') %>

<section class="section">
  <div class="section-inner">
    <a href="/admin" class="text-sm text-brand font-semibold">← Admin dashboard</a>
    <div class="flex items-center justify-between mt-2 mb-6 flex-wrap gap-2 reveal">
      <h1 class="text-3xl font-bold">Orders</h1>
      <div class="flex gap-2 items-center">
        <form method="GET" action="/admin/orders">
      <%- include('../layout/_csrf') %>
          <select name="status" class="input py-2" onchange="this.form.submit()">
            <option value="">All</option>
            <% ['pending','dispatched','delivered','cancelled'].forEach(function(s){ %>
              <option value="<%= s %>" <%= statusFilter===s?'selected':'' %>><%= s %></option>
            <% }); %>
          </select>
        </form>
        <a class="btn-outline btn-lq text-sm" href="/admin/orders.csv">⬇ Export CSV</a>
      </div>
    </div>

    <div class="glass-light overflow-hidden reveal">
      <table class="table">
        <thead><tr><th>#</th><th>Customer</th><th>Product</th><th>Qty</th><th>Amount</th><th>Status</th><th>Tracking</th><th>Date</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr><td colspan="9" class="text-center py-6 text-slate-500">No orders.</td></tr>
          <% } else { orders.forEach(function(o){ %>
            <tr>
              <td class="mono">#<%= o.id %></td>
              <td><div><%= o.user ? o.user.email : '—' %></div><div class="text-xs text-slate-500"><%= o.user ? o.user.mobile : '' %></div></td>
              <td><%= o.product ? o.product.name : '—' %></td>
              <td><%= o.quantity %></td>
              <td>₹<%= o.amount_inr %></td>
              <td><span class="pill <%= o.status==='delivered'?'pill-success':(o.status==='dispatched'?'pill-brand':(o.status==='cancelled'?'pill-danger':'pill-warning')) %>"><%= o.status %></span></td>
              <td><%= o.tracking_id || '—' %></td>
              <td class="text-xs text-slate-500"><%= o.created_at ? o.created_at.split('T')[0] : '' %></td>
              <td>
                <% if (o.status === 'pending') { %>
                  <form method="POST" action="/admin/orders/<%= o.id %>/dispatch" class="flex gap-1">
      <%- include('../layout/_csrf') %>
                    <input class="input py-1 px-2 text-xs w-24 mono" name="tracking_id" placeholder="Tracking" />
                    <button class="btn-brand btn-lq text-xs py-1 px-2">Dispatch</button>
                  </form>
                <% } else if (o.status === 'dispatched') { %>
                  <form method="POST" action="/admin/orders/<%= o.id %>/status">
      <%- include('../layout/_csrf') %>
                    <input type="hidden" name="status" value="delivered" />
                    <button class="btn-outline btn-lq text-xs py-1 px-2">Mark delivered</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../layout/_foot') %>
