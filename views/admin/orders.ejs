<%- include('../layout/_head') %>

<style>
  .adm{padding:2.5rem 0}
  .adm-back{display:inline-flex;align-items:center;gap:.25rem;color:var(--teal-d);font-weight:600;font-size:.9rem;margin-bottom:.6rem}
  .adm-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.6rem}
  .adm-head h1{font-family:'Sora',sans-serif;font-size:clamp(1.7rem,3vw,2.2rem);font-weight:800;color:var(--navy)}
  .adm-actions{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}
  .btn-sm{padding:.5rem 1rem;font-size:.85rem;box-shadow:none}
  .btn-xs{padding:.4rem .7rem;font-size:.78rem;box-shadow:none;gap:.3rem}
  .panel{background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm);overflow:hidden}
  .tscroll{overflow-x:auto}
  table.atbl{width:100%;border-collapse:collapse;font-size:.9rem}
  table.atbl thead th{text-align:left;padding:.8rem 1rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700;color:var(--muted);background:var(--cream);border-bottom:1px solid var(--line);white-space:nowrap}
  table.atbl tbody td{padding:.8rem 1rem;border-bottom:1px solid var(--line);color:var(--ink);vertical-align:middle}
  table.atbl tbody tr:last-child td{border-bottom:none}
  table.atbl tbody tr:hover{background:#fafcff}
  .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);font-size:.85rem}
  .sub{font-size:.78rem;color:var(--muted)}
  .empty{text-align:center;color:var(--muted);padding:2rem 1rem}
  .pill{display:inline-flex;align-items:center;gap:.25rem;font-size:.72rem;font-weight:700;padding:.25rem .6rem;border-radius:999px;white-space:nowrap;text-transform:capitalize}
  .pill-green{background:#dcfce7;color:#15803d}
  .pill-teal{background:#e6fbf7;color:var(--teal-d)}
  .pill-amber{background:#fef3c7;color:#b45309}
  .pill-red{background:#fee2e2;color:#b91c1c}
  .fld{border:1px solid var(--line);border-radius:10px;padding:.5rem .7rem;font-size:.88rem;font-family:inherit;color:var(--ink);background:#fff;text-transform:capitalize}
  .fld-xs{border:1px solid var(--line);border-radius:8px;padding:.35rem .5rem;font-size:.8rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--ink);background:#fff;width:6rem}
  .dispatch-form{display:flex;gap:.4rem;align-items:center;margin:0}
  .dispatch-form form,td form{margin:0}
</style>

<section class="adm">
  <div class="wrap">
    <a href="/admin" class="adm-back"><span class="material-symbols-outlined" style="font-size:1.1em">arrow_back</span> Admin dashboard</a>
    <div class="adm-head reveal">
      <h1>Orders</h1>
      <div class="adm-actions">
        <form method="GET" action="/admin/orders">
      <%- include('../layout/_csrf') %>
          <select name="status" class="fld" onchange="this.form.submit()">
            <option value="">All</option>
            <% ['pending','dispatched','delivered','cancelled'].forEach(function(s){ %>
              <option value="<%= s %>" <%= statusFilter===s?'selected':'' %>><%= s %></option>
            <% }); %>
          </select>
        </form>
        <a class="btn-ghost btn-sm" href="/admin/orders.csv"><span class="material-symbols-outlined" style="font-size:1.1em">download</span> Export CSV</a>
      </div>
    </div>

    <div class="panel reveal">
      <div class="tscroll">
        <table class="atbl">
          <thead><tr><th>#</th><th>Customer</th><th>Product</th><th>Qty</th><th>Amount</th><th>Status</th><th>Tracking</th><th>Date</th><th>Actions</th></tr></thead>
          <tbody>
            <% if (!orders.length) { %>
              <tr><td colspan="9" class="empty">No orders.</td></tr>
            <% } else { orders.forEach(function(o){ %>
              <tr>
                <td class="mono">#<%= o.id %></td>
                <td><div><%= o.user ? o.user.email : '—' %></div><div class="sub"><%= o.user ? o.user.mobile : '' %></div></td>
                <td><%= o.product ? o.product.name : '—' %></td>
                <td><%= o.quantity %></td>
                <td>₹<%= o.amount_inr %></td>
                <td><span class="pill <%= o.status==='delivered'?'pill-green':(o.status==='dispatched'?'pill-teal':(o.status==='cancelled'?'pill-red':'pill-amber')) %>"><%= o.status %></span></td>
                <td class="mono"><%= o.tracking_id || '—' %></td>
                <td class="sub"><%= o.created_at ? o.created_at.split('T')[0] : '' %></td>
                <td>
                  <% if (o.status === 'pending') { %>
                    <form method="POST" action="/admin/orders/<%= o.id %>/dispatch" class="dispatch-form">
        <%- include('../layout/_csrf') %>
                      <input class="fld-xs" name="tracking_id" placeholder="Tracking" />
                      <button class="btn btn-xs">Dispatch</button>
                    </form>
                  <% } else if (o.status === 'dispatched') { %>
                    <form method="POST" action="/admin/orders/<%= o.id %>/status">
        <%- include('../layout/_csrf') %>
                      <input type="hidden" name="status" value="delivered" />
                      <button class="btn-ghost btn-xs">Mark delivered</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<%- include('../layout/_foot') %>
