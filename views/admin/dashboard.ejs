<%- include('../layout/_head') %>

<style>
  .adm{padding:2.5rem 0}
  .adm-back{display:inline-flex;align-items:center;gap:.25rem;color:var(--teal-d);font-weight:600;font-size:.9rem;margin-bottom:.6rem}
  .adm-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.6rem}
  .adm-head h1{font-family:'Sora',sans-serif;font-size:clamp(1.7rem,3vw,2.2rem);font-weight:800;color:var(--navy)}
  .adm-actions{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}
  .btn-sm{padding:.5rem 1rem;font-size:.85rem;box-shadow:none}
  .btn-xs{padding:.4rem .7rem;font-size:.78rem;box-shadow:none;gap:.3rem}
  .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:2rem}
  .metric{background:var(--white);border:1px solid var(--line);border-radius:var(--r);padding:1.3rem 1.4rem;box-shadow:var(--shadow-sm)}
  .metric .k{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:var(--muted)}
  .metric .v{font-family:'Sora',sans-serif;font-size:2rem;font-weight:800;color:var(--navy);line-height:1.1;margin-top:.25rem}
  .metric .v.teal{color:var(--teal-d)}
  .metric .v.amber{color:var(--amber)}
  .metric .sub{font-size:.78rem;color:var(--muted);margin-top:.25rem}
  .metric.span2{grid-column:span 2}
  @media(max-width:820px){.metrics{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:520px){.metrics{grid-template-columns:1fr}.metric.span2{grid-column:auto}}
  .panel{background:var(--white);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-sm);overflow:hidden}
  .panel-head{padding:1rem 1.3rem;border-bottom:1px solid var(--line);font-family:'Sora',sans-serif;font-weight:700;color:var(--navy)}
  .actlist{list-style:none;color:var(--ink);font-size:.92rem}
  .actlist li{display:flex;align-items:center;gap:.7rem;padding:.85rem 1.3rem;border-bottom:1px solid var(--line)}
  .actlist li:last-child{border-bottom:none}
  .actlist .ic{color:var(--teal);font-size:1.2rem}
  .actlist .ts{font-size:.78rem;color:var(--muted);margin-left:auto;white-space:nowrap}
  .actlist .empty{justify-content:center;color:var(--muted)}
</style>

<section class="adm">
  <div class="wrap">
    <div class="adm-head reveal">
      <h1>Admin · Platform overview</h1>
      <div class="adm-actions">
        <a class="btn-ghost btn-sm" href="/admin/manufacturers">Manufacturers</a>
        <a class="btn-ghost btn-sm" href="/admin/store">Store</a>
        <a class="btn-ghost btn-sm" href="/admin/orders">Orders</a>
        <a class="btn-ghost btn-sm" href="/admin/users">Users</a>
      </div>
    </div>

    <div class="metrics">
      <div class="metric reveal d1"><div class="k">Total tags</div><div class="v" data-count="<%= stats.total_tags||0 %>"><%= stats.total_tags||0 %></div><div class="sub">Activated: <%= stats.activated_tags||0 %></div></div>
      <div class="metric reveal d2"><div class="k">Activation rate</div><div class="v teal" data-count="<%= stats.activation_rate||0 %>" data-suffix="%"><%= stats.activation_rate||0 %>%</div></div>
      <div class="metric reveal d3"><div class="k">Customers</div><div class="v" data-count="<%= stats.total_users||0 %>"><%= stats.total_users||0 %></div><div class="sub">New this week: <%= stats.new_users_week||0 %></div></div>
      <div class="metric reveal d4"><div class="k">Manufacturers</div><div class="v" data-count="<%= stats.total_manufacturers||0 %>"><%= stats.total_manufacturers||0 %></div><div class="sub">Pending: <%= stats.pending_manufacturers||0 %></div></div>
      <div class="metric reveal d1"><div class="k">Orders</div><div class="v" data-count="<%= stats.total_orders||0 %>"><%= stats.total_orders||0 %></div><div class="sub">Pending dispatch: <%= stats.pending_orders||0 %></div></div>
      <div class="metric span2 reveal d2"><div class="k">Revenue this week</div><div class="v amber">₹<%= stats.revenue_week_inr||0 %></div></div>
    </div>

    <div class="panel reveal">
      <div class="panel-head">Recent activity</div>
      <ul class="actlist">
        <% if (!recent.length) { %>
          <li class="empty">No activity yet.</li>
        <% } else { %>
          <% recent.forEach(function(r){ %>
            <li>
              <span class="ic material-symbols-outlined"><% if (r.type==='user') { %>person<% } else if (r.type==='order') { %>package_2<% } else if (r.type==='manufacturer') { %>factory<% } else { %>circle<% } %></span>
              <span><%= r.label %></span>
              <span class="ts"><%= r.ts.split('T')[0] %></span>
            </li>
          <% }); %>
        <% } %>
      </ul>
    </div>
  </div>
</section>

<%- include('../layout/_foot') %>
